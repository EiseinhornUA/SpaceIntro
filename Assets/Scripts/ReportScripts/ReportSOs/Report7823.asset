  m_Script: {fileID: 11500000, guid: 62c84bf2b37c1de4fb5d50df1f5f0756, type: 3}
  m_Name: Report7823
  m_EditorClassIdentifier: 
  reportName: Report number 7823
  reportDescription: "Date: 07/18/2239\r\nEngineer: M. McGermick \r\nToday conducted\r\nan
    inventory of essential supplies prior to launching the backup power scenario.
    Checked three types of resources:\r\nOxygen cylinders - 10 pcs.\r\nFuel cells
    - 2 times as many cylinders\r\nRepair kits - equal to the sum of cylinders and
    cells\r\nEverything is within normal limits, no leaks or failures recorded.\r\nBy
    the way, the second part of the access code to the lock of the cryostorage compartment
    coincides with the total amount of resources (60).\r\nThe first part, as usual,
    is stored in the encrypted memory of the command module.\r\nEnd of record"
