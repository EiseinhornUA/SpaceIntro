      Line":{"$content":"Emergency light. So something happened at the station. I
      have to get to the captain''s bridge.","$type":"System.String"},"Character":{"$content":0,"$type":"UnityEngine.Object"}},"position":{"x":469.0,"y":-110.0},"guid":"5bd8d48f-1015-4dd3-9248-ccc311d54924","$version":"A","$type":"DialogueNode","$id":"13"},{"defaultValues":{"Dialogue
      Line":{"$content":"Attention! Oxygen level is low! It is recommended to take
      an oxygen mask or spacesuit.","$type":"System.String"},"Character":{"$content":1,"$type":"UnityEngine.Object"}},"position":{"x":906.0,"y":-112.0},"guid":"fe8b1831-2b0c-4a19-8b2b-be0cac8dfa76","$version":"A","$type":"DialogueNode","$id":"15"},{"defaultValues":{"Dialogue
      Line":{"$content":"Where can I get a mask?","$type":"System.String"},"Character":{"$content":2,"$type":"UnityEngine.Object"}},"position":{"x":1296.0,"y":-104.0},"guid":"3eb30a34-bf14-42a8-9dcb-ca168eb29d22","$version":"A","$type":"DialogueNode","$id":"17"},{"defaultValues":{"Dialogue
      Line":{"$content":"The oxygen mask is in the storage compartment on the -6th
      floor. You can get there by the engineering elevator through the lab.","$type":"System.String"},"Character":{"$content":3,"$type":"UnityEngine.Object"}},"position":{"x":1616.0,"y":-103.0},"guid":"1ebe9473-4710-429f-87eb-be88a6907e90","$version":"A","$type":"DialogueNode","$id":"19"},{"defaultValues":{"Dialogue
      Line":{"$content":"I saw a spacesuit a minute ago. Is it in working order?","$type":"System.String"},"Character":{"$content":4,"$type":"UnityEngine.Object"}},"position":{"x":2811.0,"y":-97.0},"guid":"c13c4622-ed0d-4dbd-9cb6-af2bc7cb0e4d","$version":"A","$type":"DialogueNode","$id":"21"},{"defaultValues":{"Dialogue
      Line":{"$content":"The spacesuits are in the pressurization and pressure stabilization
      compartment. Floor 0 can be reached from the transportation compartment","$type":"System.String"},"Character":{"$content":5,"$type":"UnityEngine.Object"}},"position":{"x":2402.0,"y":-102.0},"guid":"53629722-1789-4738-a870-d79a5ac9b52a","$version":"A","$type":"DialogueNode","$id":"23"},{"defaultValues":{"Dialogue
      Line":{"$content":"Additional diagnostics will be required!","$type":"System.String"},"Character":{"$content":6,"$type":"UnityEngine.Object"}},"position":{"x":3203.0,"y":-98.0},"guid":"ea45ef47-0370-4e65-9696-24a95f07c349","$version":"A","$type":"DialogueNode","$id":"25"},{"defaultValues":{"Dialogue
