  _data:
    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":null,"summary":null,"pan":{"x":4182.792,"y":37.39613},"zoom":1.0,"elements":[{"coroutine":true,"defaultValues":{},"position":{"x":224.0,"y":-97.0},"guid":"19b2f7b3-e284-4b1b-8f95-7d210b029d8a","$version":"A","$type":"Unity.VisualScripting.Start","$id":"9"},{"defaultValues":{"Dialogue
      Line":{"$content":"Emergency lights... Something bad definitely happened here.
      I have to get to the captain''s bridge.","$type":"System.String"},"Character":{"$content":0,"$type":"UnityEngine.Object"}},"position":{"x":479.0,"y":-107.0},"guid":"5bd8d48f-1015-4dd3-9248-ccc311d54924","$version":"A","$type":"DialogueNode","$id":"11"},{"defaultValues":{"Dialogue
      Line":{"$content":"Additional diagnostics will be required!","$type":"System.String"},"Character":{"$content":1,"$type":"UnityEngine.Object"}},"position":{"x":3095.0,"y":-87.0},"guid":"ea45ef47-0370-4e65-9696-24a95f07c349","$version":"A","$type":"DialogueNode","$id":"13"},{"defaultValues":{"Dialogue
      Line":{"$content":"The spacesuits are in the pressurization and pressure stabilization
      compartment. You can get there from the transportation compartment.","$type":"System.String"},"Character":{"$content":2,"$type":"UnityEngine.Object"}},"position":{"x":1479.0,"y":-27.0},"guid":"53629722-1789-4738-a870-d79a5ac9b52a","$version":"A","$type":"DialogueNode","$id":"15"},{"defaultValues":{"Dialogue
      Line":{"$content":"I saw a spacesuit back there. Is it safe to use?","$type":"System.String"},"Character":{"$content":3,"$type":"UnityEngine.Object"}},"position":{"x":2703.0,"y":-99.0},"guid":"c13c4622-ed0d-4dbd-9cb6-af2bc7cb0e4d","$version":"A","$type":"DialogueNode","$id":"17"},{"defaultValues":{"Dialogue
      Line":{"$content":"The oxygen mask is in the storage compartment on the 0th
      floor. To get there go through the lab and you will find the elevator. ","$type":"System.String"},"Character":{"$content":4,"$type":"UnityEngine.Object"}},"position":{"x":1483.0,"y":-172.0},"guid":"1ebe9473-4710-429f-87eb-be88a6907e90","$version":"A","$type":"DialogueNode","$id":"19"},{"choiceCount":2,"defaultValues":{"Dialogue
      Line":{"$content":"Good joke.","$type":"System.String"},"Character":{"$content":5,"$type":"UnityEngine.Object"},"Text1":{"$content":"Where
      can I get a mask?","$type":"System.String"},"Text2":{"$content":"Where can
      I get a spacesuit?","$type":"System.String"}},"position":{"x":1032.0,"y":143.0},"guid":"35ee0585-ceb8-42f2-b9f0-c0acbc2f134c","$version":"A","$type":"DialogueChoiceNode","$id":"21"},{"exitCount":1,"defaultValues":{"Variant
      Name 1":null},"position":{"x":4352.0,"y":-88.0},"guid":"62612e39-d061-426e-ae55-2d85a1bcdaef","$version":"A","$type":"EndDialogueNode","$id":"23"},{"choiceCount":3,"defaultValues":{"Dialogue
      Line":{"$content":"Warning. Ambient oxygen levels are critically low. It is
      recommended you equip an oxygen mask or spacesuit immediately.","$type":"System.String"},"Character":{"$content":6,"$type":"UnityEngine.Object"},"Text1":{"$content":"Where
      can I get a mask?","$type":"System.String"},"Text2":{"$content":"Where can
      I get a spacesuit?","$type":"System.String"},"Text3":{"$content":"I''ll be
      fine.","$type":"System.String"}},"position":{"x":959.0,"y":-116.0},"guid":"dda82667-f922-45d2-9a63-6e71cf3b3c27","$version":"A","$type":"DialogueChoiceNode","$id":"25"},{"defaultValues":{"Dialogue
      Line":{"$content":"Where can I get a spacesuit?","$type":"System.String"},"Character":{"$content":7,"$type":"UnityEngine.Object"}},"position":{"x":1864.0,"y":-173.0},"guid":"4dfdf3f7-8d05-4667-a390-aec1ba6b8ac1","$version":"A","$type":"DialogueNode","$id":"27"},{"defaultValues":{"Dialogue
      Line":{"$content":"Where can I get a mask?","$type":"System.String"},"Character":{"$content":8,"$type":"UnityEngine.Object"}},"position":{"x":1869.0,"y":-23.0},"guid":"77e2ee3a-3019-4146-afbc-99274fce45fd","$version":"A","$type":"DialogueNode","$id":"29"},{"defaultValues":{"Dialogue
      Line":{"$content":"The spacesuits are in the pressurization and pressure stabilization
      compartment. You can get there from the transportation compartment.","$type":"System.String"},"Character":{"$content":9,"$type":"UnityEngine.Object"}},"position":{"x":2241.0,"y":-171.0},"guid":"6330d1e6-0782-448f-8b51-4f861406647d","$version":"A","$type":"DialogueNode","$id":"31"},{"defaultValues":{"Dialogue
      Line":{"$content":"The oxygen mask is in the storage compartment on the 0th
      floor. To get there go through the lab and you will find the elevator. ","$type":"System.String"},"Character":{"$content":10,"$type":"UnityEngine.Object"}},"position":{"x":2246.0,"y":-29.0},"guid":"7ceb7eb2-41b4-4ca2-955a-318fc6425437","$version":"A","$type":"DialogueNode","$id":"33"},{"defaultValues":{"Dialogue
      Line":{"$content":"The suit, designation AR-1752, has a minor leak. Oxygen
      loss is 2% per hour.","$type":"System.String"},"Character":{"$content":11,"$type":"UnityEngine.Object"}},"position":{"x":3501.0,"y":-96.0},"guid":"0c120b35-2452-45fb-9c67-04ba04c3b3f0","$version":"A","$type":"DialogueNode","$id":"35"},{"defaultValues":{"Dialogue
      Line":{"$content":"Conclusion: The suit is functional for short-term use.","$type":"System.String"},"Character":{"$content":12,"$type":"UnityEngine.Object"}},"position":{"x":3906.0,"y":-97.0},"guid":"ee586db9-a58a-4ab3-9788-a1d43ec65a01","$version":"A","$type":"DialogueNode","$id":"37"},{"sourceUnit":{"$ref":"11"},"sourceKey":"exit","destinationUnit":{"$ref":"25"},"destinationKey":"enter","guid":"316a23d6-b400-400e-905c-3489acd6bcb3","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"33"},"sourceKey":"exit","destinationUnit":{"$ref":"17"},"destinationKey":"enter","guid":"8466332e-15e2-4a13-903d-32425b19a4c2","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"trigger","destinationUnit":{"$ref":"11"},"destinationKey":"enter","guid":"51552d7a-6dfd-4034-bd45-9ffd389e47f2","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"15"},"sourceKey":"exit","destinationUnit":{"$ref":"29"},"destinationKey":"enter","guid":"dbd5736e-6b88-40c8-a268-936f553853f7","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"19"},"sourceKey":"exit","destinationUnit":{"$ref":"27"},"destinationKey":"enter","guid":"da213d8e-7292-435c-936b-245df1372005","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"29"},"sourceKey":"exit","destinationUnit":{"$ref":"33"},"destinationKey":"enter","guid":"b0d47835-06dc-41b4-a14a-650bb90b4787","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"17"},"sourceKey":"exit","destinationUnit":{"$ref":"13"},"destinationKey":"enter","guid":"211a6c53-678c-43b0-997d-cec3dc47045b","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"27"},"sourceKey":"exit","destinationUnit":{"$ref":"31"},"destinationKey":"enter","guid":"bc28da05-766f-4625-b08c-ae76be71f314","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"25"},"sourceKey":"Choice
