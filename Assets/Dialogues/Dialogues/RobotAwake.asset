      Line":{"$content":"I don''t have any items","$type":"System.String"},"Character":{"$content":7,"$type":"UnityEngine.Object"}},"position":{"x":2839.0,"y":-103.0},"guid":"851a2a26-523f-4cc5-a0ac-9c81499ede81","$version":"A","$type":"DialogueNode","$id":"27"},{"defaultValues":{"Dialogue
      Line":{"$content":"Is there anyone else on board?","$type":"System.String"},"Character":{"$content":8,"$type":"UnityEngine.Object"}},"position":{"x":3201.0,"y":-104.0},"guid":"a8600173-9f71-48d6-be5b-54ae2396fd12","$version":"A","$type":"DialogueNode","$id":"29"},{"defaultValues":{"Dialogue
      Line":{"$content":"Atheia carries 20,000 colonists and 457 crew, all in cryosleep.","$type":"System.String"},"Character":{"$content":9,"$type":"UnityEngine.Object"}},"position":{"x":3596.0,"y":-105.0},"guid":"6abd6d20-ad8b-4e8d-a47c-0f3cbac257d8","$version":"A","$type":"DialogueNode","$id":"31"},{"defaultValues":{"Dialogue
      Line":{"$content":"Where are we?","$type":"System.String"},"Character":{"$content":10,"$type":"UnityEngine.Object"}},"position":{"x":4000.0,"y":-108.0},"guid":"c5788ce4-80cb-486e-9a3c-cd173c60d0fe","$version":"A","$type":"DialogueNode","$id":"33"},{"defaultValues":{"Dialogue
      Line":{"$content":"Error: Navigation system not responding.","$type":"System.String"},"Character":{"$content":11,"$type":"UnityEngine.Object"}},"position":{"x":5052.0,"y":-102.0},"guid":"050d35d1-3938-4ce8-97a1-957ce67e1c82","$version":"A","$type":"DialogueNode","$id":"35"},{"defaultValues":{"Dialogue
      Line":{"$content":"We are aboard the intergalactic vessel Atheia, en route
      to Eden-7. Estimated journey: 96 Earth years. Time remaining: Unknown","$type":"System.String"},"Character":{"$content":12,"$type":"UnityEngine.Object"}},"position":{"x":4289.0,"y":-101.0},"guid":"c55fc9d3-31cd-423d-98bf-a26ddb8ec81b","$version":"A","$type":"DialogueNode","$id":"37"},{"defaultValues":{"Dialogue
      Line":{"$content":"Why is time unknown?","$type":"System.String"},"Character":{"$content":13,"$type":"UnityEngine.Object"}},"position":{"x":4715.0,"y":-106.0},"guid":"75dfcfa0-08fd-44b3-bdce-78edd21c3672","$version":"A","$type":"DialogueNode","$id":"39"},{"defaultValues":{"Dialogue
      Line":{"$content":"What year is it?","$type":"System.String"},"Character":{"$content":14,"$type":"UnityEngine.Object"}},"position":{"x":5519.0,"y":-87.0},"guid":"351b9c70-3140-4ad7-93a5-77136d43f949","$version":"A","$type":"DialogueNode","$id":"41"},{"defaultValues":{"Dialogue
      Line":{"$content":"What happened to navigation?","$type":"System.String"},"Character":{"$content":15,"$type":"UnityEngine.Object"}},"position":{"x":6260.0,"y":-80.0},"guid":"bd7e5f28-ed54-48a9-92f2-ae66632f8c5e","$version":"A","$type":"DialogueNode","$id":"43"},{"defaultValues":{"Dialogue
