    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":null,"summary":null,"pan":{"x":6995.11,"y":-64.142},"zoom":1.0,"elements":[{"coroutine":true,"defaultValues":{},"position":{"x":-359.0,"y":-86.0},"guid":"19b2f7b3-e284-4b1b-8f95-7d210b029d8a","$version":"A","$type":"Unity.VisualScripting.Start","$id":"9"},{"defaultValues":{"Dialogue
      Line":{"$content":"You can summon my hologram anytime via your PDA or meet
      me at key points to assist with heavy objects.","$type":"System.String"},"Character":{"$content":0,"$type":"UnityEngine.Object"}},"position":{"x":1949.0,"y":-115.0},"guid":"3c552390-ae1f-47bf-80a8-bbd6a1f0bdc8","$version":"A","$type":"DialogueNode","$id":"11"},{"defaultValues":{"Dialogue
      Line":{"$content":"[Name] online. I\u2019m an AI assistant with a vast knowledge
      base.","$type":"System.String"},"Character":{"$content":1,"$type":"UnityEngine.Object"}},"position":{"x":1542.0,"y":-115.0},"guid":"b6e548ec-4d32-4b82-8162-a2f640941610","$version":"A","$type":"DialogueNode","$id":"13"},{"defaultValues":{"Dialogue
      Line":{"$content":"Great! You''re working. Are you\u2026 a he? A she? What\u2019s
