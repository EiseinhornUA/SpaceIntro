      Line":{"$content":"Would you like to store items or ask a question?","$type":"System.String"},"Character":{"$content":3,"$type":"UnityEngine.Object"}},"position":{"x":2388.0,"y":-115.0},"guid":"2ada448a-6e60-41ae-aad8-87da38859d1e","$version":"A","$type":"DialogueNode","$id":"17"},{"defaultValues":{"Dialogue
      Line":{"$content":"Accessing memory logs.","$type":"System.String"},"Character":{"$content":4,"$type":"UnityEngine.Object"}},"position":{"x":292.0,"y":-111.0},"guid":"119cd19a-c2cc-4fe9-8abb-3f6a31bacbb4","$version":"A","$type":"DialogueNode","$id":"19"},{"defaultValues":{"Dialogue
      Line":{"$content":"Self-diagnostic complete. Service mode engaged.","$type":"System.String"},"Character":{"$content":5,"$type":"UnityEngine.Object"}},"position":{"x":-122.0,"y":-104.0},"guid":"5bd8d48f-1015-4dd3-9248-ccc311d54924","$version":"A","$type":"DialogueNode","$id":"21"},{"exitCount":1,"defaultValues":{"Variant
