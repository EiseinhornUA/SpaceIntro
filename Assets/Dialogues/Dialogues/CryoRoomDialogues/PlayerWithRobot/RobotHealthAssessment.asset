      Line":{"$content":"High stress level detected! It\u2019s dangerous since you
      may pose a threat to the spaceship and all systems!","$type":"System.String"},"Character":{"$content":0,"$type":"UnityEngine.Object"},"Text1":{"$content":"I''m
      just alert, not stressed. You misread me, no need to worry. ","$type":"System.String"},"Text2":{"$content":"No
      way! Your scanner must be broken. I''m totally fine!  ","$type":"System.String"},"Text3":{"$content":"It\u2019s
      cold and systems glitch, I\u2019m not a threat, no worries.   ","$type":"System.String"},"Text4":{"$content":"Maybe
      I just need time to adjust and calm down a bit.","$type":"System.String"}},"position":{"x":1177.0,"y":-85.0},"guid":"0b1e6611-4580-45f4-b43f-fe4db4badd09","$version":"A","$type":"DialogueChoiceNode","$id":"14"},{"defaultValues":{},"position":{"x":962.0,"y":-83.0},"guid":"fca1fb43-cdac-415b-8f62-18e3bb2588d5","$version":"A","$type":"StartAssessmentNode","$id":"16"},{"defaultValues":{"Dialogue
      Line":{"$content":"All systems are up to date. I''m ready to work. Before we
