      Line":{"$content":"It can be found somewhere on the level.","$type":"System.String"},"Character":{"$content":14,"$type":"UnityEngine.Object"}},"position":{"x":136.0,"y":-124.0},"guid":"1fd2cc03-96df-469c-83ae-c64f833b61de","$version":"A","$type":"DialogueNode","$id":"37"},{"sourceUnit":{"$ref":"31"},"sourceKey":"exit","destinationUnit":{"$ref":"23"},"destinationKey":"","guid":"36d43b3e-2cbe-4794-9e01-34cca45af962","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"35"},"sourceKey":"","destinationUnit":{"$ref":"11"},"destinationKey":"Dialogue
