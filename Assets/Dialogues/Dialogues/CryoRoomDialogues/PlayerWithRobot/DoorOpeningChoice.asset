      Line":{"$content":"There are several ways to solve this problem","$type":"System.String"},"Character":{"$content":0,"$type":"UnityEngine.Object"}},"position":{"x":-750.0,"y":-101.0},"guid":"e90000ee-0e03-46fc-b517-c1d33c77f743","$version":"A","$type":"DialogueNode","$id":"13"},{"defaultValues":{"Dialogue
      Line":{"$content":"The third way is through manual access to the lock, but
      for this you will need tools","$type":"System.String"},"Character":{"$content":1,"$type":"UnityEngine.Object"}},"position":{"x":1026.0,"y":-121.0},"guid":"c79b0cc6-5269-47fc-ad88-15645ed1539c","$version":"A","$type":"DialogueNode","$id":"15"},{"skillCount":2,"defaultValues":{"Amount
