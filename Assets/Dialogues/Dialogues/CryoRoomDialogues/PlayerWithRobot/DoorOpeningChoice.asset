      Line":{"$content":"I will find a diagram","$type":"System.String"},"Character":{"$content":4,"$type":"UnityEngine.Object"}},"position":{"x":2003.0,"y":-279.0},"guid":"4be6e1e7-851c-4a59-b487-8da1d7201e50","$version":"A","$type":"DialogueNode","$id":"19"},{"choiceCount":3,"defaultValues":{"Dialogue
      Line":{"$content":"What are you going to choose?","$type":"System.String"},"Character":{"$content":5,"$type":"UnityEngine.Object"},"Text1":{"$content":"Find
      a diagram","$type":"System.String"},"Text2":{"$content":"Find access code","$type":"System.String"},"Text3":{"$content":"Find
      tools","$type":"System.String"}},"position":{"x":1468.0,"y":-176.0},"guid":"109ab7b7-7900-4761-9926-36b92e28d5c9","$version":"A","$type":"DialogueChoiceNode","$id":"21"},{"skillCount":2,"defaultValues":{"Amount
      1":{"$content":2.0,"$type":"System.Single"},"Skill 1":{"$content":6,"$type":"UnityEngine.Object"},"Amount
      2":{"$content":1.0,"$type":"System.Single"},"Skill 2":{"$content":7,"$type":"UnityEngine.Object"}},"position":{"x":2422.0,"y":-168.0},"guid":"f647fb29-1c7c-45d8-b0d7-138451303b2d","$version":"A","$type":"AddSkillPointsNode","$id":"23"},{"defaultValues":{"Dialogue
      Line":{"$content":"The first and easiest. I can try to break the door, but
      for this I will need a diagram of the electronic lock.","$type":"System.String"},"Character":{"$content":8,"$type":"UnityEngine.Object"}},"position":{"x":-330.0,"y":-116.0},"guid":"69b13b0a-2ad7-4bcd-9abe-6d9a5bce04ee","$version":"A","$type":"DialogueNode","$id":"25"},{"defaultValues":{"Dialogue
      Line":{"$content":"I found the right door, it is locked by the system. Can
      you open it?","$type":"System.String"},"Character":{"$content":9,"$type":"UnityEngine.Object"}},"position":{"x":-1143.0,"y":-98.0},"guid":"5bd8d48f-1015-4dd3-9248-ccc311d54924","$version":"A","$type":"DialogueNode","$id":"27"},{"defaultValues":{"Dialogue
      Line":{"$content":"The second way is to find the access code in the system
      reports","$type":"System.String"},"Character":{"$content":10,"$type":"UnityEngine.Object"}},"position":{"x":585.0,"y":-116.0},"guid":"28eae79e-bb46-4812-b30c-5a52a082fd63","$version":"A","$type":"DialogueNode","$id":"29"},{"defaultValues":{"Dialogue
      Line":{"$content":"I will find the access code","$type":"System.String"},"Character":{"$content":11,"$type":"UnityEngine.Object"}},"position":{"x":2003.0,"y":-150.0},"guid":"df90b7f9-b380-4f32-92ca-0571e4f5dcda","$version":"A","$type":"DialogueNode","$id":"31"},{"defaultValues":{"Dialogue
      Line":{"$content":"I will find the tools","$type":"System.String"},"Character":{"$content":12,"$type":"UnityEngine.Object"}},"position":{"x":2004.0,"y":-15.0},"guid":"2a8958f5-1d69-4ec7-800d-3d47f90d2706","$version":"A","$type":"DialogueNode","$id":"33"},{"skillCount":1,"defaultValues":{"Amount
