    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":null,"summary":null,"pan":{"x":3860.296,"y":-86.04715},"zoom":0.2999999,"elements":[{"coroutine":true,"defaultValues":{},"position":{"x":215.0,"y":-58.0},"guid":"19b2f7b3-e284-4b1b-8f95-7d210b029d8a","$version":"A","$type":"Unity.VisualScripting.Start","$id":"9"},{"defaultValues":{"Dialogue
      Line":{"$content":"You need to go through the technical corridor to the distribution
      hall, the door leading to the B-1 corridor","$type":"System.String"},"Character":{"$content":0,"$type":"UnityEngine.Object"}},"position":{"x":2319.0,"y":53.0},"guid":"d26d20bd-aefa-4eaa-916c-44d71c02b0de","$version":"A","$type":"DialogueNode","$id":"11"},{"defaultValues":{"Dialogue
      Line":{"$content":"The entry in the log has been added!","$type":"System.String"},"Character":{"$content":1,"$type":"UnityEngine.Object"}},"position":{"x":3528.0,"y":49.0},"guid":"4e3d97d1-9593-4662-8e4f-34c753d3140e","$version":"A","$type":"DialogueNode","$id":"13"},{"defaultValues":{"Dialogue
      Line":{"$content":"This is the shortest way!","$type":"System.String"},"Character":{"$content":2,"$type":"UnityEngine.Object"}},"position":{"x":3160.0,"y":56.0},"guid":"1a39c45d-61f0-45ba-a520-c2895b299ed7","$version":"A","$type":"DialogueNode","$id":"15"},{"defaultValues":{"Dialogue
      Line":{"$content":"How do I get to the captain''s bridge?","$type":"System.String"},"Character":{"$content":3,"$type":"UnityEngine.Object"}},"position":{"x":1900.0,"y":53.0},"guid":"5bd81565-c474-4bb9-8b6a-f9c6b592ad6e","$version":"A","$type":"DialogueNode","$id":"17"},{"choiceCount":3,"defaultValues":{"Dialogue
      Line":{"$content":"The total travel time is 96 Earth years, the remaining travel
      time is unknown.","$type":"System.String"},"Character":{"$content":4,"$type":"UnityEngine.Object"},"Text1":{"$content":"Why
      is the remaining travel time unknown? Recalculate the time until eden-7.","$type":"System.String"},"Text2":{"$content":"Current
      location","$type":"System.String"},"Text3":{"$content":"What year is it?","$type":"System.String"}},"position":{"x":437.0,"y":-143.0},"guid":"10346298-fe02-4b73-bb56-59998794968d","$version":"A","$type":"DialogueChoiceNode","$id":"19"},{"defaultValues":{"Dialogue
      Line":{"$content":"Then through the Alpha laboratory to the captain''s bridge.","$type":"System.String"},"Character":{"$content":5,"$type":"UnityEngine.Object"}},"position":{"x":2743.0,"y":48.0},"guid":"19aefe17-4061-4637-8ffa-8db4b5bdcf3a","$version":"A","$type":"DialogueNode","$id":"21"},{"choiceCount":2,"defaultValues":{"Dialogue
      Line":{"$content":"Error! The navigation system is not responding.","$type":"System.String"},"Character":{"$content":6,"$type":"UnityEngine.Object"},"Text1":{"$content":"What''s
      wrong with the navigation system?","$type":"System.String"},"Text2":{"$content":"Can
      I fix the navigation system?","$type":"System.String"}},"position":{"x":942.0,"y":-131.0},"guid":"0105afd4-d519-4b08-9cc7-c0da3bd3a2ea","$version":"A","$type":"DialogueChoiceNode","$id":"23"},{"defaultValues":{"Dialogue
      Line":{"$content":"Last entry. 632 days ago. Navigation system failure. Navigation
      system unavailable.","$type":"System.String"},"Character":{"$content":7,"$type":"UnityEngine.Object"}},"position":{"x":1506.0,"y":-178.0},"guid":"5bd8d48f-1015-4dd3-9248-ccc311d54924","$version":"A","$type":"DialogueNode","$id":"25"},{"exitCount":1,"defaultValues":{"Variant
