      Line":{"$content":"Analyzing\u2026 presumably yes. The roots are damaging one
      of the walls and adjacent compartments. ","$type":"System.String"},"Character":{"$content":6,"$type":"UnityEngine.Object"}},"position":{"x":2425.0,"y":-97.0},"guid":"943e6bff-c54e-4414-be91-56fe4e584ec3","$version":"A","$type":"DialogueNode","$id":"25"},{"defaultValues":{"Dialogue
      Line":{"$content":"Let''s try to remove these roots, do you know how?","$type":"System.String"},"Character":{"$content":7,"$type":"UnityEngine.Object"}},"position":{"x":2840.0,"y":-107.0},"guid":"b988970a-45b1-46f3-a495-63ddbc73a05a","$version":"A","$type":"DialogueNode","$id":"27"},{"defaultValues":{"Dialogue
      Line":{"$content":"Warning! An even stronger breach of hermetic seal may lead
      to complete depressurization! Recommendation: do not breach the ship''s hermetic
      seal.","$type":"System.String"},"Character":{"$content":8,"$type":"UnityEngine.Object"}},"position":{"x":3237.0,"y":-113.0},"guid":"410c76c6-43e8-40d6-81db-95bd273aedf4","$version":"A","$type":"DialogueNode","$id":"29"},{"defaultValues":{"Dialogue
      Line":{"$content":"You said oxygen deficiency here. What is the oxygen level
