      Line":{"$content":"Root system of a biological species. History of origin unknown.","$type":"System.String"},"Character":{"$content":2,"$type":"UnityEngine.Object"}},"position":{"x":1016.0,"y":-94.0},"guid":"3a33ab29-43cb-411e-856d-d0a0eb856201","$version":"A","$type":"DialogueNode","$id":"17"},{"defaultValues":{"Dialogue
      Line":{"$content":"How long has this been here?","$type":"System.String"},"Character":{"$content":3,"$type":"UnityEngine.Object"}},"position":{"x":1418.0,"y":-91.0},"guid":"97d44815-b0e4-4c43-bd38-f0e937233a64","$version":"A","$type":"DialogueNode","$id":"19"},{"defaultValues":{"Dialogue
      Line":{"$content":"The composition of the air environment:","$type":"System.String"},"Character":{"$content":4,"$type":"UnityEngine.Object"}},"position":{"x":4313.0,"y":-117.0},"guid":"e8844f38-c6a9-4bf3-bedf-4761bbacab9f","$version":"A","$type":"DialogueNode","$id":"21"},{"defaultValues":{"Dialogue
