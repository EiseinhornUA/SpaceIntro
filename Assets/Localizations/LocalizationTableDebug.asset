  m_Name: LocalizationTableDebug
  m_EditorClassIdentifier: 
  entries:
  - key: "Report 08 \u2014 Crew Activity Log"
    translations:
    - language: 10
      value: "Report 08 \u2014 Crew Activity Log"
    - language: 38
      value: "\u0417\u0432\u0456\u0442 08 \u2014 \u0416\u0443\u0440\u043D\u0430\u043B
        \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0456 \u0435\u043A\u0456\u043F\u0430\u0436\u0443"
    - language: 28
      value: "Relat\xF3rio 08 \u2014 Registo de Actividade da Tripula\xE7\xE3o"
    - language: 34
      value: "Informe 08 \u2014 Registro de Actividad de la Tripulaci\xF3n"
  - key: "Cross-referencing cryostasis monitoring with station logs shows discrepancies:\n457
      official crew entries.\nCryostasis scan detects 454 active pods.\n Three pods
      are missing from the registry.\n No matching entries were found in medical
      archives or system deletion logs.\n Status of the missing crew members: unknown.\n
      Advisory: Proceed with caution. Further anomalies may indicate human interference,
      not system error."
    translations:
    - language: 10
      value: "Cross-referencing cryostasis monitoring with station logs shows discrepancies:\n457
        official crew entries.\nCryostasis scan detects 454 active pods.\n Three
        pods are missing from the registry.\n No matching entries were found in medical
        archives or system deletion logs.\n Status of the missing crew members: unknown.\n
        Advisory: Proceed with caution. Further anomalies may indicate human interference,
        not system error."
    - language: 38
      value: "\u041F\u0435\u0440\u0435\u0445\u0440\u0435\u0441\u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0430
        \u043C\u043E\u043D\u0456\u0442\u043E\u0440\u0438\u043D\u0433\u0443 \u043A\u0440\u0456\u043E\u0441\u0442\u0430\u0437\u0443
        \u0437 \u0436\u0443\u0440\u043D\u0430\u043B\u0430\u043C\u0438 \u0441\u0442\u0430\u043D\u0446\u0456\u0457
        \u0432\u0438\u044F\u0432\u0438\u043B\u0430 \u0440\u043E\u0437\u0431\u0456\u0436\u043D\u043E\u0441\u0442\u0456:\n457
        \u043E\u0444\u0456\u0446\u0456\u0439\u043D\u0438\u0445 \u0437\u0430\u043F\u0438\u0441\u0456\u0432
        \u0435\u043A\u0456\u043F\u0430\u0436\u0443.\n\u0421\u043A\u0430\u043D\u0443\u0432\u0430\u043D\u043D\u044F
        \u043A\u0440\u0456\u043E\u0441\u0442\u0430\u0437\u0443 \u0432\u0438\u044F\u0432\u043B\u044F\u0454
        454 \u0430\u043A\u0442\u0438\u0432\u043D\u0456 \u043A\u0430\u043F\u0441\u0443\u043B\u0438.\n\u0422\u0440\u0438
        \u043A\u0430\u043F\u0441\u0443\u043B\u0438 \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u0456
        \u0432 \u0440\u0435\u0454\u0441\u0442\u0440\u0456.\n\u0423 \u043C\u0435\u0434\u0438\u0447\u043D\u0438\u0445
        \u0430\u0440\u0445\u0456\u0432\u0430\u0445 \u0430\u0431\u043E \u0436\u0443\u0440\u043D\u0430\u043B\u0430\u0445
        \u0432\u0438\u0434\u0430\u043B\u0435\u043D\u043D\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0438
        \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0438\u0445 \u0437\u0430\u043F\u0438\u0441\u0456\u0432
        \u043D\u0435 \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u043E.\n\u0421\u0442\u0430\u0442\u0443\u0441
        \u0437\u043D\u0438\u043A\u043B\u0438\u0445 \u0447\u043B\u0435\u043D\u0456\u0432
        \u0435\u043A\u0456\u043F\u0430\u0436\u0443: \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0438\u0439.\n\u041F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0435\u043D\u043D\u044F:
        \u0434\u0456\u0439\u0442\u0435 \u0437 \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u0456\u0441\u0442\u044E.
        \u041F\u043E\u0434\u0430\u043B\u044C\u0448\u0456 \u0430\u043D\u043E\u043C\u0430\u043B\u0456\u0457
        \u043C\u043E\u0436\u0443\u0442\u044C \u0441\u0432\u0456\u0434\u0447\u0438\u0442\u0438
        \u043F\u0440\u043E \u043B\u044E\u0434\u0441\u044C\u043A\u0435 \u0432\u0442\u0440\u0443\u0447\u0430\u043D\u043D\u044F,
        \u0430 \u043D\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u0443 \u043F\u043E\u043C\u0438\u043B\u043A\u0443."
    - language: 28
      value: "A verifica\xE7\xE3o cruzada da monitoriza\xE7\xE3o de criostase com
        os registos da esta\xE7\xE3o mostra discrep\xE2ncias:\n457 entradas oficiais
        de tripula\xE7\xE3o.\nA varredura de criostase detecta 454 c\xE1psulas activas.\nTr\xEAs
        c\xE1psulas est\xE3o em falta no registo.\nN\xE3o foram encontradas entradas
        correspondentes nos arquivos m\xE9dicos ou nos registos de elimina\xE7\xE3o
        do sistema.\nEstado dos membros da tripula\xE7\xE3o em falta: desconhecido.\nAviso:
        proceder com cautela. Anomalias adicionais podem indicar interfer\xEAncia
        humana, n\xE3o erro do sistema."
    - language: 34
      value: "La comprobaci\xF3n cruzada del monitoreo de criostasis con los registros
        de la estaci\xF3n muestra discrepancias:\n457 entradas oficiales de tripulaci\xF3n.\nEl
        escaneo de criostasis detecta 454 c\xE1psulas activas.\nFaltan tres c\xE1psulas
        en el registro.\nNo se encontraron entradas coincidentes en los archivos
        m\xE9dicos ni en los registros de eliminaci\xF3n del sistema.\nEstado de
        los miembros de la tripulaci\xF3n desaparecidos: desconocido.\nAviso: proceda
        con cautela. Anomal\xEDas adicionales pueden indicar interferencia humana,
        no error del sistema."
