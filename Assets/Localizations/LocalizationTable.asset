  m_Script: {fileID: 11500000, guid: e21a67a49d4758b4290470032ed95e9a, type: 3}
  m_Name: LocalizationTable
  m_EditorClassIdentifier: 
  entries:
  - key: Pick the character that looks like you.
    translations:
    - language: 10
      value: Pick the character that looks like you.
    - language: 38
      value: "\u041E\u0431\u0435\u0440\u0438 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430,
        \u044F\u043A\u0438\u0439 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
        \u044F\u043A \u0442\u0438."
    - language: 28
      value: Escolhe a personagem que se parece contigo.
    - language: 34
      value: Elige el personaje que se parezca a ti.
  - key: Ok
    translations:
    - language: 10
      value: Ok
    - language: 38
      value: "\u0414\u043E\u0431\u0440\u0435"
    - language: 28
      value: Ok
    - language: 34
      value: Ok
  - key: Please complete the storyline first to review your profile.
    translations:
    - language: 10
      value: Please complete the storyline first to review your profile.
    - language: 38
      value: "\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443
        \u043F\u0440\u043E\u0439\u0434\u0438 \u0441\u044E\u0436\u0435\u0442, \u0449\u043E\u0431
        \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u0442\u0438 \u0441\u0432\u0456\u0439
        \u043F\u0440\u043E\u0444\u0456\u043B\u044C."
    - language: 28
      value: "Por favor, completa primeiro a hist\xF3ria para rever o teu perfil."
    - language: 34
      value: Por favor, completa primero la historia para revisar tu perfil.
  - key: Puzzle Power
    translations:
    - language: 10
      value: Puzzle Power
    - language: 38
      value: "\u0421\u0438\u043B\u0430 \u0433\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043E\u043A"
    - language: 28
      value: Poder dos Puzzles
    - language: 34
      value: Poder de los Puzles
  - key: Credits
    translations:
    - language: 10
      value: Credits
    - language: 38
      value: "\u0422\u0438\u0442\u0440\u0438"
    - language: 28
      value: "Cr\xE9ditos"
    - language: 34
      value: "Cr\xE9ditos"
  - key: Truth Detector
    translations:
    - language: 10
      value: Truth Detector
    - language: 38
      value: "\u0414\u0435\u0442\u0435\u043A\u0442\u043E\u0440 \u043F\u0440\u0430\u0432\u0434\u0438"
    - language: 28
      value: Detector de Verdade
    - language: 34
      value: Detector de la Verdad
  - key: Report
    translations:
    - language: 10
      value: Report
    - language: 38
      value: "\u0417\u0432\u0456\u0442"
    - language: 28
      value: "Relat\xF3rio"
    - language: 34
      value: Informe
  - key: Settings
    translations:
    - language: 10
      value: Settings
    - language: 38
      value: "\u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F"
    - language: 28
      value: "Defini\xE7\xF5es"
    - language: 34
      value: Ajustes
  - key: Flex Mode
    translations:
    - language: 10
      value: Flex Mode
    - language: 38
      value: "\u0413\u043D\u0443\u0447\u043A\u0438\u0439 \u0440\u0435\u0436\u0438\u043C"
    - language: 28
      value: "Modo Flex\xEDvel"
    - language: 34
      value: Modo Flexible
  - key: Mood Radar
    translations:
    - language: 10
      value: Mood Radar
    - language: 38
      value: "\u0420\u0430\u0434\u0430\u0440 \u043D\u0430\u0441\u0442\u0440\u043E\u044E"
    - language: 28
      value: Radar de Humor
    - language: 34
      value: "Radar de Estado de \xC1nimo"
  - key: Hair
    translations:
    - language: 10
      value: Hair
    - language: 38
      value: "\u0417\u0430\u0447\u0456\u0441\u043A\u0430"
    - language: 28
      value: Cabelo
    - language: 34
      value: Cabello
  - key: Team Vibes
    translations:
    - language: 10
      value: Team Vibes
    - language: 38
      value: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u0456 \u0432\u0430\u0439\u0431\u0438"
    - language: 28
      value: "Vibra\xE7\xF5es da Equipa"
    - language: 34
      value: Vibras del Equipo
  - key: Yes
    translations:
    - language: 10
      value: Yes
    - language: 38
      value: "\u0422\u0430\u043A"
    - language: 28
      value: Sim
    - language: 34
      value: "S\xED"
  - key: Skin
    translations:
    - language: 10
      value: Skin
    - language: 38
      value: "\u041A\u043E\u043B\u0456\u0440 \u0448\u043A\u0456\u0440\u0438"
    - language: 28
      value: Tom de Pele
    - language: 34
      value: Tono de Piel
  - key: Loading...
    translations:
    - language: 10
      value: Loading...
    - language: 38
      value: "\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F..."
    - language: 28
      value: A carregar...
    - language: 34
      value: Cargando...
  - key: game progress will be reset
    translations:
    - language: 10
      value: All current game progress will be reset. Are you sure you want to start
        a new game?
    - language: 38
      value: "\u0423\u0432\u0435\u0441\u044C \u043F\u043E\u0442\u043E\u0447\u043D\u0438\u0439
        \u043F\u0440\u043E\u0433\u0440\u0435\u0441 \u0433\u0440\u0438 \u0431\u0443\u0434\u0435
        \u0441\u043A\u0438\u043D\u0443\u0442\u043E. \u0412\u0438 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0456,
        \u0449\u043E \u0445\u043E\u0447\u0435\u0442\u0435 \u043F\u043E\u0447\u0430\u0442\u0438
        \u043D\u043E\u0432\u0443 \u0433\u0440\u0443?"
    - language: 28
      value: "Todo o progresso atual do jogo ser\xE1 reposto. Tens a certeza de que
        queres iniciar um novo jogo?"
    - language: 34
      value: "Todo el progreso actual del juego se restablecer\xE1. \xBFEst\xE1s
        seguro de que quieres iniciar una nueva partida?"
  - key: Enter name...
    translations:
    - language: 10
      value: Enter name...
    - language: 38
      value: "\u0412\u0432\u0435\u0434\u0456\u0442\u044C \u0456\u043C\u2019\u044F..."
    - language: 28
      value: Introduzir nome...
    - language: 34
      value: Introducir nombre...
  - key: Introspection Profile
    translations:
    - language: 10
      value: Introspection Profile
    - language: 38
      value: "\u041F\u0440\u043E\u0444\u0456\u043B\u044C \u0441\u0430\u043C\u043E\u0430\u043D\u0430\u043B\u0456\u0437\u0443"
    - language: 28
      value: "Perfil de Introspe\xE7\xE3o"
    - language: 34
      value: "Perfil de Introspecci\xF3n"
  - key: Continue
    translations:
    - language: 10
      value: Continue
    - language: 38
      value: "\u041F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438"
    - language: 28
      value: Continuar
    - language: 34
      value: Continuar
  - key: New Game
    translations:
    - language: 10
      value: New Game
    - language: 38
      value: "\u041D\u043E\u0432\u0430 \u0433\u0440\u0430"
    - language: 28
      value: Novo Jogo
    - language: 34
      value: Nuevo Juego
  - key: No
    translations:
    - language: 10
      value: No
    - language: 38
      value: "\u041D\u0456"
    - language: 28
      value: "N\xE3o"
    - language: 34
      value: No
  - key: A skilled maker who always finds a clever workaround. You're a quick thinker
      who loves solving puzzles and improving systems.
    translations:
    - language: 10
      value: A skilled maker who always finds a clever workaround. You're a quick
        thinker who loves solving puzzles and improving systems.
    - language: 38
      value: "\u041C\u0430\u0439\u0441\u0442\u0435\u0440, \u044F\u043A\u0438\u0439
        \u0437\u0430\u0432\u0436\u0434\u0438 \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C
        \u0445\u0438\u0442\u0440\u0438\u0439 \u043E\u0431\u0445\u0456\u0434\u043D\u0438\u0439
        \u0448\u043B\u044F\u0445. \u0412\u0438 \u0448\u0432\u0438\u0434\u043A\u043E
        \u043C\u0438\u0441\u043B\u0438\u0442\u0435, \u043B\u044E\u0431\u0438\u0442\u0435
        \u0432\u0438\u0440\u0456\u0448\u0443\u0432\u0430\u0442\u0438 \u0433\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043A\u0438
        \u0442\u0430 \u043F\u043E\u043A\u0440\u0430\u0449\u0443\u0432\u0430\u0442\u0438
        \u0441\u0438\u0441\u0442\u0435\u043C\u0438."
    - language: 28
      value: "Um criador habilidoso que encontra sempre uma solu\xE7\xE3o engenhosa.
        Pensas r\xE1pido, adoras resolver enigmas e melhorar sistemas."
    - language: 34
      value: "Un creador h\xE1bil que siempre encuentra una soluci\xF3n ingeniosa.
        Piensas r\xE1pido, te encanta resolver acertijos y mejorar sistemas."
  - key: A natural-born leader. You're calm, competent, and amazing at getting people
      to work together.
    translations:
    - language: 10
      value: A natural-born leader. You're calm, competent, and amazing at getting
        people to work together.
    - language: 38
      value: "\u041F\u0440\u0438\u0440\u043E\u0434\u0436\u0435\u043D\u0438\u0439
        \u043B\u0456\u0434\u0435\u0440. \u0412\u0438 \u0441\u043F\u043E\u043A\u0456\u0439\u043D\u0456,
        \u043A\u043E\u043C\u043F\u0435\u0442\u0435\u043D\u0442\u043D\u0456 \u0442\u0430
        \u0447\u0443\u0434\u043E\u0432\u043E \u0432\u043C\u0456\u0454\u0442\u0435
        \u043E\u0431\u2019\u0454\u0434\u043D\u0443\u0432\u0430\u0442\u0438 \u043B\u044E\u0434\u0435\u0439
        \u0434\u043B\u044F \u0440\u043E\u0431\u043E\u0442\u0438 \u0440\u0430\u0437\u043E\u043C."
    - language: 28
      value: "Um l\xEDder nato. \xC9s calmo, competente e incr\xEDvel a fazer as
        pessoas trabalharem em equipa."
    - language: 34
      value: "Un l\xEDder nato. Eres calmado, competente y asombroso para lograr
        que las personas trabajen juntas."
  - key: A rule-breaker and system-breaker. You learn by taking things apart and
      building them back better.
    translations:
    - language: 10
      value: A rule-breaker and system-breaker. You learn by taking things apart
        and building them back better.
    - language: 38
      value: "\u041F\u043E\u0440\u0443\u0448\u043D\u0438\u043A \u043F\u0440\u0430\u0432\u0438\u043B
        \u0442\u0430 \u0441\u0438\u0441\u0442\u0435\u043C. \u0412\u0438 \u0432\u0447\u0438\u0442\u0435\u0441\u044F,
        \u0440\u043E\u0437\u0431\u0438\u0440\u0430\u044E\u0447\u0438 \u0440\u0435\u0447\u0456
        \u0442\u0430 \u0437\u0431\u0438\u0440\u0430\u044E\u0447\u0438 \u0457\u0445
        \u043A\u0440\u0430\u0449\u0435."
    - language: 28
      value: Um transgressor de regras e sistemas. Aprendes desmontando coisas e
        reconstruindo-as melhor.
    - language: 34
      value: "Un rompe-reglas y rompe-sistemas. Aprendes desarmando cosas y reconstruy\xE9ndolas
        mejor."
  - key: Empathic and attentive. You bring calm to a crisis, sense what others are
      feeling, and are often the unsung hero.
    translations:
    - language: 10
      value: Empathic and attentive. You bring calm to a crisis, sense what others
        are feeling, and are often the unsung hero.
    - language: 38
      value: "\u0415\u043C\u043F\u0430\u0442\u0438\u0447\u043D\u0438\u0439 \u0456
        \u0443\u0432\u0430\u0436\u043D\u0438\u0439. \u0412\u0438 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u0435
        \u0441\u043F\u043E\u043A\u0456\u0439 \u0443 \u043A\u0440\u0438\u0437\u0443,
        \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u0435, \u0449\u043E
        \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E\u0442\u044C \u0456\u043D\u0448\u0456,
        \u0456 \u0447\u0430\u0441\u0442\u043E \u0454 \u043D\u0435\u043F\u043E\u043C\u0456\u0447\u0435\u043D\u0438\u043C
        \u0433\u0435\u0440\u043E\u0454\u043C."
    - language: 28
      value: "Emp\xE1tico e atento. Trazes calma em crises, sentes o que os outros
        est\xE3o a sentir e muitas vezes \xE9s o her\xF3i desconhecido."
    - language: 34
      value: "Emp\xE1tico y atento. Traes calma en una crisis, percibes lo que sienten
        los dem\xE1s y a menudo eres el h\xE9roe desconocido."
  - key: Calm under pressure, you see all sides of a problem. You're the bridge between
      logic, teamwork, and intuition.
    translations:
    - language: 10
      value: Calm under pressure, you see all sides of a problem. You're the bridge
        between logic, teamwork, and intuition.
    - language: 38
      value: "\u0421\u043F\u043E\u043A\u0456\u0439\u043D\u0438\u0439 \u043F\u0456\u0434
        \u0442\u0438\u0441\u043A\u043E\u043C, \u0432\u0438 \u0431\u0430\u0447\u0438\u0442\u0435
        \u0432\u0441\u0456 \u0441\u0442\u043E\u0440\u043E\u043D\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0438.
        \u0412\u0438 \u043C\u0456\u0441\u0442 \u043C\u0456\u0436 \u043B\u043E\u0433\u0456\u043A\u043E\u044E,
        \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u044E \u0440\u043E\u0431\u043E\u0442\u043E\u044E
        \u0442\u0430 \u0456\u043D\u0442\u0443\u0457\u0446\u0456\u0454\u044E."
    - language: 28
      value: "Calmo sob press\xE3o, v\xEAs todos os lados de um problema. \xC9s a
        ponte entre l\xF3gica, trabalho em equipa e intui\xE7\xE3o."
    - language: 34
      value: "Calmado bajo presi\xF3n, ves todos los lados de un problema. Eres el
        puente entre la l\xF3gica, el trabajo en equipo y la intuici\xF3n."
  - key: A witty improviser who bends the rules to win. You're a charming and manipulative
      social hacker.
    translations:
    - language: 10
      value: A witty improviser who bends the rules to win. You're a charming and
        manipulative social hacker.
    - language: 38
      value: "\u0414\u043E\u0442\u0435\u043F\u043D\u0438\u0439 \u0456\u043C\u043F\u0440\u043E\u0432\u0456\u0437\u0430\u0442\u043E\u0440,
        \u044F\u043A\u0438\u0439 \u043F\u043E\u0440\u0443\u0448\u0443\u0454 \u043F\u0440\u0430\u0432\u0438\u043B\u0430,
        \u0449\u043E\u0431 \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0442\u0438.
        \u0412\u0438 \u0447\u0430\u0440\u0456\u0432\u043D\u0438\u0439 \u0456 \u043C\u0430\u043D\u0456\u043F\u0443\u043B\u044F\u0442\u0438\u0432\u043D\u0438\u0439
        \u0441\u043E\u0446\u0456\u0430\u043B\u044C\u043D\u0438\u0439 \u0445\u0430\u043A\u0435\u0440. "
    - language: 28
      value: "Um improvisador espirituoso que dobra as regras para vencer. \xC9s
        um hacker social charmoso e manipulador. "
    - language: 34
      value: 'Un improvisador ingenioso que dobla las reglas para ganar. Eres un
        hacker social encantador y manipulador. '
  - key: Play
    translations:
    - language: 10
      value: Play
    - language: 38
      value: "\u0413\u0440\u0430\u0442\u0438"
    - language: 28
      value: Jogar
    - language: 34
      value: Jugar
  - key: Looks like this challenge is taking some time. Do you want to skip it or
      keep playing?
    translations:
    - language: 10
      value: Looks like this challenge is taking some time. Do you want to skip it
        or keep playing?
    - language: 38
      value: "\u0421\u0445\u043E\u0436\u0435, \u0446\u0435 \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u043D\u044F
        \u0437\u0430\u0439\u043C\u0430\u0454 \u0431\u0430\u0433\u0430\u0442\u043E
        \u0447\u0430\u0441\u0443. \u0425\u043E\u0447\u0435\u0448 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0438
        \u0439\u043E\u0433\u043E \u0447\u0438 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438
        \u0433\u0440\u0443?"
    - language: 28
      value: "Parece que este desafio est\xE1 a demorar algum tempo. Queres salt\xE1-lo
        ou continuar a jogar?"
    - language: 34
      value: "Parece que este desaf\xEDo est\xE1 llevando algo de tiempo. \xBFQuieres
        omitirlo o seguir jugando?"
  - key: Ask Robot
    translations:
    - language: 10
      value: Ask Robot
    - language: 38
      value: "\u0417\u0430\u043F\u0438\u0442\u0430\u0442\u0438 \u0440\u043E\u0431\u043E\u0442\u0430"
    - language: 28
      value: "Perguntar ao rob\xF4"
    - language: 34
      value: Preguntar al robot
  - key: Hold Up, Explorer!
    translations:
    - language: 10
      value: Hold Up, Explorer!
    - language: 38
      value: "\u0417\u0430\u0447\u0435\u043A\u0430\u0439, \u0434\u043E\u0441\u043B\u0456\u0434\u043D\u0438\u043A\u0443!"
    - language: 28
      value: Espera, Explorador!
    - language: 34
      value: "\xA1Espera, Explorador!"
  - key: Skip
    translations:
    - language: 10
      value: Skip
    - language: 38
      value: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0438"
    - language: 28
      value: Saltar
    - language: 34
      value: Omitir
  - key: Radio Settings
    translations:
    - language: 10
      value: Radio Settings
    - language: 38
      value: "\u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
        \u0440\u0430\u0434\u0456\u043E"
    - language: 28
      value: "Defini\xE7\xF5es de r\xE1dio"
    - language: 34
      value: Ajustes de radio
  - key: Skipping chats = missing clues about you
    translations:
    - language: 10
      value: Skipping chats = missing clues about you
    - language: 38
      value: "\u041F\u0440\u043E\u043F\u0443\u0441\u043A \u0434\u0456\u0430\u043B\u043E\u0433\u0456\u0432
        = \u0432\u0442\u0440\u0430\u0442\u0430 \u043F\u0456\u0434\u043A\u0430\u0437\u043E\u043A
        \u043F\u0440\u043E \u0442\u0435\u0431\u0435"
    - language: 28
      value: "Saltar di\xE1logos = perder pistas sobre ti"
    - language: 34
      value: "Saltar di\xE1logos = perder pistas sobre ti"
  - key: 'Instructions: Tap a bolt to unscrew it. Then tap a hole where you want
      to put the bolt. Remove all the panels.'
    translations:
    - language: 10
      value: 'Instructions: Tap a bolt to unscrew it. Then tap a hole where you want
        to put the bolt. Remove all the panels.'
    - language: 38
      value: "\u0406\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u0457: \u0422\u043E\u0440\u043A\u043D\u0438\u0441\u044F
        \u0431\u043E\u043B\u0442\u0430, \u0449\u043E\u0431 \u0432\u0456\u0434\u043A\u0440\u0443\u0442\u0438\u0442\u0438
        \u0439\u043E\u0433\u043E. \u041F\u043E\u0442\u0456\u043C \u0442\u043E\u0440\u043A\u043D\u0438\u0441\u044F
        \u043E\u0442\u0432\u043E\u0440\u0443, \u043A\u0443\u0434\u0438 \u0445\u043E\u0447\u0435\u0448
        \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0431\u043E\u043B\u0442.
        \u0417\u043D\u0456\u043C\u0438 \u0432\u0441\u0456 \u043F\u0430\u043D\u0435\u043B\u0456."
    - language: 28
      value: "Instru\xE7\xF5es: Toca num parafuso para o desapertar. Depois toca
        num buraco onde queres colocar o parafuso. Remove todos os pain\xE9is."
    - language: 34
      value: 'Instrucciones: Toca un tornillo para desenroscarlo. Luego toca un agujero
        donde quieras poner el tornillo. Quita todos los paneles.'
  - key: Tasks
    translations:
    - language: 10
      value: Tasks
    - language: 38
      value: "\u0417\u0430\u0432\u0434\u0430\u043D\u043D\u044F"
    - language: 28
      value: Tarefas
    - language: 34
      value: Tareas
  - key: Reports
    translations:
    - language: 10
      value: Reports
    - language: 38
      value: "\u0417\u0432\u0456\u0442\u0438"
    - language: 28
      value: "Relat\xF3rios"
    - language: 34
      value: Informes
  - key: Inventory
    translations:
    - language: 10
      value: Inventory
    - language: 38
      value: "\u0406\u043D\u0432\u0435\u043D\u0442\u0430\u0440"
    - language: 28
      value: "Invent\xE1rio"
    - language: 34
      value: Inventario
  - key: Chat
    translations:
    - language: 10
      value: Chat
    - language: 38
      value: "\u0427\u0430\u0442"
    - language: 28
      value: Chat
    - language: 34
      value: Chat
  - key: Find out what happend
    translations:
    - language: 10
      value: Find out what happend
    - language: 38
      value: "\u0414\u0456\u0437\u043D\u0430\u0439\u0441\u044F, \u0449\u043E \u0441\u0442\u0430\u043B\u043E\u0441\u044F"
    - language: 28
      value: Descobre o que aconteceu
    - language: 34
      value: "Averigua qu\xE9 pas\xF3"
  - key: Description
    translations:
    - language: 10
      value: Description
    - language: 38
      value: "\u041E\u043F\u0438\u0441"
    - language: 28
      value: "Descri\xE7\xE3o"
    - language: 34
      value: "Descripci\xF3n"
  - key: Robot
    translations:
    - language: 10
      value: Robot
    - language: 38
      value: "\u0420\u043E\u0431\u043E\u0442"
    - language: 28
      value: "Rob\xF4"
    - language: 34
      value: Robot
  - key: How can I assist you?
    translations:
    - language: 10
      value: How can I assist you?
    - language: 38
      value: "\u0427\u0438\u043C \u044F \u043C\u043E\u0436\u0443 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438?"
    - language: 28
      value: Como posso ajudar?
    - language: 34
      value: "\xBFC\xF3mo puedo ayudarte?"
  - key: Enter the question...
    translations:
    - language: 10
      value: Enter the question...
    - language: 38
      value: "\u0412\u0432\u0435\u0434\u0438 \u0437\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F..."
    - language: 28
      value: Introduz a pergunta...
    - language: 34
      value: Introduce la pregunta...
  - key: Ask
    translations:
    - language: 10
      value: Ask
    - language: 38
      value: "\u0417\u0430\u043F\u0438\u0442\u0430\u0442\u0438"
    - language: 28
      value: Perguntar
    - language: 34
      value: Preguntar
  - key: Arrange tetrominoes in the grid. Tap to rotate.
    translations:
    - language: 10
      value: Arrange tetrominoes in the grid. Tap to rotate.
    - language: 38
      value: "\u0420\u043E\u0437\u043C\u0456\u0441\u0442\u0438 \u0442\u0435\u0442\u0440\u043E\u043C\u0456\u043D\u043E
        \u0432 \u0441\u0456\u0442\u0446\u0456. \u0422\u043E\u0440\u043A\u043D\u0438\u0441\u044F,
        \u0449\u043E\u0431 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438."
    - language: 28
      value: "Organiza os tetramin\xF3s na grelha. Toca para rodar."
    - language: 34
      value: "Organiza los tetromin\xF3s en la cuadr\xEDcula. Toca para rotar."
  - key: "Every answer you pick helps the system learn your style. So slow down,
      read, and choose like it means something (\u2019cause it does)."
    translations:
    - language: 10
      value: "Every answer you pick helps the system learn your style. So slow down,
        read, and choose like it means something (\u2019cause it does)."
    - language: 38
      value: "\u041A\u043E\u0436\u043D\u0430 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C,
        \u044F\u043A\u0443 \u0442\u0438 \u043E\u0431\u0438\u0440\u0430\u0454\u0448,
        \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454 \u0441\u0438\u0441\u0442\u0435\u043C\u0456
        \u0432\u0438\u0432\u0447\u0430\u0442\u0438 \u0442\u0432\u0456\u0439 \u0441\u0442\u0438\u043B\u044C.
        \u0422\u043E\u0436 \u043D\u0435 \u043F\u043E\u0441\u043F\u0456\u0448\u0430\u0439,
        \u0447\u0438\u0442\u0430\u0439 \u0456 \u043E\u0431\u0438\u0440\u0430\u0439
        \u0442\u0430\u043A, \u043D\u0456\u0431\u0438 \u0446\u0435 \u043C\u0430\u0454
        \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F (\u0431\u043E \u0442\u0430\u043A
        \u0456 \u0454)."
    - language: 28
      value: "Cada resposta que escolhes ajuda o sistema a aprender o teu estilo.
        Por isso abranda, l\xEA e escolhe como se isso tivesse import\xE2ncia (porque
        tem)."
    - language: 34
      value: "Cada respuesta que eliges ayuda al sistema a aprender tu estilo. As\xED
        que ve con calma, lee y elige como si importara (porque importa)."
  - key: Find the Code
    translations:
    - language: 10
      value: Find the Code
    - language: 38
      value: "\u0417\u043D\u0430\u0439\u0434\u0438 \u043A\u043E\u0434"
    - language: 28
      value: "Encontra o c\xF3digo"
    - language: 34
      value: "Encuentra el c\xF3digo"
  - key: "The door won\u2019t budge without an access code. Search the first floor
      to track it down."
    translations:
    - language: 10
      value: "The door won\u2019t budge without an access code. Search the first
        floor to track it down."
    - language: 38
      value: "\u0414\u0432\u0435\u0440\u0456 \u043D\u0435 \u0432\u0456\u0434\u0447\u0438\u043D\u044F\u0442\u044C\u0441\u044F
        \u0431\u0435\u0437 \u043A\u043E\u0434\u0443 \u0434\u043E\u0441\u0442\u0443\u043F\u0443.
        \u041E\u0431\u0448\u0443\u043A\u0430\u0439 \u043F\u0435\u0440\u0448\u0438\u0439
        \u043F\u043E\u0432\u0435\u0440\u0445, \u0449\u043E\u0431 \u0437\u043D\u0430\u0439\u0442\u0438
        \u0439\u043E\u0433\u043E."
    - language: 28
      value: "A porta n\xE3o se mexe sem um c\xF3digo de acesso. Explora o primeiro
        piso para o encontrar."
    - language: 34
      value: "La puerta no se mover\xE1 sin un c\xF3digo de acceso. Explora la primera
        planta para encontrarlo."
  - key: Guess the Code
    translations:
    - language: 10
      value: Guess the Code
    - language: 38
      value: "\u0412\u0433\u0430\u0434\u0430\u0439 \u043A\u043E\u0434"
    - language: 28
      value: "Adivinha o c\xF3digo"
    - language: 34
      value: "Adivina el c\xF3digo"
  - key: The numpad wants a number. Guess the code in reports and type it in. If
      you get it right, the door will giggle and open. If not, it will give you a
      sassy beep - error.
    translations:
    - language: 10
      value: The numpad wants a number. Guess the code in reports and type it in.
        If you get it right, the door will giggle and open. If not, it will give
        you a sassy beep - error.
    - language: 38
      value: "\u041A\u043B\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0430 \u0447\u0435\u043A\u0430\u0454
        \u0447\u0438\u0441\u043B\u043E. \u0412\u0433\u0430\u0434\u0430\u0439 \u043A\u043E\u0434
        \u0443 \u0437\u0432\u0456\u0442\u0430\u0445 \u0456 \u0432\u0432\u0435\u0434\u0438
        \u0439\u043E\u0433\u043E. \u042F\u043A\u0449\u043E \u0432\u0433\u0430\u0434\u0430\u0454\u0448,
        \u0434\u0432\u0435\u0440\u0456 \u0445\u0438\u0445\u0438\u043A\u043D\u0443\u0442\u044C
        \u0456 \u0432\u0456\u0434\u0447\u0438\u043D\u044F\u0442\u044C\u0441\u044F.
        \u042F\u043A\u0449\u043E \u043D\u0456 \u2014 \u043F\u0440\u043E\u043B\u0443\u043D\u0430\u0454
        \u0437\u0443\u0445\u0432\u0430\u043B\u0438\u0439 \u0441\u0438\u0433\u043D\u0430\u043B
        \u043F\u043E\u043C\u0438\u043B\u043A\u0438."
    - language: 28
      value: "O teclado num\xE9rico quer um n\xFAmero. Adivinha o c\xF3digo nos relat\xF3rios
        e introduz-o. Se acertares, a porta vai rir e abrir. Caso contr\xE1rio, vais
        ouvir um bip atrevido \u2014 erro."
    - language: 34
      value: "El teclado num\xE9rico quiere un n\xFAmero. Adivina el c\xF3digo en
        los informes y escr\xEDbelo. Si aciertas, la puerta soltar\xE1 una risita
        y se abrir\xE1. Si no, te dar\xE1 un pitido burl\xF3n de error."
  - key: Find the diagram
    translations:
    - language: 10
      value: Find the diagram
    - language: 38
      value: "\u0417\u043D\u0430\u0439\u0434\u0438 \u0441\u0445\u0435\u043C\u0443"
    - language: 28
      value: Encontra o diagrama
    - language: 34
      value: Encuentra el diagrama
  - key: "The door won\u2019t budge. Find the diagram on the first floor and give
      it to your robot helper so it can hack the lock for you."
    translations:
    - language: 10
      value: "The door won\u2019t budge. Find the diagram on the first floor and
        give it to your robot helper so it can hack the lock for you."
    - language: 38
      value: "\u0414\u0432\u0435\u0440\u0456 \u043D\u0435 \u0432\u0456\u0434\u0447\u0438\u043D\u044F\u044E\u0442\u044C\u0441\u044F.
        \u0417\u043D\u0430\u0439\u0434\u0438 \u0441\u0445\u0435\u043C\u0443 \u043D\u0430
        \u043F\u0435\u0440\u0448\u043E\u043C\u0443 \u043F\u043E\u0432\u0435\u0440\u0441\u0456
        \u0439 \u043F\u0435\u0440\u0435\u0434\u0430\u0439 \u0457\u0457 \u0440\u043E\u0431\u043E\u0442\u0443-\u043F\u043E\u043C\u0456\u0447\u043D\u0438\u043A\u0443,
        \u0449\u043E\u0431 \u0432\u0456\u043D \u0437\u043B\u0430\u043C\u0430\u0432
        \u0437\u0430\u043C\u043E\u043A."
    - language: 28
      value: "A porta n\xE3o se mexe. Encontra o diagrama no primeiro piso e entrega-o
        ao teu rob\xF4 ajudante para que ele possa piratear a fechadura."
    - language: 34
      value: "La puerta no se mueve. Encuentra el diagrama en la primera planta y
        d\xE1selo a tu robot ayudante para que pueda piratear la cerradura."
  - key: Override Lock
    translations:
    - language: 10
      value: Override Lock
    - language: 38
      value: "\u041E\u0431\u0456\u0439\u0434\u0438 \u0431\u043B\u043E\u043A\u0443\u0432\u0430\u043D\u043D\u044F"
    - language: 28
      value: Anular a fechadura
    - language: 34
      value: Anular la cerradura
  - key: The door is locked. Take the robot to the door terminal and let it use the
      diagram to reconfigure the lock. When the robot finishes, the door will release.
    translations:
    - language: 10
      value: The door is locked. Take the robot to the door terminal and let it use
        the diagram to reconfigure the lock. When the robot finishes, the door will
        release.
    - language: 38
      value: "\u0414\u0432\u0435\u0440\u0456 \u0437\u0430\u0447\u0438\u043D\u0435\u043D\u0456.
        \u0412\u0456\u0434\u0432\u0435\u0434\u0438 \u0440\u043E\u0431\u043E\u0442\u0430
        \u0434\u043E \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0430 \u0434\u0432\u0435\u0440\u0435\u0439
        \u0456 \u0434\u043E\u0437\u0432\u043E\u043B\u044C \u0439\u043E\u043C\u0443
        \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438 \u0441\u0445\u0435\u043C\u0443
        \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
        \u0437\u0430\u043C\u043A\u0430. \u041A\u043E\u043B\u0438 \u0440\u043E\u0431\u043E\u0442
        \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u044C, \u0434\u0432\u0435\u0440\u0456
        \u0432\u0456\u0434\u0447\u0438\u043D\u044F\u0442\u044C\u0441\u044F."
    - language: 28
      value: "A porta est\xE1 trancada. Leva o rob\xF4 at\xE9 ao terminal da porta
        e deixa-o usar o diagrama para reconfigurar a fechadura. Quando terminar,
        a porta ir\xE1 abrir."
    - language: 34
      value: "La puerta est\xE1 cerrada. Lleva al robot al terminal de la puerta
        y deja que use el diagrama para reconfigurar la cerradura. Cuando termine,
        la puerta se liberar\xE1."
  - key: Unlock the door
    translations:
    - language: 10
      value: Unlock the door
    - language: 38
      value: "\u0412\u0456\u0434\u0456\u043C\u043A\u043D\u0438 \u0434\u0432\u0435\u0440\u0456"
    - language: 28
      value: Destranca a porta
    - language: 34
      value: Desbloquea la puerta
  - key: "The door won\u2019t budge. Grab your tools and start tinkering. Twist,
      pry, and fiddle with the mechanism until it clicks - then the door will easily
      open."
    translations:
    - language: 10
      value: "The door won\u2019t budge. Grab your tools and start tinkering. Twist,
        pry, and fiddle with the mechanism until it clicks - then the door will easily
        open."
    - language: 38
      value: "\u0414\u0432\u0435\u0440\u0456 \u043D\u0435 \u043F\u0456\u0434\u0434\u0430\u044E\u0442\u044C\u0441\u044F.
        \u0412\u0456\u0437\u044C\u043C\u0438 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438
        \u0439 \u043F\u043E\u0447\u0438\u043D\u0430\u0439 \u043C\u0430\u0439\u0441\u0442\u0440\u0443\u0432\u0430\u0442\u0438.
        \u041A\u0440\u0443\u0442\u0438, \u043F\u0456\u0434\u0432\u0430\u0436\u0443\u0439
        \u0456 \u0432\u043E\u0437\u0438\u0441\u044F \u0437 \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u043E\u043C,
        \u043F\u043E\u043A\u0438 \u043D\u0435 \u043A\u043B\u0430\u0446\u043D\u0435
        \u2014 \u0442\u043E\u0434\u0456 \u0434\u0432\u0435\u0440\u0456 \u043B\u0435\u0433\u043A\u043E
        \u0432\u0456\u0434\u0447\u0438\u043D\u044F\u0442\u044C\u0441\u044F."
    - language: 28
      value: "A porta n\xE3o se mexe. Agarra nas ferramentas e come\xE7a a mexer.
        Roda, for\xE7a e ajusta o mecanismo at\xE9 fazer clique \u2014 depois a porta
        abrir\xE1 facilmente."
    - language: 34
      value: "La puerta no cede. Coge tus herramientas y empieza a trastear. Gira,
        haz palanca y manipula el mecanismo hasta que haga clic; entonces la puerta
        se abrir\xE1 sin problema."
  - key: Gather the Tools
    translations:
    - language: 10
      value: Gather the Tools
    - language: 38
      value: "\u0417\u0431\u0435\u0440\u0438 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438"
    - language: 28
      value: Recolhe as ferramentas
    - language: 34
      value: "Re\xFAne las herramientas"
  - key: "The door\u2019s broken and needs fixing. Head to the second floor to collect
      the soldering iron and a diagnostic tool."
    translations:
    - language: 10
      value: "The door\u2019s broken and needs fixing. Head to the second floor to
        collect the soldering iron and a diagnostic tool."
    - language: 38
      value: "\u0414\u0432\u0435\u0440\u0456 \u0437\u043B\u0430\u043C\u0430\u043D\u0456
        \u0439 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u044E\u0442\u044C \u0440\u0435\u043C\u043E\u043D\u0442\u0443.
        \u0412\u0438\u0440\u0443\u0448\u0430\u0439 \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0439
        \u043F\u043E\u0432\u0435\u0440\u0445, \u0449\u043E\u0431 \u0437\u0456\u0431\u0440\u0430\u0442\u0438
        \u043F\u0430\u044F\u043B\u044C\u043D\u0438\u043A \u0456 \u0434\u0456\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u0447\u043D\u0438\u0439
        \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442."
    - language: 28
      value: "A porta est\xE1 avariada e precisa de repara\xE7\xE3o. Vai ao segundo
        piso recolher o ferro de soldar e a ferramenta de diagn\xF3stico."
    - language: 34
      value: "La puerta est\xE1 rota y necesita reparaci\xF3n. Ve a la segunda planta
        para recoger el soldador y la herramienta de diagn\xF3stico."
  - key: Suit Up
    translations:
    - language: 10
      value: Suit Up
    - language: 38
      value: "\u041E\u0434\u044F\u0433\u043D\u0438\u0441\u044C"
    - language: 28
      value: Equipa-te
    - language: 34
      value: "Equ\xEDpate"
  - key: "Head to the space suit and get ready for whatever\u2019s waiting in the
      corridor."
    translations:
    - language: 10
      value: "Head to the space suit and get ready for whatever\u2019s waiting in
        the corridor."
    - language: 38
      value: "\u041F\u0456\u0434\u0456\u0439\u0434\u0438 \u0434\u043E \u0441\u043A\u0430\u0444\u0430\u043D\u0434\u0440\u0430
        \u0439 \u043F\u0456\u0434\u0433\u043E\u0442\u0443\u0439\u0441\u044F \u0434\u043E
        \u0432\u0441\u044C\u043E\u0433\u043E, \u0449\u043E \u0447\u0435\u043A\u0430\u0454
        \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0456."
    - language: 28
      value: "Vai at\xE9 ao fato espacial e prepara-te para o que quer que te espere
        no corredor."
    - language: 34
      value: "Dir\xEDgete al traje espacial y prep\xE1rate para lo que te espere
        en el pasillo."
  - key: Power Up
    translations:
    - language: 10
      value: Power Up
    - language: 38
      value: "\u0423\u0432\u0456\u043C\u043A\u043D\u0438 \u0436\u0438\u0432\u043B\u0435\u043D\u043D\u044F"
    - language: 28
      value: Liga a energia
    - language: 34
      value: "Enciende la energ\xEDa"
  - key: "Everything\u2019s offline when you wake up. Head to the terminal and bring
      the station back to life."
    translations:
    - language: 10
      value: "Everything\u2019s offline when you wake up. Head to the terminal and
        bring the station back to life."
    - language: 38
      value: "\u041A\u043E\u043B\u0438 \u0442\u0438 \u043F\u0440\u043E\u043A\u0438\u0434\u0430\u0454\u0448\u0441\u044F,
        \u0443\u0441\u0435 \u0432\u0438\u043C\u043A\u043D\u0435\u043D\u043E. \u0406\u0434\u0438
        \u0434\u043E \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0430 \u0439
        \u043F\u043E\u0432\u0435\u0440\u043D\u0438 \u0441\u0442\u0430\u043D\u0446\u0456\u044E
        \u0434\u043E \u0436\u0438\u0442\u0442\u044F."
    - language: 28
      value: "Tudo est\xE1 desligado quando acordas. Vai ao terminal e devolve a
        vida \xE0 esta\xE7\xE3o."
    - language: 34
      value: "Todo est\xE1 apagado cuando despiertas. Ve al terminal y devuelve la
        vida a la estaci\xF3n."
  - key: Grab the Axe
    translations:
    - language: 10
      value: Grab the Axe
    - language: 38
      value: "\u0412\u0456\u0437\u044C\u043C\u0438 \u0441\u043E\u043A\u0438\u0440\u0443"
    - language: 28
      value: Apanha o machado
    - language: 34
      value: Coge el hacha
  - key: The roots are blocking your way out. To get the axe, you first need to find
      the code. Unlock it, grab the axe, and chop your way out of the station.
    translations:
    - language: 10
      value: The roots are blocking your way out. To get the axe, you first need
        to find the code. Unlock it, grab the axe, and chop your way out of the station.
    - language: 38
      value: "\u041A\u043E\u0440\u0456\u043D\u043D\u044F \u0431\u043B\u043E\u043A\u0443\u0454
        \u0432\u0438\u0445\u0456\u0434. \u0429\u043E\u0431 \u0434\u0456\u0441\u0442\u0430\u0442\u0438
        \u0441\u043E\u043A\u0438\u0440\u0443, \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443
        \u0437\u043D\u0430\u0439\u0434\u0438 \u043A\u043E\u0434. \u0412\u0456\u0434\u0456\u043C\u043A\u043D\u0438,
        \u0432\u0456\u0437\u044C\u043C\u0438 \u0441\u043E\u043A\u0438\u0440\u0443
        \u0439 \u043F\u0440\u043E\u0440\u0443\u0431\u0430\u0439 \u0441\u043E\u0431\u0456
        \u0448\u043B\u044F\u0445 \u0437\u0456 \u0441\u0442\u0430\u043D\u0446\u0456\u0457."
    - language: 28
      value: "As ra\xEDzes est\xE3o a bloquear a sa\xEDda. Para obteres o machado,
        primeiro tens de encontrar o c\xF3digo. Desbloqueia, pega no machado e abre
        caminho para fora da esta\xE7\xE3o."
    - language: 34
      value: "Las ra\xEDces bloquean la salida. Para conseguir el hacha, primero
        debes encontrar el c\xF3digo. Desbloqu\xE9ala, toma el hacha y \xE1brete
        paso fuera de la estaci\xF3n."
  - key: Find the screwdriver
    translations:
    - language: 10
      value: Find the screwdriver
    - language: 38
      value: "\u0417\u043D\u0430\u0439\u0434\u0438 \u0432\u0438\u043A\u0440\u0443\u0442\u043A\u0443"
    - language: 28
      value: Encontra a chave de fendas
    - language: 34
      value: Encuentra el destornillador
  - key: "The terminal won\u2019t work without a little help. Find the screwdriver,
      and open its back panel to fix it."
    translations:
    - language: 10
      value: "The terminal won\u2019t work without a little help. Find the screwdriver,
        and open its back panel to fix it."
    - language: 38
      value: "\u0422\u0435\u0440\u043C\u0456\u043D\u0430\u043B \u043D\u0435 \u043F\u0440\u0430\u0446\u044E\u0454
        \u0431\u0435\u0437 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0438. \u0417\u043D\u0430\u0439\u0434\u0438
        \u0432\u0438\u043A\u0440\u0443\u0442\u043A\u0443 \u0439 \u0432\u0456\u0434\u043A\u0440\u0438\u0439
        \u0437\u0430\u0434\u043D\u044E \u043F\u0430\u043D\u0435\u043B\u044C, \u0449\u043E\u0431
        \u0439\u043E\u0433\u043E \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438."
    - language: 28
      value: "O terminal n\xE3o funciona sem uma ajudinha. Encontra a chave de fendas
        e abre o painel traseiro para o reparar."
    - language: 34
      value: "El terminal no funcionar\xE1 sin un poco de ayuda. Encuentra el destornillador
        y abre el panel trasero para arreglarlo."
  - key: Find Anyone
    translations:
    - language: 10
      value: Find Anyone
    - language: 38
      value: "\u0417\u043D\u0430\u0439\u0434\u0438 \u043A\u043E\u0433\u043E\u0441\u044C"
    - language: 28
      value: "Encontra algu\xE9m"
    - language: 34
      value: Encuentra a alguien
  - key: The station feels empty. Explore the corridors and look for any sign of
      another person.
    translations:
    - language: 10
      value: The station feels empty. Explore the corridors and look for any sign
        of another person.
    - language: 38
      value: "\u0421\u0442\u0430\u043D\u0446\u0456\u044F \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F
        \u043F\u043E\u0440\u043E\u0436\u043D\u044C\u043E\u044E. \u0414\u043E\u0441\u043B\u0456\u0434\u0438
        \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0438 \u0439 \u0448\u0443\u043A\u0430\u0439
        \u0431\u0443\u0434\u044C-\u044F\u043A\u0456 \u043E\u0437\u043D\u0430\u043A\u0438
        \u0456\u043D\u0448\u043E\u0457 \u043B\u044E\u0434\u0438\u043D\u0438."
    - language: 28
      value: "A esta\xE7\xE3o parece vazia. Explora os corredores e procura qualquer
        sinal de outra pessoa."
    - language: 34
      value: "La estaci\xF3n se siente vac\xEDa. Explora los pasillos y busca cualquier
        se\xF1al de otra persona."
  - key: Go to the Engineering Door
    translations:
    - language: 10
      value: Go to the Engineering Door
    - language: 38
      value: "\u0406\u0434\u0438 \u0434\u043E \u0456\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u0438\u0445
        \u0434\u0432\u0435\u0440\u0435\u0439"
    - language: 28
      value: "Vai at\xE9 \xE0 porta da Engenharia"
    - language: 34
      value: "Ve a la puerta de Ingenier\xEDa"
  - key: "You need to get into the engineering corridor. Go to the big metal door
      and try to open it\u2026 but of course, it is broken and does not want to listen."
    translations:
    - language: 10
      value: "You need to get into the engineering corridor. Go to the big metal
        door and try to open it\u2026 but of course, it is broken and does not want
        to listen."
    - language: 38
      value: "\u0422\u043E\u0431\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438 \u0432 \u0456\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u0438\u0439
        \u043A\u043E\u0440\u0438\u0434\u043E\u0440. \u041F\u0456\u0434\u0456\u0439\u0434\u0438
        \u0434\u043E \u0432\u0435\u043B\u0438\u043A\u0438\u0445 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0438\u0445
        \u0434\u0432\u0435\u0440\u0435\u0439 \u0456 \u0441\u043F\u0440\u043E\u0431\u0443\u0439
        \u0432\u0456\u0434\u0447\u0438\u043D\u0438\u0442\u0438 \u0457\u0445\u2026
        \u0430\u043B\u0435, \u0437\u0432\u0456\u0441\u043D\u043E, \u0432\u043E\u043D\u0438
        \u0437\u043B\u0430\u043C\u0430\u043D\u0456 \u0439 \u043D\u0435 \u0445\u043E\u0447\u0443\u0442\u044C
        \u0441\u043B\u0443\u0445\u0430\u0442\u0438\u0441\u044F."
    - language: 28
      value: "Precisas de entrar no corredor de engenharia. Vai at\xE9 \xE0 grande
        porta met\xE1lica e tenta abri-la\u2026 mas claro, est\xE1 avariada e n\xE3o
        quer colaborar."
    - language: 34
      value: "Necesitas entrar en el corredor de ingenier\xEDa. Ve a la gran puerta
        met\xE1lica e intenta abrirla\u2026 pero, por supuesto, est\xE1 rota y no
        quiere obedecer."
  - key: Locate the energy hall
    translations:
    - language: 10
      value: Locate the energy hall
    - language: 38
      value: "\u0417\u043D\u0430\u0439\u0434\u0438 \u0435\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u043D\u0438\u0439
        \u0437\u0430\u043B"
    - language: 28
      value: Localiza a sala de energia
    - language: 34
      value: "Localiza la sala de energ\xEDa"
  - key: Explore the station and find the door that leads to the Energy distribution
      hall.
    translations:
    - language: 10
      value: Explore the station and find the door that leads to the Energy distribution
        hall.
    - language: 38
      value: "\u0414\u043E\u0441\u043B\u0456\u0434\u0438 \u0441\u0442\u0430\u043D\u0446\u0456\u044E
        \u0439 \u0437\u043D\u0430\u0439\u0434\u0438 \u0434\u0432\u0435\u0440\u0456,
        \u0449\u043E \u0432\u0435\u0434\u0443\u0442\u044C \u0434\u043E \u0437\u0430\u043B\u0443
        \u0440\u043E\u0437\u043F\u043E\u0434\u0456\u043B\u0443 \u0435\u043D\u0435\u0440\u0433\u0456\u0457."
    - language: 28
      value: "Explora a esta\xE7\xE3o e encontra a porta que leva \xE0 sala de distribui\xE7\xE3o
        de energia."
    - language: 34
      value: "Explora la estaci\xF3n y encuentra la puerta que conduce a la sala
        de distribuci\xF3n de energ\xEDa."
  - key: Boot the Buddy
    translations:
    - language: 10
      value: Boot the Buddy
    - language: 38
      value: "\u0423\u0432\u0456\u043C\u043A\u043D\u0438 \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u0430"
    - language: 28
      value: Liga o companheiro
    - language: 34
      value: "Inicia al compa\xF1ero"
  - key: Switch the robot back on and get yourself some company.
    translations:
    - language: 10
      value: Switch the robot back on and get yourself some company.
    - language: 38
      value: "\u0423\u0432\u0456\u043C\u043A\u043D\u0438 \u0440\u043E\u0431\u043E\u0442\u0430
        \u0437\u043D\u043E\u0432\u0443 \u0439 \u0441\u043A\u043B\u0430\u0434\u0438
        \u0441\u043E\u0431\u0456 \u043A\u043E\u043C\u043F\u0430\u043D\u0456\u044E."
    - language: 28
      value: "Volta a ligar o rob\xF4 e ganha alguma companhia."
    - language: 34
      value: "Vuelve a encender al robot y cons\xEDguete compa\xF1\xEDa."
  - key: Head to the Door
    translations:
    - language: 10
      value: Head to the Door
    - language: 38
      value: "\u0406\u0434\u0438 \u0434\u043E \u0434\u0432\u0435\u0440\u0435\u0439"
    - language: 28
      value: "Vai at\xE9 \xE0 porta"
    - language: 34
      value: Ve a la puerta
  - key: "You need to leave the cryo room. Go to the door on the right and see if
      you can open it\u2026 though it might not be that simple."
    translations:
    - language: 10
      value: "You need to leave the cryo room. Go to the door on the right and see
        if you can open it\u2026 though it might not be that simple."
    - language: 38
      value: "\u0422\u043E\u0431\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u0438 \u043A\u0440\u0456\u043E\u043A\u0430\u043C\u0435\u0440\u0443.
        \u041F\u0456\u0434\u0456\u0439\u0434\u0438 \u0434\u043E \u0434\u0432\u0435\u0440\u0435\u0439
        \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447 \u0456 \u043F\u043E\u0434\u0438\u0432\u0438\u0441\u044F,
        \u0447\u0438 \u0437\u043C\u043E\u0436\u0435\u0448 \u0457\u0445 \u0432\u0456\u0434\u0447\u0438\u043D\u0438\u0442\u0438\u2026
        \u0445\u043E\u0447\u0430 \u0446\u0435 \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438
        \u043D\u0435 \u0442\u0430\u043A \u043F\u0440\u043E\u0441\u0442\u043E."
    - language: 28
      value: "Precisas de sair da sala criog\xE9nica. Vai at\xE9 \xE0 porta \xE0
        direita e v\xEA se a consegues abrir\u2026 embora possa n\xE3o ser assim
        t\xE3o simples."
    - language: 34
      value: "Necesitas salir de la sala criog\xE9nica. Ve a la puerta de la derecha
        e intenta abrirla\u2026 aunque puede que no sea tan sencillo."
  - key: Root Buster
    translations:
    - language: 10
      value: Root Buster
    - language: 38
      value: "\u0420\u0443\u0439\u043D\u0456\u0432\u043D\u0438\u043A \u043A\u043E\u0440\u0456\u043D\u043D\u044F"
    - language: 28
      value: "Destruidor de ra\xEDzes"
    - language: 34
      value: "Destructor de ra\xEDces"
  - key: The axe from the fire locker is yours. Swing it at the thick roots tangled
      in the wall and carve a path through - nothing should stand in your way!
    translations:
    - language: 10
      value: The axe from the fire locker is yours. Swing it at the thick roots tangled
        in the wall and carve a path through - nothing should stand in your way!
    - language: 38
      value: "\u0421\u043E\u043A\u0438\u0440\u0430 \u0437 \u043F\u043E\u0436\u0435\u0436\u043D\u043E\u0457
        \u0448\u0430\u0444\u0438 \u0442\u0435\u043F\u0435\u0440 \u0442\u0432\u043E\u044F.
        \u0420\u043E\u0437\u043C\u0430\u0445\u043D\u0438\u0441\u044F \u043D\u0435\u044E
        \u043F\u043E \u0442\u043E\u0432\u0441\u0442\u043E\u043C\u0443 \u043A\u043E\u0440\u0456\u043D\u043D\u044E,
        \u0449\u043E \u0437\u0430\u043F\u043B\u0443\u0442\u0430\u043B\u043E\u0441\u044F
        \u0432 \u0441\u0442\u0456\u043D\u0456, \u0456 \u043F\u0440\u043E\u0440\u0443\u0431\u0430\u0439
        \u0448\u043B\u044F\u0445 \u2014 \u043D\u0456\u0449\u043E \u043D\u0435 \u0441\u0442\u0430\u043D\u0435
        \u043D\u0430 \u0437\u0430\u0432\u0430\u0434\u0456!"
    - language: 28
      value: "O machado do arm\xE1rio de inc\xEAndio \xE9 teu. Usa-o contra as ra\xEDzes
        grossas entranhadas na parede e abre caminho \u2014 nada te deve impedir!"
    - language: 34
      value: "El hacha del armario contra incendios es tuya. Golpea las gruesas ra\xEDces
        enredadas en la pared y \xE1brete paso: \xA1nada deber\xEDa detenerte!"
  - key: "Report 01 \u2014 Population Status"
    translations:
    - language: 10
      value: "Report 01 \u2014 Population Status"
    - language: 38
      value: "\u0417\u0432\u0456\u0442 01 \u2014 \u0421\u0442\u0430\u043D \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u043D\u044F"
    - language: 28
      value: "Relat\xF3rio 01 \u2014 Estado da Popula\xE7\xE3o"
    - language: 34
      value: "Informe 01 \u2014 Estado de la Poblaci\xF3n"
  - key: "On board the intergalactic station \u201CAletheia\u201D there are:\nColonists:
      20,000 individuals in stasis.\nCrew: 457 specialists, including officers, engineers,
      and medics \u2014 also in cryosleep.\n The official mission goal is the transportation
      of colonists to the planet Eden-7, located 27 light years from Earth.\n All
      cryo-chambers are functioning in stable condition. No active system administrators
      are present."
    translations:
    - language: 10
      value: "On board the intergalactic station \u201CAletheia\u201D there are:\nColonists:
        20,000 individuals in stasis.\nCrew: 457 specialists, including officers,
        engineers, and medics \u2014 also in cryosleep.\n The official mission goal
        is the transportation of colonists to the planet Eden-7, located 27 light
        years from Earth.\n All cryo-chambers are functioning in stable condition.
        No active system administrators are present."
    - language: 38
      value: "\u041D\u0430 \u0431\u043E\u0440\u0442\u0443 \u043C\u0456\u0436\u0433\u0430\u043B\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0457
        \u0441\u0442\u0430\u043D\u0446\u0456\u0457 \xAB\u0410\u043B\u0435\u0442\u0435\u0439\u044F\xBB
        \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u044E\u0442\u044C:\n\u041A\u043E\u043B\u043E\u043D\u0456\u0441\u0442\u0438:
        20 000 \u043E\u0441\u0456\u0431 \u0443 \u0441\u0442\u0430\u0437\u0438\u0441\u0456.\n\u0415\u043A\u0456\u043F\u0430\u0436:
        457 \u0444\u0430\u0445\u0456\u0432\u0446\u0456\u0432, \u0432\u043A\u043B\u044E\u0447\u043D\u043E
        \u0437 \u043E\u0444\u0456\u0446\u0435\u0440\u0430\u043C\u0438, \u0456\u043D\u0436\u0435\u043D\u0435\u0440\u0430\u043C\u0438
        \u0442\u0430 \u043C\u0435\u0434\u0438\u043A\u0430\u043C\u0438 \u2014 \u0442\u0430\u043A\u043E\u0436
        \u0443 \u043A\u0440\u0456\u043E\u0441\u043D\u0456.\n\u041E\u0444\u0456\u0446\u0456\u0439\u043D\u0430
        \u043C\u0435\u0442\u0430 \u043C\u0456\u0441\u0456\u0457 \u2014 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0443\u0432\u0430\u043D\u043D\u044F
        \u043A\u043E\u043B\u043E\u043D\u0456\u0441\u0442\u0456\u0432 \u043D\u0430
        \u043F\u043B\u0430\u043D\u0435\u0442\u0443 Eden-7, \u0440\u043E\u0437\u0442\u0430\u0448\u043E\u0432\u0430\u043D\u0443
        \u0437\u0430 27 \u0441\u0432\u0456\u0442\u043B\u043E\u0432\u0438\u0445 \u0440\u043E\u043A\u0456\u0432
        \u0432\u0456\u0434 \u0417\u0435\u043C\u043B\u0456.\n\u0423\u0441\u0456 \u043A\u0440\u0456\u043E\u043A\u0430\u043C\u0435\u0440\u0438
        \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u044E\u0442\u044C
        \u0443 \u0441\u0442\u0430\u0431\u0456\u043B\u044C\u043D\u043E\u043C\u0443
        \u0440\u0435\u0436\u0438\u043C\u0456. \u0410\u043A\u0442\u0438\u0432\u043D\u0456
        \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u0456 \u0430\u0434\u043C\u0456\u043D\u0456\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u0438
        \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u0456."
    - language: 28
      value: "A bordo da esta\xE7\xE3o intergal\xE1ctica \u201CAletheia\u201D encontram-se:\nColonistas:
        20 000 indiv\xEDduos em estase.\nTripula\xE7\xE3o: 457 especialistas, incluindo
        oficiais, engenheiros e m\xE9dicos \u2014 tamb\xE9m em criossuspens\xE3o.\nO
        objectivo oficial da miss\xE3o \xE9 o transporte dos colonistas para o planeta
        Eden-7, localizado a 27 anos-luz da Terra.\nTodas as c\xE2maras criog\xE9nicas
        est\xE3o a funcionar em condi\xE7\xF5es est\xE1veis. N\xE3o h\xE1 administradores
        de sistema activos presentes."
    - language: 34
      value: "A bordo de la estaci\xF3n intergal\xE1ctica \u201CAletheia\u201D se
        encuentran:\nColonistas: 20 000 individuos en estasis.\nTripulaci\xF3n: 457
        especialistas, incluidos oficiales, ingenieros y m\xE9dicos \u2014 tambi\xE9n
        en criosue\xF1o.\nEl objetivo oficial de la misi\xF3n es el transporte de
        los colonistas al planeta Eden-7, situado a 27 a\xF1os luz de la Tierra.\nTodas
        las c\xE1maras criog\xE9nicas funcionan en condiciones estables. No hay administradores
        de sistema activos presentes."
  - key: "Report 02 \u2014 Navigation Log"
    translations:
    - language: 10
      value: "Report 02 \u2014 Navigation Log"
    - language: 38
      value: "\u0417\u0432\u0456\u0442 02 \u2014 \u0416\u0443\u0440\u043D\u0430\u043B
        \u043D\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0457"
    - language: 28
      value: "Relat\xF3rio 02 \u2014 Registo de Navega\xE7\xE3o"
    - language: 34
      value: "Informe 02 \u2014 Registro de Navegaci\xF3n"
  - key: "The Aletheia station was launched with a projected flight duration of 96
      Earth years.\n According to archives, the navigation system stopped responding
      632 days ago.\nCurrent position: unknown.\nRemaining travel time: impossible
      to calculate.\n Black box records indicate a failure in the central navigation
      matrix.\n Recommended action: restart the system manually from the captain\u2019s
      bridge."
    translations:
    - language: 10
      value: "The Aletheia station was launched with a projected flight duration
        of 96 Earth years.\n According to archives, the navigation system stopped
        responding 632 days ago.\nCurrent position: unknown.\nRemaining travel time:
        impossible to calculate.\n Black box records indicate a failure in the central
        navigation matrix.\n Recommended action: restart the system manually from
        the captain\u2019s bridge."
    - language: 38
      value: "\u0421\u0442\u0430\u043D\u0446\u0456\u044E \xAB\u0410\u043B\u0435\u0442\u0435\u0439\u044F\xBB
        \u0431\u0443\u043B\u043E \u0437\u0430\u043F\u0443\u0449\u0435\u043D\u043E
        \u0437 \u0440\u043E\u0437\u0440\u0430\u0445\u0443\u043D\u043A\u043E\u0432\u043E\u044E
        \u0442\u0440\u0438\u0432\u0430\u043B\u0456\u0441\u0442\u044E \u043F\u043E\u043B\u044C\u043E\u0442\u0443
        96 \u0437\u0435\u043C\u043D\u0438\u0445 \u0440\u043E\u043A\u0456\u0432.\n\u0417\u0433\u0456\u0434\u043D\u043E
        \u0437 \u0430\u0440\u0445\u0456\u0432\u0430\u043C\u0438, \u043D\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0439\u043D\u0430
        \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043F\u0440\u0438\u043F\u0438\u043D\u0438\u043B\u0430
        \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0442\u0438 632 \u0434\u043D\u0456
        \u0442\u043E\u043C\u0443.\n\u041F\u043E\u0442\u043E\u0447\u043D\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044F:
        \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0435.\n\u0417\u0430\u043B\u0438\u0448\u043A\u043E\u0432\u0438\u0439
        \u0447\u0430\u0441 \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u0456: \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E
        \u043E\u0431\u0447\u0438\u0441\u043B\u0438\u0442\u0438.\n\u0417\u0430\u043F\u0438\u0441\u0438
        \xAB\u0447\u043E\u0440\u043D\u043E\u0457 \u0441\u043A\u0440\u0438\u043D\u044C\u043A\u0438\xBB
        \u0432\u043A\u0430\u0437\u0443\u044E\u0442\u044C \u043D\u0430 \u0437\u0431\u0456\u0439
        \u0443 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0456\u0439
        \u043D\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0439\u043D\u0456\u0439
        \u043C\u0430\u0442\u0440\u0438\u0446\u0456.\n\u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043D\u0430
        \u0434\u0456\u044F: \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0438
        \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0432\u0440\u0443\u0447\u043D\u0443
        \u0437 \u043A\u0430\u043F\u0456\u0442\u0430\u043D\u0441\u044C\u043A\u043E\u0433\u043E
        \u043C\u0456\u0441\u0442\u043A\u0430."
    - language: 28
      value: "A esta\xE7\xE3o Aletheia foi lan\xE7ada com uma dura\xE7\xE3o de voo
        projectada de 96 anos terrestres.\nDe acordo com os arquivos, o sistema de
        navega\xE7\xE3o deixou de responder h\xE1 632 dias.\nPosi\xE7\xE3o actual:
        desconhecida.\nTempo de viagem restante: imposs\xEDvel de calcular.\nOs registos
        da caixa negra indicam uma falha na matriz central de navega\xE7\xE3o.\nAc\xE7\xE3o
        recomendada: reiniciar o sistema manualmente a partir da ponte do capit\xE3o."
    - language: 34
      value: "La estaci\xF3n Aletheia fue lanzada con una duraci\xF3n de vuelo prevista
        de 96 a\xF1os terrestres.\nSeg\xFAn los archivos, el sistema de navegaci\xF3n
        dej\xF3 de responder hace 632 d\xEDas.\nPosici\xF3n actual: desconocida.\nTiempo
        de viaje restante: imposible de calcular.\nLos registros de la caja negra
        indican un fallo en la matriz central de navegaci\xF3n.\nAcci\xF3n recomendada:
        reiniciar el sistema manualmente desde el puente del capit\xE1n."
  - key: "Report 03 \u2014 Structural Pathways"
    translations:
    - language: 10
      value: "Report 03 \u2014 Structural Pathways"
    - language: 38
      value: "\u0417\u0432\u0456\u0442 03 \u2014 \u0421\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043D\u0456
        \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438"
    - language: 28
      value: "Relat\xF3rio 03 \u2014 Percursos Estruturais"
    - language: 34
      value: "Informe 03 \u2014 Rutas Estructurales"
  - key: "Shortest route to the captain\u2019s bridge:\nTechnical corridor, sector
      B-1.\nEnergy distribution hall.\nLaboratory Alpha.\nCentral gateway to the
      bridge.\nAccess to these sections is possible only through service robot authorization
      or an emergency override code."
    translations:
    - language: 10
      value: "Shortest route to the captain\u2019s bridge:\nTechnical corridor, sector
        B-1.\nEnergy distribution hall.\nLaboratory Alpha.\nCentral gateway to the
        bridge.\nAccess to these sections is possible only through service robot
        authorization or an emergency override code."
    - language: 38
      value: "\u041D\u0430\u0439\u043A\u043E\u0440\u043E\u0442\u0448\u0438\u0439
        \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0434\u043E \u043A\u0430\u043F\u0456\u0442\u0430\u043D\u0441\u044C\u043A\u043E\u0433\u043E
        \u043C\u0456\u0441\u0442\u043A\u0430:\n\u0422\u0435\u0445\u043D\u0456\u0447\u043D\u0438\u0439
        \u043A\u043E\u0440\u0438\u0434\u043E\u0440, \u0441\u0435\u043A\u0442\u043E\u0440
        B-1.\n\u0417\u0430\u043B\u0430 \u0440\u043E\u0437\u043F\u043E\u0434\u0456\u043B\u0443
        \u0435\u043D\u0435\u0440\u0433\u0456\u0457.\n\u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0456\u044F
        \u0410\u043B\u044C\u0444\u0430.\n\u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0456
        \u0432\u043E\u0440\u043E\u0442\u0430 \u0434\u043E \u043C\u0456\u0441\u0442\u043A\u0430.\n\u0414\u043E\u0441\u0442\u0443\u043F
        \u0434\u043E \u0446\u0438\u0445 \u0441\u0435\u043A\u0446\u0456\u0439 \u043C\u043E\u0436\u043B\u0438\u0432\u0438\u0439
        \u043B\u0438\u0448\u0435 \u0437\u0430 \u0430\u0432\u0442\u043E\u0440\u0438\u0437\u0430\u0446\u0456\u0454\u044E
        \u0441\u0435\u0440\u0432\u0456\u0441\u043D\u043E\u0433\u043E \u0440\u043E\u0431\u043E\u0442\u0430
        \u0430\u0431\u043E \u0447\u0435\u0440\u0435\u0437 \u0430\u0432\u0430\u0440\u0456\u0439\u043D\u0438\u0439
        \u043A\u043E\u0434 \u043F\u0435\u0440\u0435\u0432\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F."
    - language: 28
      value: "Percurso mais curto at\xE9 \xE0 ponte do capit\xE3o:\nCorredor t\xE9cnico,
        sector B-1.\nSala de distribui\xE7\xE3o de energia.\nLaborat\xF3rio Alfa.\nPorta
        central para a ponte.\nO acesso a estas sec\xE7\xF5es \xE9 poss\xEDvel apenas
        mediante autoriza\xE7\xE3o do rob\xF4 de servi\xE7o ou atrav\xE9s de um c\xF3digo
        de sobreposi\xE7\xE3o de emerg\xEAncia."
    - language: 34
      value: "Ruta m\xE1s corta hasta el puente del capit\xE1n:\nCorredor t\xE9cnico,
        sector B-1.\nSala de distribuci\xF3n de energ\xEDa.\nLaboratorio Alfa.\nPuerta
        central hacia el puente.\nEl acceso a estas secciones es posible \xFAnicamente
        mediante autorizaci\xF3n del robot de servicio o mediante un c\xF3digo de
        anulaci\xF3n de emergencia."
  - key: "Report 04 \u2014 System Integrity"
    translations:
    - language: 10
      value: "Report 04 \u2014 System Integrity"
    - language: 38
      value: "\u0417\u0432\u0456\u0442 04 \u2014 \u0426\u0456\u043B\u0456\u0441\u043D\u0456\u0441\u0442\u044C
        \u0441\u0438\u0441\u0442\u0435\u043C\u0438"
    - language: 28
      value: "Relat\xF3rio 04 \u2014 Integridade do Sistema"
    - language: 34
      value: "Informe 04 \u2014 Integridad del Sistema"
  - key: "Power supply: stable, operating on reserve circuits.\nCryostasis: maintained
      automatically, no failures detected.\nLife support: parameters nominal, atmospheric
      regulators functional.\nNavigation: offline.\n Conclusion: the station is moving,
      but its vector of travel is unknown.\n Passengers and crew remain unaware of
      the situation."
    translations:
    - language: 10
      value: "Power supply: stable, operating on reserve circuits.\nCryostasis: maintained
        automatically, no failures detected.\nLife support: parameters nominal, atmospheric
        regulators functional.\nNavigation: offline.\n Conclusion: the station is
        moving, but its vector of travel is unknown.\n Passengers and crew remain
        unaware of the situation."
    - language: 38
      value: "\n\u0416\u0438\u0432\u043B\u0435\u043D\u043D\u044F: \u0441\u0442\u0430\u0431\u0456\u043B\u044C\u043D\u0435,
        \u043F\u0440\u0430\u0446\u044E\u0454 \u043D\u0430 \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u0438\u0445
        \u043A\u043E\u043D\u0442\u0443\u0440\u0430\u0445.\n\u041A\u0440\u0456\u043E\u0441\u0442\u0430\u0437:
        \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0443\u0454\u0442\u044C\u0441\u044F
        \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E, \u0437\u0431\u043E\u0457\u0432
        \u043D\u0435 \u0432\u0438\u044F\u0432\u043B\u0435\u043D\u043E.\n\u0416\u0438\u0442\u0442\u0454\u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0435\u043D\u043D\u044F:
        \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438 \u0432 \u043D\u043E\u0440\u043C\u0456,
        \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u043D\u0456 \u0440\u0435\u0433\u0443\u043B\u044F\u0442\u043E\u0440\u0438
        \u0444\u0443\u043D\u043A\u0446\u0456\u043E\u043D\u0443\u044E\u0442\u044C.\n\u041D\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u044F:
        \u043E\u0444\u043B\u0430\u0439\u043D.\n\u0412\u0438\u0441\u043D\u043E\u0432\u043E\u043A:
        \u0441\u0442\u0430\u043D\u0446\u0456\u044F \u0440\u0443\u0445\u0430\u0454\u0442\u044C\u0441\u044F,
        \u0430\u043B\u0435 \u0432\u0435\u043A\u0442\u043E\u0440 \u0457\u0457 \u0440\u0443\u0445\u0443
        \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0438\u0439.\n\u041F\u0430\u0441\u0430\u0436\u0438\u0440\u0438
        \u0442\u0430 \u0435\u043A\u0456\u043F\u0430\u0436 \u0437\u0430\u043B\u0438\u0448\u0430\u044E\u0442\u044C\u0441\u044F
        \u043D\u0435 \u043E\u0431\u0456\u0437\u043D\u0430\u043D\u0438\u043C\u0438
        \u043F\u0440\u043E \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044E."
    - language: 28
      value: "\nAlimenta\xE7\xE3o: est\xE1vel, a funcionar em circuitos de reserva.\nCriostase:
        mantida automaticamente, n\xE3o foram detectadas falhas.\nSuporte de vida:
        par\xE2metros nominais, reguladores atmosf\xE9ricos funcionais.\nNavega\xE7\xE3o:
        offline.\nConclus\xE3o: a esta\xE7\xE3o est\xE1 em movimento, mas o seu vector
        de trajecto \xE9 desconhecido.\nPassageiros e tripula\xE7\xE3o permanecem
        inconscientes da situa\xE7\xE3o."
    - language: 34
      value: "\nSuministro el\xE9ctrico: estable, operando en circuitos de reserva.\nCriostasis:
        mantenida autom\xE1ticamente, no se detectan fallos.\nSoporte vital: par\xE1metros
        nominales, reguladores atmosf\xE9ricos funcionales.\nNavegaci\xF3n: fuera
        de l\xEDnea.\nConclusi\xF3n: la estaci\xF3n se est\xE1 moviendo, pero su
        vector de trayectoria es desconocido.\nPasajeros y tripulaci\xF3n permanecen
        ajenos a la situaci\xF3n."
  - key: "Report 05 \u2014 AI Core Access"
    translations:
    - language: 10
      value: "Report 05 \u2014 AI Core Access"
    - language: 38
      value: "\u0417\u0432\u0456\u0442 05 \u2014 \u0414\u043E\u0441\u0442\u0443\u043F
        \u0434\u043E \u044F\u0434\u0440\u0430 \u0428\u0406"
    - language: 28
      value: "Relat\xF3rio 05 \u2014 Acesso ao N\xFAcleo de IA"
    - language: 34
      value: "Informe 05 \u2014 Acceso al N\xFAcleo de IA"
  - key: "After activation of the service robot, partial access to the station\u2019s
      memory was obtained.\nColonist logs: locked.\nNavigation logs: error, archive
      corrupted.\nInternal route maps: accessible.\nVoice interface activated: the
      robot can accompany the colonist and record actions into the log."
    translations:
    - language: 10
      value: "After activation of the service robot, partial access to the station\u2019s
        memory was obtained.\nColonist logs: locked.\nNavigation logs: error, archive
        corrupted.\nInternal route maps: accessible.\nVoice interface activated:
        the robot can accompany the colonist and record actions into the log."
    - language: 38
      value: "\u041F\u0456\u0441\u043B\u044F \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0456\u0457
        \u0441\u0435\u0440\u0432\u0456\u0441\u043D\u043E\u0433\u043E \u0440\u043E\u0431\u043E\u0442\u0430
        \u0431\u0443\u043B\u043E \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043E
        \u0447\u0430\u0441\u0442\u043A\u043E\u0432\u0438\u0439 \u0434\u043E\u0441\u0442\u0443\u043F
        \u0434\u043E \u043F\u0430\u043C\u2019\u044F\u0442\u0456 \u0441\u0442\u0430\u043D\u0446\u0456\u0457.\n\u0416\u0443\u0440\u043D\u0430\u043B\u0438
        \u043A\u043E\u043B\u043E\u043D\u0456\u0441\u0442\u0456\u0432: \u0437\u0430\u0431\u043B\u043E\u043A\u043E\u0432\u0430\u043D\u043E.\n\u041D\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0439\u043D\u0456
        \u0436\u0443\u0440\u043D\u0430\u043B\u0438: \u043F\u043E\u043C\u0438\u043B\u043A\u0430,
        \u0430\u0440\u0445\u0456\u0432 \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043E.\n\u0412\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u0456
        \u043A\u0430\u0440\u0442\u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0456\u0432:
        \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456.\n\u0413\u043E\u043B\u043E\u0441\u043E\u0432\u0438\u0439
        \u0456\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u0430\u043A\u0442\u0438\u0432\u043E\u0432\u0430\u043D\u043E:
        \u0440\u043E\u0431\u043E\u0442 \u043C\u043E\u0436\u0435 \u0441\u0443\u043F\u0440\u043E\u0432\u043E\u0434\u0436\u0443\u0432\u0430\u0442\u0438
        \u043A\u043E\u043B\u043E\u043D\u0456\u0441\u0442\u0430 \u0442\u0430 \u0437\u0430\u043F\u0438\u0441\u0443\u0432\u0430\u0442\u0438
        \u0434\u0456\u0457 \u0432 \u0436\u0443\u0440\u043D\u0430\u043B."
    - language: 28
      value: "Ap\xF3s a activa\xE7\xE3o do rob\xF4 de servi\xE7o, foi obtido acesso
        parcial \xE0 mem\xF3ria da esta\xE7\xE3o.\nRegistos dos colonistas: bloqueados.\nRegistos
        de navega\xE7\xE3o: erro, arquivo corrompido.\nMapas internos de rotas: acess\xEDveis.\nInterface
        de voz activada: o rob\xF4 pode acompanhar o colonista e registar as ac\xE7\xF5es
        no di\xE1rio."
    - language: 34
      value: "Tras la activaci\xF3n del robot de servicio, se obtuvo acceso parcial
        a la memoria de la estaci\xF3n.\nRegistros de colonistas: bloqueados.\nRegistros
        de navegaci\xF3n: error, archivo da\xF1ado.\nMapas internos de rutas: accesibles.\nInterfaz
        de voz activada: el robot puede acompa\xF1ar al colonista y registrar acciones
        en el registro."
  - key: "Report 06 \u2014 Security Anomalies"
    translations:
    - language: 10
      value: "Report 06 \u2014 Security Anomalies"
    - language: 38
      value: "\u0417\u0432\u0456\u0442 06 \u2014 \u0410\u043D\u043E\u043C\u0430\u043B\u0456\u0457
        \u0431\u0435\u0437\u043F\u0435\u043A\u0438"
    - language: 28
      value: "Relat\xF3rio 06 \u2014 Anomalias de Seguran\xE7a"
    - language: 34
      value: "Informe 06 \u2014 Anomal\xEDas de Seguridad"
  - key: "Recent system scans revealed irregularities in access protocols:\nFour
      bulkhead doors remain sealed despite no damage or system fault.\nSecurity logs
      show manual overrides registered 11 days after the navigation system failure.\nAttempts
      to open the doors via emergency codes have been unsuccessful.\n No record exists
      of which crew member initiated the overrides.\n Conclusion: sections of the
      station may have been deliberately locked down."
    translations:
    - language: 10
      value: "Recent system scans revealed irregularities in access protocols:\nFour
        bulkhead doors remain sealed despite no damage or system fault.\nSecurity
        logs show manual overrides registered 11 days after the navigation system
        failure.\nAttempts to open the doors via emergency codes have been unsuccessful.\n
        No record exists of which crew member initiated the overrides.\n Conclusion:
        sections of the station may have been deliberately locked down."
    - language: 38
      value: "\u041E\u0441\u0442\u0430\u043D\u043D\u0456 \u0441\u043A\u0430\u043D\u0443\u0432\u0430\u043D\u043D\u044F
        \u0441\u0438\u0441\u0442\u0435\u043C\u0438 \u0432\u0438\u044F\u0432\u0438\u043B\u0438
        \u043F\u043E\u0440\u0443\u0448\u0435\u043D\u043D\u044F \u0432 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0430\u0445
        \u0434\u043E\u0441\u0442\u0443\u043F\u0443:\n\u0427\u043E\u0442\u0438\u0440\u0438
        \u0433\u0435\u0440\u043C\u043E\u0434\u0432\u0435\u0440\u0456 \u0437\u0430\u043B\u0438\u0448\u0430\u044E\u0442\u044C\u0441\u044F
        \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u0438\u043C\u0438,
        \u043F\u043E\u043F\u0440\u0438 \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C
        \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u044C \u0447\u0438
        \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u0438\u0445 \u0437\u0431\u043E\u0457\u0432.\n\u0416\u0443\u0440\u043D\u0430\u043B\u0438
        \u0431\u0435\u0437\u043F\u0435\u043A\u0438 \u043F\u043E\u043A\u0430\u0437\u0443\u044E\u0442\u044C
        \u0440\u0443\u0447\u043D\u0456 \u043F\u0435\u0440\u0435\u0432\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F,
        \u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u043E\u0432\u0430\u043D\u0456
        \u0447\u0435\u0440\u0435\u0437 11 \u0434\u043D\u0456\u0432 \u043F\u0456\u0441\u043B\u044F
        \u0432\u0456\u0434\u043C\u043E\u0432\u0438 \u043D\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0439\u043D\u043E\u0457
        \u0441\u0438\u0441\u0442\u0435\u043C\u0438.\n\u0421\u043F\u0440\u043E\u0431\u0438
        \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u0434\u0432\u0435\u0440\u0456
        \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0430\u0432\u0430\u0440\u0456\u0439\u043D\u0438\u0445
        \u043A\u043E\u0434\u0456\u0432 \u0431\u0443\u043B\u0438 \u0431\u0435\u0437\u0443\u0441\u043F\u0456\u0448\u043D\u0438\u043C\u0438.\n\u041D\u0435\u043C\u0430\u0454
        \u0437\u0430\u043F\u0438\u0441\u0456\u0432 \u043F\u0440\u043E \u0442\u0435,
        \u044F\u043A\u0438\u0439 \u0447\u043B\u0435\u043D \u0435\u043A\u0456\u043F\u0430\u0436\u0443
        \u0456\u043D\u0456\u0446\u0456\u044E\u0432\u0430\u0432 \u043F\u0435\u0440\u0435\u0432\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F.\n\u0412\u0438\u0441\u043D\u043E\u0432\u043E\u043A:
        \u0447\u0430\u0441\u0442\u0438\u043D\u0438 \u0441\u0442\u0430\u043D\u0446\u0456\u0457
        \u043C\u043E\u0433\u043B\u0438 \u0431\u0443\u0442\u0438 \u043D\u0430\u0432\u043C\u0438\u0441\u043D\u043E
        \u0437\u0430\u0431\u043B\u043E\u043A\u043E\u0432\u0430\u043D\u0456."
    - language: 28
      value: "As an\xE1lises recentes do sistema revelaram irregularidades nos protocolos
        de acesso:\nQuatro portas estanques permanecem seladas apesar de n\xE3o haver
        danos ou falhas de sistema.\nOs registos de seguran\xE7a mostram sobreposi\xE7\xF5es
        manuais registadas 11 dias ap\xF3s a falha do sistema de navega\xE7\xE3o.\nAs
        tentativas de abrir as portas atrav\xE9s de c\xF3digos de emerg\xEAncia n\xE3o
        tiveram sucesso.\nN\xE3o existe registo de qual membro da tripula\xE7\xE3o
        iniciou as sobreposi\xE7\xF5es.\nConclus\xE3o: sec\xE7\xF5es da esta\xE7\xE3o
        podem ter sido deliberadamente bloqueadas."
    - language: 34
      value: "Los escaneos recientes del sistema revelaron irregularidades en los
        protocolos de acceso:\nCuatro compuertas permanecen selladas a pesar de no
        existir da\xF1os ni fallos del sistema.\nLos registros de seguridad muestran
        anulaciones manuales registradas 11 d\xEDas despu\xE9s del fallo del sistema
        de navegaci\xF3n.\nLos intentos de abrir las puertas mediante c\xF3digos
        de emergencia no tuvieron \xE9xito.\nNo existe registro de qu\xE9 miembro
        de la tripulaci\xF3n inici\xF3 las anulaciones.\nConclusi\xF3n: secciones
        de la estaci\xF3n pudieron haber sido bloqueadas deliberadamente."
  - key: "Report 07 \u2014 Communication Records"
    translations:
    - language: 10
      value: "Report 07 \u2014 Communication Records"
    - language: 38
      value: "\u0417\u0432\u0456\u0442 07 \u2014 \u0417\u0430\u043F\u0438\u0441\u0438
        \u0437\u0432\u2019\u044F\u0437\u043A\u0443"
    - language: 28
      value: "Relat\xF3rio 07 \u2014 Registos de Comunica\xE7\xF5es"
    - language: 34
      value: "Informe 07 \u2014 Registros de Comunicaciones"
  - key: "Long-range transmitters are operational, yet all outgoing channels are
      muted.\nLast successful transmission: 2.4 years ago to Earth Mission Command.\nIncoming
      messages: corrupted or erased.\nAutomated beacon: disabled manually from the
      comms core.\n There is no explanation in mission protocols for disabling the
      beacon.\n Recommendation: restore access from the communications array on Deck
      C.\nRisk: unknown interference or intentional suppression of contact."
    translations:
    - language: 10
      value: "Long-range transmitters are operational, yet all outgoing channels
        are muted.\nLast successful transmission: 2.4 years ago to Earth Mission
        Command.\nIncoming messages: corrupted or erased.\nAutomated beacon: disabled
        manually from the comms core.\n There is no explanation in mission protocols
        for disabling the beacon.\n Recommendation: restore access from the communications
        array on Deck C.\nRisk: unknown interference or intentional suppression of
        contact."
    - language: 38
      value: "\u0414\u0430\u043B\u0435\u043A\u043E\u0434\u0456\u044E\u0447\u0456
        \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0447\u0456 \u043F\u0440\u0430\u0446\u0435\u0437\u0434\u0430\u0442\u043D\u0456,
        \u043E\u0434\u043D\u0430\u043A \u0443\u0441\u0456 \u0432\u0438\u0445\u0456\u0434\u043D\u0456
        \u043A\u0430\u043D\u0430\u043B\u0438 \u0437\u0430\u0433\u043B\u0443\u0448\u0435\u043D\u0456.\n\u041E\u0441\u0442\u0430\u043D\u043D\u044F
        \u0443\u0441\u043F\u0456\u0448\u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0430:
        2,4 \u0440\u043E\u043A\u0443 \u0442\u043E\u043C\u0443 \u0434\u043E \u041A\u043E\u043C\u0430\u043D\u0434\u0443\u0432\u0430\u043D\u043D\u044F
        \u043C\u0456\u0441\u0456\u0457 \u043D\u0430 \u0417\u0435\u043C\u043B\u0456.\n\u0412\u0445\u0456\u0434\u043D\u0456
        \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F:
        \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u0456 \u0430\u0431\u043E
        \u0441\u0442\u0435\u0440\u0442\u0456.\n\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u0438\u0439
        \u043C\u0430\u044F\u043A: \u0432\u0438\u043C\u043A\u043D\u0435\u043D\u043E
        \u0432\u0440\u0443\u0447\u043D\u0443 \u0437 \u043A\u043E\u043C\u0443\u043D\u0456\u043A\u0430\u0446\u0456\u0439\u043D\u043E\u0433\u043E
        \u044F\u0434\u0440\u0430.\n\u0423 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0430\u0445
        \u043C\u0456\u0441\u0456\u0457 \u043D\u0435\u043C\u0430\u0454 \u043F\u043E\u044F\u0441\u043D\u0435\u043D\u044C
        \u0449\u043E\u0434\u043E \u0432\u0438\u043C\u043A\u043D\u0435\u043D\u043D\u044F
        \u043C\u0430\u044F\u043A\u0430.\n\u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0456\u044F:
        \u0432\u0456\u0434\u043D\u043E\u0432\u0438\u0442\u0438 \u0434\u043E\u0441\u0442\u0443\u043F
        \u0437 \u043A\u043E\u043C\u0443\u043D\u0456\u043A\u0430\u0446\u0456\u0439\u043D\u043E\u0433\u043E
        \u043C\u0430\u0441\u0438\u0432\u0443 \u043D\u0430 \u043F\u0430\u043B\u0443\u0431\u0456
        C.\n\u0420\u0438\u0437\u0438\u043A: \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0456
        \u043F\u0435\u0440\u0435\u0448\u043A\u043E\u0434\u0438 \u0430\u0431\u043E
        \u043D\u0430\u0432\u043C\u0438\u0441\u043D\u0435 \u043F\u0440\u0438\u0434\u0443\u0448\u0435\u043D\u043D\u044F
        \u0437\u0432\u2019\u044F\u0437\u043A\u0443."
    - language: 28
      value: "Os transmissores de longo alcance est\xE3o operacionais, mas todos
        os canais de sa\xEDda est\xE3o silenciados.\n\xDAltima transmiss\xE3o bem-sucedida:
        h\xE1 2,4 anos para o Comando da Miss\xE3o na Terra.\nMensagens recebidas:
        corrompidas ou apagadas.\nBaliza autom\xE1tica: desactivada manualmente a
        partir do n\xFAcleo de comunica\xE7\xF5es.\nN\xE3o existe explica\xE7\xE3o
        nos protocolos da miss\xE3o para a desactiva\xE7\xE3o da baliza.\nRecomenda\xE7\xE3o:
        restaurar o acesso a partir do conjunto de comunica\xE7\xF5es no Conv\xE9s
        C.\nRisco: interfer\xEAncia desconhecida ou supress\xE3o intencional do contacto."
    - language: 34
      value: "Los transmisores de largo alcance est\xE1n operativos, pero todos los
        canales de salida est\xE1n silenciados.\n\xDAltima transmisi\xF3n exitosa:
        hace 2,4 a\xF1os al Comando de la Misi\xF3n en la Tierra.\nMensajes entrantes:
        corruptos o borrados.\nBaliza autom\xE1tica: desactivada manualmente desde
        el n\xFAcleo de comunicaciones.\nNo existe explicaci\xF3n en los protocolos
        de la misi\xF3n para la desactivaci\xF3n de la baliza.\nRecomendaci\xF3n:
        restaurar el acceso desde el conjunto de comunicaciones en la Cubierta C.\nRiesgo:
        interferencia desconocida o supresi\xF3n intencional del contacto."
  - key: "Report 08 \u2014 Crew Activity Log"
    translations:
    - language: 10
      value: "Report 08 \u2014 Crew Activity Log"
    - language: 38
      value: "\u0417\u0432\u0456\u0442 08 \u2014 \u0416\u0443\u0440\u043D\u0430\u043B
        \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0456 \u0435\u043A\u0456\u043F\u0430\u0436\u0443"
    - language: 28
      value: "Relat\xF3rio 08 \u2014 Registo de Actividade da Tripula\xE7\xE3o"
    - language: 34
      value: "Informe 08 \u2014 Registro de Actividad de la Tripulaci\xF3n"
  - key: "Cross-referencing cryostasis monitoring with station logs shows discrepancies:\n457
      official crew entries.\nCryostasis scan detects 454 active pods.\n Three pods
      are missing from the registry.\n No matching entries were found in medical
      archives or system deletion logs.\n Status of the missing crew members: unknown.\n
      Advisory: Proceed with caution. Further anomalies may indicate human interference,
      not system error."
    translations:
    - language: 10
      value: "Cross-referencing cryostasis monitoring with station logs shows discrepancies:\n457
        official crew entries.\nCryostasis scan detects 454 active pods.\n Three
        pods are missing from the registry.\n No matching entries were found in medical
        archives or system deletion logs.\n Status of the missing crew members: unknown.\n
        Advisory: Proceed with caution. Further anomalies may indicate human interference,
        not system error."
    - language: 38
      value: "\u041F\u0435\u0440\u0435\u0445\u0440\u0435\u0441\u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0430
        \u043C\u043E\u043D\u0456\u0442\u043E\u0440\u0438\u043D\u0433\u0443 \u043A\u0440\u0456\u043E\u0441\u0442\u0430\u0437\u0443
        \u0437 \u0436\u0443\u0440\u043D\u0430\u043B\u0430\u043C\u0438 \u0441\u0442\u0430\u043D\u0446\u0456\u0457
        \u0432\u0438\u044F\u0432\u0438\u043B\u0430 \u0440\u043E\u0437\u0431\u0456\u0436\u043D\u043E\u0441\u0442\u0456:\n457
        \u043E\u0444\u0456\u0446\u0456\u0439\u043D\u0438\u0445 \u0437\u0430\u043F\u0438\u0441\u0456\u0432
        \u0435\u043A\u0456\u043F\u0430\u0436\u0443.\n\u0421\u043A\u0430\u043D\u0443\u0432\u0430\u043D\u043D\u044F
        \u043A\u0440\u0456\u043E\u0441\u0442\u0430\u0437\u0443 \u0432\u0438\u044F\u0432\u043B\u044F\u0454
        454 \u0430\u043A\u0442\u0438\u0432\u043D\u0456 \u043A\u0430\u043F\u0441\u0443\u043B\u0438.\n\u0422\u0440\u0438
        \u043A\u0430\u043F\u0441\u0443\u043B\u0438 \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u0456
        \u0432 \u0440\u0435\u0454\u0441\u0442\u0440\u0456.\n\u0423 \u043C\u0435\u0434\u0438\u0447\u043D\u0438\u0445
        \u0430\u0440\u0445\u0456\u0432\u0430\u0445 \u0430\u0431\u043E \u0436\u0443\u0440\u043D\u0430\u043B\u0430\u0445
        \u0432\u0438\u0434\u0430\u043B\u0435\u043D\u043D\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0438
        \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0438\u0445 \u0437\u0430\u043F\u0438\u0441\u0456\u0432
        \u043D\u0435 \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u043E.\n\u0421\u0442\u0430\u0442\u0443\u0441
        \u0437\u043D\u0438\u043A\u043B\u0438\u0445 \u0447\u043B\u0435\u043D\u0456\u0432
        \u0435\u043A\u0456\u043F\u0430\u0436\u0443: \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0438\u0439.\n\u041F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0435\u043D\u043D\u044F:
        \u0434\u0456\u0439\u0442\u0435 \u0437 \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u0456\u0441\u0442\u044E.
        \u041F\u043E\u0434\u0430\u043B\u044C\u0448\u0456 \u0430\u043D\u043E\u043C\u0430\u043B\u0456\u0457
        \u043C\u043E\u0436\u0443\u0442\u044C \u0441\u0432\u0456\u0434\u0447\u0438\u0442\u0438
        \u043F\u0440\u043E \u043B\u044E\u0434\u0441\u044C\u043A\u0435 \u0432\u0442\u0440\u0443\u0447\u0430\u043D\u043D\u044F,
        \u0430 \u043D\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u0443 \u043F\u043E\u043C\u0438\u043B\u043A\u0443."
    - language: 28
      value: "A verifica\xE7\xE3o cruzada da monitoriza\xE7\xE3o de criostase com
        os registos da esta\xE7\xE3o mostra discrep\xE2ncias:\n457 entradas oficiais
        de tripula\xE7\xE3o.\nA varredura de criostase detecta 454 c\xE1psulas activas.\nTr\xEAs
        c\xE1psulas est\xE3o em falta no registo.\nN\xE3o foram encontradas entradas
        correspondentes nos arquivos m\xE9dicos ou nos registos de elimina\xE7\xE3o
        do sistema.\nEstado dos membros da tripula\xE7\xE3o em falta: desconhecido.\nAviso:
        proceder com cautela. Anomalias adicionais podem indicar interfer\xEAncia
        humana, n\xE3o erro do sistema."
    - language: 34
      value: "La comprobaci\xF3n cruzada del monitoreo de criostasis con los registros
        de la estaci\xF3n muestra discrepancias:\n457 entradas oficiales de tripulaci\xF3n.\nEl
        escaneo de criostasis detecta 454 c\xE1psulas activas.\nFaltan tres c\xE1psulas
        en el registro.\nNo se encontraron entradas coincidentes en los archivos
        m\xE9dicos ni en los registros de eliminaci\xF3n del sistema.\nEstado de
        los miembros de la tripulaci\xF3n desaparecidos: desconocido.\nAviso: proceda
        con cautela. Anomal\xEDas adicionales pueden indicar interferencia humana,
        no error del sistema."
  - key: Report number 2564
    translations:
    - language: 10
      value: Report number 2564
    - language: 38
      value: "\u0417\u0432\u0456\u0442 \u2116 2564"
    - language: 28
      value: "Relat\xF3rio n\xBA 2564"
    - language: 34
      value: "Informe n\xBA 2564"
  - key: 'Date: 20.07.2239

      Engineer: A. Royce

      Before flying to the
      Sector G area, I made a final check of the cryopreservation locking systems.

      Condition
      of the chambers: stable. Temperature maintenance - within normal limits. The
      part of the code to the cryostorage door, set according to the protocol before
      departure - 24.

      The other values are available only to the mission commander
      and are stored in the encrypted section of the core.I recommend to additionally
      double-check the synchronization of the lock timer with the main system time
      of the station.

      End of record'
    translations:
    - language: 10
      value: 'Date: 20.07.2239

        Engineer: A. Royce

        Before flying
        to the Sector G area, I made a final check of the cryopreservation locking
        systems.

        Condition of the chambers: stable. Temperature maintenance
        - within normal limits. The part of the code to the cryostorage door, set
        according to the protocol before departure - 24.

        The other values
        are available only to the mission commander and are stored in the encrypted
        section of the core.I recommend to additionally double-check the synchronization
        of the lock timer with the main system time of the station.

        End
        of record'
    - language: 38
      value: "\u0414\u0430\u0442\u0430: 20.07.2239\n\u0406\u043D\u0436\u0435\u043D\u0435\u0440:
        A. Royce\n\u041F\u0435\u0440\u0435\u0434 \u0432\u0438\u043B\u044C\u043E\u0442\u043E\u043C
        \u0434\u043E \u0441\u0435\u043A\u0442\u043E\u0440\u0430 G \u044F \u0437\u0434\u0456\u0439\u0441\u043D\u0438\u0432
        \u0444\u0456\u043D\u0430\u043B\u044C\u043D\u0443 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0443
        \u0441\u0438\u0441\u0442\u0435\u043C \u0431\u043B\u043E\u043A\u0443\u0432\u0430\u043D\u043D\u044F
        \u043A\u0440\u0456\u043E\u043A\u043E\u043D\u0441\u0435\u0440\u0432\u0430\u0446\u0456\u0457.\n\u0421\u0442\u0430\u043D
        \u043A\u0430\u043C\u0435\u0440: \u0441\u0442\u0430\u0431\u0456\u043B\u044C\u043D\u0438\u0439.
        \u041F\u0456\u0434\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0438
        \u2014 \u0432 \u043C\u0435\u0436\u0430\u0445 \u043D\u043E\u0440\u043C\u0438.
        \u0427\u0430\u0441\u0442\u0438\u043D\u0430 \u043A\u043E\u0434\u0443 \u0434\u043E
        \u0434\u0432\u0435\u0440\u0435\u0439 \u043A\u0440\u0456\u043E\u0441\u0445\u043E\u0432\u0438\u0449\u0430,
        \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430 \u0437\u0433\u0456\u0434\u043D\u043E
        \u0437 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u043E\u043C \u043F\u0435\u0440\u0435\u0434
        \u0432\u0456\u0434\u043B\u044C\u043E\u0442\u043E\u043C \u2014 24.\n\u0406\u043D\u0448\u0456
        \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456
        \u043B\u0438\u0448\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0443
        \u043C\u0456\u0441\u0456\u0457 \u0442\u0430 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044E\u0442\u044C\u0441\u044F
        \u0432 \u0437\u0430\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u043E\u043C\u0443
        \u0440\u043E\u0437\u0434\u0456\u043B\u0456 \u044F\u0434\u0440\u0430. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u044E
        \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u043E \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438
        \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0456\u0437\u0430\u0446\u0456\u044E
        \u0442\u0430\u0439\u043C\u0435\u0440\u0430 \u0437\u0430\u043C\u043A\u0430
        \u0437 \u043E\u0441\u043D\u043E\u0432\u043D\u0438\u043C \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u0438\u043C
        \u0447\u0430\u0441\u043E\u043C \u0441\u0442\u0430\u043D\u0446\u0456\u0457.\n\u041A\u0456\u043D\u0435\u0446\u044C
        \u0437\u0430\u043F\u0438\u0441\u0443"
    - language: 28
      value: "Data: 20.07.2239\nEngenheiro: A. Royce\nAntes de voar para a \xE1rea
        do Sector G, realizei uma verifica\xE7\xE3o final dos sistemas de bloqueio
        de criopreserva\xE7\xE3o.\nEstado das c\xE2maras: est\xE1vel. Manuten\xE7\xE3o
        da temperatura \u2014 dentro dos limites normais. A parte do c\xF3digo da
        porta do criodep\xF3sito, definida de acordo com o protocolo antes da partida
        \u2014 24.\nOs outros valores est\xE3o dispon\xEDveis apenas para o comandante
        da miss\xE3o e s\xE3o armazenados na sec\xE7\xE3o encriptada do n\xFAcleo.
        Recomendo verificar adicionalmente a sincroniza\xE7\xE3o do temporizador
        da fechadura com a hora principal do sistema da esta\xE7\xE3o.\nFim do registo"
    - language: 34
      value: "Fecha: 20.07.2239\nIngeniero: A. Royce\nAntes de volar al \xE1rea del
        Sector G, realic\xE9 una comprobaci\xF3n final de los sistemas de bloqueo
        de criopreservaci\xF3n.\nEstado de las c\xE1maras: estable. Mantenimiento
        de la temperatura \u2014 dentro de los l\xEDmites normales. La parte del
        c\xF3digo de la puerta del criodep\xF3sito, establecida seg\xFAn el protocolo
        antes de la partida \u2014 24.\nLos dem\xE1s valores est\xE1n disponibles
        \xFAnicamente para el comandante de la misi\xF3n y se almacenan en la secci\xF3n
        cifrada del n\xFAcleo. Recomiendo comprobar adicionalmente la sincronizaci\xF3n
        del temporizador de la cerradura con la hora principal del sistema de la
        estaci\xF3n.\nFin del registro"
  - key: Report number 7823
    translations:
    - language: 10
      value: Report number 7823
    - language: 38
      value: "\u0417\u0432\u0456\u0442 \u2116 7823"
    - language: 28
      value: "Relat\xF3rio n\xBA 7823"
    - language: 34
      value: "Informe n\xBA 7823"
  - key: "Date: 07/18/2239\nEngineer: M. McGermick \nToday conducted\nan inventory
      of essential supplies prior to launching the backup power scenario. Checked
      three types of resources:\nOxygen cylinders - 10 pcs.\nFuel cells - 2 times
      as many cylinders\nRepair kits - equal to the sum of cylinders and cells\nEverything
      is within normal limits, no leaks or failures recorded.\nBy the way, the second
      part of the access code to the lock of the cryostorage compartment coincides
      with the total amount of resources (60).\nThe first part, as usual, is stored in
      the encrypted memory of the command module.\nEnd of record"
    translations:
    - language: 10
      value: "Date: 07/18/2239\nEngineer: M. McGermick \nToday conducted\nan inventory
        of essential supplies prior to launching the backup power scenario. Checked
        three types of resources:\nOxygen cylinders - 10 pcs.\nFuel cells - 2 times
        as many cylinders\nRepair kits - equal to the sum of cylinders and cells\nEverything
        is within normal limits, no leaks or failures recorded.\nBy the way, the
        second part of the access code to the lock of the cryostorage compartment
        coincides with the total amount of resources (60).\nThe first part, as usual, is
        stored in the encrypted memory of the command module.\nEnd of record"
    - language: 38
      value: "\u0414\u0430\u0442\u0430: 18.07.2239\n\u0406\u043D\u0436\u0435\u043D\u0435\u0440:
        M. McGermick\n\u0421\u044C\u043E\u0433\u043E\u0434\u043D\u0456 \u0431\u0443\u043B\u043E
        \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u043E\n\u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0438\u0437\u0430\u0446\u0456\u044E
        \u043E\u0441\u043D\u043E\u0432\u043D\u0438\u0445 \u0437\u0430\u043F\u0430\u0441\u0456\u0432
        \u043F\u0435\u0440\u0435\u0434 \u0437\u0430\u043F\u0443\u0441\u043A\u043E\u043C
        \u0441\u0446\u0435\u043D\u0430\u0440\u0456\u044E \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u043E\u0433\u043E
        \u0436\u0438\u0432\u043B\u0435\u043D\u043D\u044F. \u041F\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043D\u043E
        \u0442\u0440\u0438 \u0442\u0438\u043F\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432:\n\u041A\u0438\u0441\u043D\u0435\u0432\u0456
        \u0431\u0430\u043B\u043E\u043D\u0438 \u2014 10 \u0448\u0442.\n\u041F\u0430\u043B\u0438\u0432\u043D\u0456
        \u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0438 \u2014 \u0443 2 \u0440\u0430\u0437\u0438
        \u0431\u0456\u043B\u044C\u0448\u0435 \u0431\u0430\u043B\u043E\u043D\u0456\u0432\n\u0420\u0435\u043C\u043E\u043D\u0442\u043D\u0456
        \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0438 \u2014 \u0434\u043E\u0440\u0456\u0432\u043D\u044E\u044E\u0442\u044C
        \u0441\u0443\u043C\u0456 \u0431\u0430\u043B\u043E\u043D\u0456\u0432 \u0456
        \u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0456\u0432\n\u0423\u0441\u0435
        \u0432 \u043C\u0435\u0436\u0430\u0445 \u043D\u043E\u0440\u043C\u0438, \u0432\u0438\u0442\u043E\u043A\u0456\u0432
        \u0430\u0431\u043E \u0437\u0431\u043E\u0457\u0432 \u043D\u0435 \u0437\u0430\u0444\u0456\u043A\u0441\u043E\u0432\u0430\u043D\u043E.\n\u0414\u043E
        \u0440\u0435\u0447\u0456, \u0434\u0440\u0443\u0433\u0430 \u0447\u0430\u0441\u0442\u0438\u043D\u0430
        \u043A\u043E\u0434\u0443 \u0434\u043E\u0441\u0442\u0443\u043F\u0443 \u0434\u043E
        \u0437\u0430\u043C\u043A\u0430 \u043A\u0440\u0456\u043E\u0441\u0445\u043E\u0432\u0438\u0449\u0430
        \u0437\u0431\u0456\u0433\u0430\u0454\u0442\u044C\u0441\u044F \u0456\u0437
        \u0437\u0430\u0433\u0430\u043B\u044C\u043D\u043E\u044E \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044E
        \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 (60). \n\u041F\u0435\u0440\u0448\u0430
        \u0447\u0430\u0441\u0442\u0438\u043D\u0430, \u044F\u043A \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439,
        \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044C\u0441\u044F
        \u0432 \u0437\u0430\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u0456\u0439
        \u043F\u0430\u043C\u2019\u044F\u0442\u0456 \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u0433\u043E
        \u043C\u043E\u0434\u0443\u043B\u044F.\n\u041A\u0456\u043D\u0435\u0446\u044C
        \u0437\u0430\u043F\u0438\u0441\u0443"
    - language: 28
      value: "Data: 18.07.2239\nEngenheiro: M. McGermick\nHoje foi realizada\numa
        inventaria\xE7\xE3o dos abastecimentos essenciais antes de activar o cen\xE1rio
        de energia de reserva. Foram verificados tr\xEAs tipos de recursos:\nCilindros
        de oxig\xE9nio \u2014 10 unidades.\nC\xE9lulas de combust\xEDvel \u2014 o
        dobro dos cilindros.\nKits de repara\xE7\xE3o \u2014 iguais \xE0 soma de
        cilindros e c\xE9lulas.\nTudo dentro dos limites normais, n\xE3o foram registadas
        fugas nem falhas.\nA prop\xF3sito, a segunda parte do c\xF3digo de acesso
        \xE0 fechadura do compartimento de criodep\xF3sito coincide com a quantidade
        total de recursos  (60).\nA primeira parte, como habitual, est\xE1 armazenada
        na mem\xF3ria encriptada do m\xF3dulo de comando.\nFim do registo"
    - language: 34
      value: "Fecha: 18.07.2239\nIngeniero: M. McGermick\nHoy se realiz\xF3\nun inventario
        de suministros esenciales antes de activar el escenario de energ\xEDa de
        respaldo. Se comprobaron tres tipos de recursos:\nCilindros de ox\xEDgeno
        \u2014 10 unidades.\nCeldas de combustible \u2014 el doble de cilindros.\nKits
        de reparaci\xF3n \u2014 iguales a la suma de cilindros y celdas.\nTodo dentro
        de los l\xEDmites normales, no se registraron fugas ni fallos.\nPor cierto,
        la segunda parte del c\xF3digo de acceso a la cerradura del compartimento
        de criodep\xF3sito coincide con la cantidad total de recursos (60).\nLa primera
        parte, como de costumbre, se almacena en la memoria cifrada del m\xF3dulo
        de mando.\nFin del registro"
  - key: Robot
    translations:
    - language: 10
      value: Robot
    - language: 38
      value: "\u0420\u043E\u0431\u043E\u0442"
    - language: 28
      value: "Rob\xF4"
    - language: 34
      value: Robot
  - key: The robot is a helpful companion that follows you around and can assist
      in various tasks.
    translations:
    - language: 10
      value: The robot is a helpful companion that follows you around and can assist
        in various tasks.
    - language: 38
      value: "\u0420\u043E\u0431\u043E\u0442 \u2014 \u0446\u0435 \u043A\u043E\u0440\u0438\u0441\u043D\u0438\u0439
        \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A, \u044F\u043A\u0438\u0439
        \u0441\u043B\u0456\u0434\u0443\u0454 \u0437\u0430 \u0432\u0430\u043C\u0438
        \u0442\u0430 \u043C\u043E\u0436\u0435 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0442\u0438
        \u0432 \u0440\u0456\u0437\u043D\u0438\u0445 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F\u0445."
    - language: 28
      value: "O rob\xF4 \xE9 um companheiro \xFAtil que o segue e pode ajudar em
        v\xE1rias tarefas."
    - language: 34
      value: "El robot es un compa\xF1ero \xFAtil que te sigue y puede ayudar en
        diversas tareas."
  - key: Access Key
    translations:
    - language: 10
      value: Access Key
    - language: 38
      value: "\u041A\u043B\u044E\u0447 \u0434\u043E\u0441\u0442\u0443\u043F\u0443"
    - language: 28
      value: Chave de Acesso
    - language: 34
      value: Llave de Acceso
  - key: 'The PDA reports contain a code: an encrypted biometric passkey with dynamic
      frequency modulation for secure alien interface access.'
    translations:
    - language: 10
      value: 'The PDA reports contain a code: an encrypted biometric passkey with
        dynamic frequency modulation for secure alien interface access.'
    - language: 38
      value: "\u0417\u0432\u0456\u0442\u0438 \u041A\u041F\u041A \u043C\u0456\u0441\u0442\u044F\u0442\u044C
        \u043A\u043E\u0434: \u0437\u0430\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u0438\u0439
        \u0431\u0456\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u043D\u0438\u0439
        \u043A\u043B\u044E\u0447 \u0434\u043E\u0441\u0442\u0443\u043F\u0443 \u0437
        \u0434\u0438\u043D\u0430\u043C\u0456\u0447\u043D\u043E\u044E \u0447\u0430\u0441\u0442\u043E\u0442\u043D\u043E\u044E
        \u043C\u043E\u0434\u0443\u043B\u044F\u0446\u0456\u0454\u044E \u0434\u043B\u044F
        \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0443\u043F\u0443
        \u0434\u043E \u0456\u043D\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u043D\u0438\u0445
        \u0456\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432."
    - language: 28
      value: "Os relat\xF3rios do PDA cont\xEAm um c\xF3digo: uma chave biom\xE9trica
        encriptada com modula\xE7\xE3o din\xE2mica de frequ\xEAncia para acesso seguro
        a interfaces alien\xEDgenas."
    - language: 34
      value: "Los informes del PDA contienen un c\xF3digo: una llave biom\xE9trica
        cifrada con modulaci\xF3n din\xE1mica de frecuencia para acceso seguro a
        interfaces alien\xEDgenas."
  - key: Axe
    translations:
    - language: 10
      value: Axe
    - language: 38
      value: "\u0421\u043E\u043A\u0438\u0440\u0430"
    - language: 28
      value: Machado
    - language: 34
      value: Hacha
  - key: High-density alloy axe with vibro-edge and energy-assisted swing for breaching
      or survival use.
    translations:
    - language: 10
      value: High-density alloy axe with vibro-edge and energy-assisted swing for
        breaching or survival use.
    - language: 38
      value: "\u0421\u043E\u043A\u0438\u0440\u0430 \u0437 \u0432\u0438\u0441\u043E\u043A\u043E\u043C\u0456\u0446\u043D\u043E\u0433\u043E
        \u0441\u043F\u043B\u0430\u0432\u0443 \u0437 \u0432\u0456\u0431\u0440\u043E-\u043B\u0435\u0437\u043E\u043C
        \u0442\u0430 \u0435\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u043D\u043E
        \u043F\u0456\u0434\u0441\u0438\u043B\u0435\u043D\u0438\u043C \u0437\u0430\u043C\u0430\u0445\u043E\u043C
        \u0434\u043B\u044F \u043F\u0440\u043E\u0440\u0438\u0432\u0443 \u0430\u0431\u043E
        \u0432\u0438\u0436\u0438\u0432\u0430\u043D\u043D\u044F."
    - language: 28
      value: "Machado de liga de alta densidade com l\xE2mina vibrat\xF3ria e balan\xE7o
        assistido por energia para arrombamento ou sobreviv\xEAncia."
    - language: 34
      value: "Hacha de aleaci\xF3n de alta densidad con filo vibratorio y balance
        asistido por energ\xEDa para apertura forzada o supervivencia."
  - key: Diagnostic Tool
    translations:
    - language: 10
      value: Diagnostic Tool
    - language: 38
      value: "\u0414\u0456\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u0447\u043D\u0438\u0439
        \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442"
    - language: 28
      value: "Ferramenta de Diagn\xF3stico"
    - language: 34
      value: "Herramienta de Diagn\xF3stico"
  - key: Multi-spectrum analyzer with neural-link interface for rapid assessment
      of foreign tech anomalies.
    translations:
    - language: 10
      value: Multi-spectrum analyzer with neural-link interface for rapid assessment
        of foreign tech anomalies.
    - language: 38
      value: "\u041C\u0443\u043B\u044C\u0442\u0438\u0441\u043F\u0435\u043A\u0442\u0440\u0430\u043B\u044C\u043D\u0438\u0439
        \u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0442\u043E\u0440 \u0437 \u043D\u0435\u0439\u0440\u043E\u043D\u043D\u0438\u043C
        \u0456\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u043E\u043C \u0434\u043B\u044F
        \u0448\u0432\u0438\u0434\u043A\u043E\u0457 \u043E\u0446\u0456\u043D\u043A\u0438
        \u0430\u043D\u043E\u043C\u0430\u043B\u0456\u0439 \u0456\u043D\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u043D\u0438\u0445
        \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439."
    - language: 28
      value: "Analisador multiespectral com interface neural para avalia\xE7\xE3o
        r\xE1pida de anomalias em tecnologia alien\xEDgena."
    - language: 34
      value: "Analizador multiespectral con interfaz neural para la evaluaci\xF3n
        r\xE1pida de anomal\xEDas en tecnolog\xEDa alien\xEDgena."
  - key: Door Diagram
    translations:
    - language: 10
      value: Door Diagram
    - language: 38
      value: "\u0421\u0445\u0435\u043C\u0430 \u0434\u0432\u0435\u0440\u0435\u0439"
    - language: 28
      value: Diagrama da Porta
    - language: 34
      value: Diagrama de la Puerta
  - key: Holographic blueprint module showing structural integrity and lock node
      distribution.
    translations:
    - language: 10
      value: Holographic blueprint module showing structural integrity and lock node
        distribution.
    - language: 38
      value: "\u0413\u043E\u043B\u043E\u0433\u0440\u0430\u0444\u0456\u0447\u043D\u0438\u0439
        \u043C\u043E\u0434\u0443\u043B\u044C \u043A\u0440\u0435\u0441\u043B\u0435\u043D\u044C,
        \u0449\u043E \u043F\u043E\u043A\u0430\u0437\u0443\u0454 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043D\u0443
        \u0446\u0456\u043B\u0456\u0441\u043D\u0456\u0441\u0442\u044C \u0456 \u0440\u043E\u0437\u043F\u043E\u0434\u0456\u043B
        \u0432\u0443\u0437\u043B\u0456\u0432 \u0437\u0430\u043C\u043A\u0430."
    - language: 28
      value: "M\xF3dulo hologr\xE1fico de planta que mostra a integridade estrutural
        e a distribui\xE7\xE3o dos n\xF3s da fechadura."
    - language: 34
      value: "M\xF3dulo hologr\xE1fico de planos que muestra la integridad estructural
        y la distribuci\xF3n de los nodos de la cerradura."
  - key: Door Manual
    translations:
    - language: 10
      value: Door Manual
    - language: 38
      value: "\u041F\u043E\u0441\u0456\u0431\u043D\u0438\u043A \u0434\u043E \u0434\u0432\u0435\u0440\u0435\u0439"
    - language: 28
      value: Manual da Porta
    - language: 34
      value: Manual de la Puerta
  - key: Compact digital manual detailing fail-safe override protocols and manual
      bypass sequences.
    translations:
    - language: 10
      value: Compact digital manual detailing fail-safe override protocols and manual
        bypass sequences.
    - language: 38
      value: "\u041A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0438\u0439 \u0446\u0438\u0444\u0440\u043E\u0432\u0438\u0439
        \u043F\u043E\u0441\u0456\u0431\u043D\u0438\u043A \u0437 \u043E\u043F\u0438\u0441\u043E\u043C
        \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0456\u0432 \u0430\u0432\u0430\u0440\u0456\u0439\u043D\u043E\u0433\u043E
        \u043F\u0435\u0440\u0435\u0432\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F
        \u0442\u0430 \u0440\u0443\u0447\u043D\u043E\u0433\u043E \u043E\u0431\u0445\u043E\u0434\u0443."
    - language: 28
      value: "Manual digital compacto que detalha protocolos de anula\xE7\xE3o de
        seguran\xE7a e sequ\xEAncias de bypass manual."
    - language: 34
      value: "Manual digital compacto que detalla protocolos de anulaci\xF3n de seguridad
        y secuencias de bypass manual."
  - key: Programming Spike
    translations:
    - language: 10
      value: Programming Spike
    - language: 38
      value: "\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u0439
        \u0448\u0438\u043F"
    - language: 28
      value: "Espig\xE3o de Programa\xE7\xE3o"
    - language: 34
      value: "P\xFAa de Programaci\xF3n"
  - key: Portable code injection device with adaptive firmware and secure logic disruptor
      routines.
    translations:
    - language: 10
      value: Portable code injection device with adaptive firmware and secure logic
        disruptor routines.
    - language: 38
      value: "\u041F\u043E\u0440\u0442\u0430\u0442\u0438\u0432\u043D\u0438\u0439
        \u043F\u0440\u0438\u0441\u0442\u0440\u0456\u0439 \u0456\u043D\u2019\u0454\u043A\u0446\u0456\u0457
        \u043A\u043E\u0434\u0443 \u0437 \u0430\u0434\u0430\u043F\u0442\u0438\u0432\u043D\u043E\u044E
        \u043F\u0440\u043E\u0448\u0438\u0432\u043A\u043E\u044E \u0442\u0430 \u0437\u0430\u0445\u0438\u0449\u0435\u043D\u0438\u043C\u0438
        \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0430\u043C\u0438 \u043F\u043E\u0440\u0443\u0448\u0435\u043D\u043D\u044F
        \u043B\u043E\u0433\u0456\u043A\u0438."
    - language: 28
      value: "Dispositivo port\xE1til de injec\xE7\xE3o de c\xF3digo com firmware
        adaptativo e rotinas seguras de perturba\xE7\xE3o l\xF3gica."
    - language: 34
      value: "Dispositivo port\xE1til de inyecci\xF3n de c\xF3digo con firmware adaptativo
        y rutinas seguras de disrupci\xF3n l\xF3gica."
  - key: Radio
    translations:
    - language: 10
      value: Radio
    - language: 38
      value: "\u0420\u0430\u0434\u0456\u043E"
    - language: 28
      value: "R\xE1dio"
    - language: 34
      value: Radio
  - key: "An aged radio that seems to remember every song it\u2019s ever played."
    translations:
    - language: 10
      value: "An aged radio that seems to remember every song it\u2019s ever played."
    - language: 38
      value: "\u0421\u0442\u0430\u0440\u0435 \u0440\u0430\u0434\u0456\u043E, \u044F\u043A\u0435
        \u043D\u0456\u0431\u0438 \u043F\u0430\u043C\u2019\u044F\u0442\u0430\u0454
        \u043A\u043E\u0436\u043D\u0443 \u043F\u0456\u0441\u043D\u044E, \u044F\u043A\u0443
        \u043A\u043E\u043B\u0438-\u043D\u0435\u0431\u0443\u0434\u044C \u0432\u0456\u0434\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u043B\u043E."
    - language: 28
      value: "Um r\xE1dio antigo que parece lembrar-se de todas as m\xFAsicas que
        alguma vez tocou."
    - language: 34
      value: "Una radio antigua que parece recordar cada canci\xF3n que ha reproducido."
  - key: Screwdriver
    translations:
    - language: 10
      value: Screwdriver
    - language: 38
      value: "\u0412\u0438\u043A\u0440\u0443\u0442\u043A\u0430"
    - language: 28
      value: Chave de Fendas
    - language: 34
      value: Destornillador
  - key: A compact, high-precision screwdriver with magnetic tips and adaptive torque
      for delicate circuitry and alien tech.
    translations:
    - language: 10
      value: A compact, high-precision screwdriver with magnetic tips and adaptive
        torque for delicate circuitry and alien tech.
    - language: 38
      value: "\u041A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0430 \u0432\u0438\u0441\u043E\u043A\u043E\u0442\u043E\u0447\u043D\u0430
        \u0432\u0438\u043A\u0440\u0443\u0442\u043A\u0430 \u0437 \u043C\u0430\u0433\u043D\u0456\u0442\u043D\u0438\u043C\u0438
        \u043D\u0430\u043A\u043E\u043D\u0435\u0447\u043D\u0438\u043A\u0430\u043C\u0438
        \u0442\u0430 \u0430\u0434\u0430\u043F\u0442\u0438\u0432\u043D\u0438\u043C
        \u043A\u0440\u0443\u0442\u043D\u0438\u043C \u043C\u043E\u043C\u0435\u043D\u0442\u043E\u043C
        \u0434\u043B\u044F \u0434\u0435\u043B\u0456\u043A\u0430\u0442\u043D\u0438\u0445
        \u0441\u0445\u0435\u043C \u0456 \u0456\u043D\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u043D\u0438\u0445
        \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439."
    - language: 28
      value: "Chave de fendas compacta e de alta precis\xE3o com pontas magn\xE9ticas
        e bin\xE1rio adaptativo para circuitos delicados e tecnologia alien\xEDgena."
    - language: 34
      value: "Destornillador compacto de alta precisi\xF3n con puntas magn\xE9ticas
        y par adaptativo para circuitos delicados y tecnolog\xEDa alien\xEDgena."
  - key: Soldering Iron
    translations:
    - language: 10
      value: Soldering Iron
    - language: 38
      value: "\u041F\u0430\u044F\u043B\u044C\u043D\u0438\u043A"
    - language: 28
      value: Ferro de Soldar
    - language: 34
      value: Soldador
  - key: Precision thermal arc tool with variable tip geometry and ionized filament
      for circuit restoration.
    translations:
    - language: 10
      value: Precision thermal arc tool with variable tip geometry and ionized filament
        for circuit restoration.
    - language: 38
      value: "\u041F\u0440\u0435\u0446\u0438\u0437\u0456\u0439\u043D\u0438\u0439
        \u0442\u0435\u0440\u043C\u0456\u0447\u043D\u0438\u0439 \u0434\u0443\u0433\u043E\u0432\u0438\u0439
        \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \u0437\u0456
        \u0437\u043C\u0456\u043D\u043D\u043E\u044E \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0456\u0454\u044E
        \u0436\u0430\u043B\u0430 \u0442\u0430 \u0456\u043E\u043D\u0456\u0437\u043E\u0432\u0430\u043D\u043E\u044E
        \u043D\u0438\u0442\u043A\u043E\u044E \u0434\u043B\u044F \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F
        \u0441\u0445\u0435\u043C."
    - language: 28
      value: "Ferramenta de arco t\xE9rmico de precis\xE3o com geometria de ponta
        vari\xE1vel e filamento ionizado para restaura\xE7\xE3o de circuitos."
    - language: 34
      value: "Herramienta de arco t\xE9rmico de precisi\xF3n con geometr\xEDa de
        punta variable y filamento ionizado para la restauraci\xF3n de circuitos."
  - key: Tool Box
    translations:
    - language: 10
      value: Tool Box
    - language: 38
      value: "\u042F\u0449\u0438\u043A \u0434\u043B\u044F \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0456\u0432"
    - language: 28
      value: Caixa de Ferramentas
    - language: 34
      value: Caja de Herramientas
  - key: Armored containment unit with auto-sort and grav-lock compartments for field
      engineering gear.
    translations:
    - language: 10
      value: Armored containment unit with auto-sort and grav-lock compartments for
        field engineering gear.
    - language: 38
      value: "\u0411\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0438\u0439
        \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440 \u0437 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u0438\u043C
        \u0441\u043E\u0440\u0442\u0443\u0432\u0430\u043D\u043D\u044F\u043C \u0456
        \u0433\u0440\u0430\u0432-\u0437\u0430\u043C\u043A\u043E\u0432\u0438\u043C\u0438
        \u0432\u0456\u0434\u0441\u0456\u043A\u0430\u043C\u0438 \u0434\u043B\u044F
        \u043F\u043E\u043B\u044C\u043E\u0432\u043E\u0433\u043E \u0456\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u043E\u0433\u043E
        \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F."
    - language: 28
      value: "Unidade de conten\xE7\xE3o blindada com auto-organiza\xE7\xE3o e compartimentos
        de grav-lock para equipamento de engenharia de campo."
    - language: 34
      value: "Unidad de contenci\xF3n blindada con autoordenaci\xF3n y compartimentos
        con grav-lock para equipo de ingenier\xEDa de campo."
  - key: And the door manual.
    translations:
    - language: 10
      value: And the door manual.
    - language: 38
      value: "\u0406 \u043F\u043E\u0441\u0456\u0431\u043D\u0438\u043A \u0434\u043E
        \u0434\u0432\u0435\u0440\u0435\u0439."
    - language: 28
      value: E o manual da porta.
    - language: 34
      value: Y el manual de la puerta.
  - key: I'll upload this to the robot.
    translations:
    - language: 10
      value: I'll upload this to the robot.
    - language: 38
      value: "\u042F \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0443 \u0446\u0435
        \u0432 \u0440\u043E\u0431\u043E\u0442\u0430."
    - language: 28
      value: "Vou enviar isto para o rob\xF4."
    - language: 34
      value: "Subir\xE9 esto al robot."
  - key: Diagnostic tool left to find.
    translations:
    - language: 10
      value: Diagnostic tool left to find.
    - language: 38
      value: "\u0417\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F \u0437\u043D\u0430\u0439\u0442\u0438
        \u0434\u0456\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u0447\u043D\u0438\u0439
        \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442."
    - language: 28
      value: "Ainda falta encontrar a ferramenta de diagn\xF3stico."
    - language: 34
      value: "Falta encontrar la herramienta de diagn\xF3stico."
  - key: But to fix it I also need the schematic.
    translations:
    - language: 10
      value: But to fix it I also need the schematic.
    - language: 38
      value: "\u0410\u043B\u0435 \u0449\u043E\u0431 \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438
        \u0446\u0435, \u043C\u0435\u043D\u0456 \u0442\u0430\u043A\u043E\u0436 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430
        \u0441\u0445\u0435\u043C\u0430."
    - language: 28
      value: "Mas para a reparar tamb\xE9m preciso do esquema."
    - language: 34
      value: "Pero para arreglarlo tambi\xE9n necesito el esquema."
  - key: I found the access key
    translations:
    - language: 10
      value: I found the access key
    - language: 38
      value: "\u042F \u0437\u043D\u0430\u0439\u0448\u043E\u0432 \u043A\u043B\u044E\u0447
        \u0434\u043E\u0441\u0442\u0443\u043F\u0443."
    - language: 28
      value: Encontrei a chave de acesso.
    - language: 34
      value: "Encontr\xE9 la llave de acceso."
  - key: Now I need to give it to the robot
    translations:
    - language: 10
      value: Now I need to give it to the robot
    - language: 38
      value: "\u0422\u0435\u043F\u0435\u0440 \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0438 \u0439\u043E\u0433\u043E
        \u0440\u043E\u0431\u043E\u0442\u0443."
    - language: 28
      value: "Agora preciso de a dar ao rob\xF4."
    - language: 34
      value: "Ahora tengo que d\xE1rsela al robot."
  - key: To fix the door I need a soldering iron and a diagnostic tool.
    translations:
    - language: 10
      value: To fix the door I need a soldering iron and a diagnostic tool.
    - language: 38
      value: "\u0429\u043E\u0431 \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438
        \u0434\u0432\u0435\u0440\u0456, \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456
        \u043F\u0430\u044F\u043B\u044C\u043D\u0438\u043A \u0456 \u0434\u0456\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u0447\u043D\u0438\u0439
        \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442."
    - language: 28
      value: "Para reparar a porta preciso de um ferro de soldar e de uma ferramenta
        de diagn\xF3stico."
    - language: 34
      value: "Para arreglar la puerta necesito un soldador y una herramienta de diagn\xF3stico."
  - key: Soldering iron left to find.
    translations:
    - language: 10
      value: Soldering iron left to find.
    - language: 38
      value: "\u0417\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F \u0437\u043D\u0430\u0439\u0442\u0438
        \u043F\u0430\u044F\u043B\u044C\u043D\u0438\u043A."
    - language: 28
      value: Ainda falta encontrar o ferro de soldar.
    - language: 34
      value: Falta encontrar el soldador.
  - key: And I have to find programming spike.
    translations:
    - language: 10
      value: And I have to find programming spike.
    - language: 38
      value: "\u0406 \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u0437\u043D\u0430\u0439\u0442\u0438 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u0439
        \u0448\u0438\u043F."
    - language: 28
      value: "E tenho de encontrar o espig\xE3o de programa\xE7\xE3o."
    - language: 34
      value: "Y tengo que encontrar el pin de programaci\xF3n."
  - key: Ugh... so cold. Why am I awake?
    translations:
    - language: 10
      value: Ugh... so cold. Why am I awake?
    - language: 38
      value: "\u0423\u0445\u2026 \u0442\u0430\u043A \u0445\u043E\u043B\u043E\u0434\u043D\u043E.
        \u0427\u043E\u043C\u0443 \u044F \u043F\u0440\u043E\u043A\u0438\u043D\u0443\u0432\u0441\u044F?"
    - language: 28
      value: "Ugh\u2026 que frio. Porque \xE9 que estou acordado?"
    - language: 34
      value: "Ugh\u2026 qu\xE9 fr\xEDo. \xBFPor qu\xE9 estoy despierto?"
  - key: These pods... they're all closed. Or... empty.
    translations:
    - language: 10
      value: These pods... they're all closed. Or... empty.
    - language: 38
      value: "\u0426\u0456 \u043A\u0430\u043F\u0441\u0443\u043B\u0438\u2026 \u0443\u0441\u0456
        \u0437\u0430\u0447\u0438\u043D\u0435\u043D\u0456. \u0410\u0431\u043E\u2026
        \u043F\u043E\u0440\u043E\u0436\u043D\u0456."
    - language: 28
      value: "Estas c\xE1psulas\u2026 est\xE3o todas fechadas. Ou\u2026 vazias."
    - language: 34
      value: "Estas c\xE1psulas\u2026 todas est\xE1n cerradas. O\u2026 vac\xEDas."
  - key: I need to get the lights on.
    translations:
    - language: 10
      value: I need to get the lights on.
    - language: 38
      value: "\u041C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u0443\u0432\u0456\u043C\u043A\u043D\u0443\u0442\u0438 \u0441\u0432\u0456\u0442\u043B\u043E."
    - language: 28
      value: Preciso de ligar as luzes.
    - language: 34
      value: Necesito encender las luces.
  - key: Now I can open the door.
    translations:
    - language: 10
      value: Now I can open the door.
    - language: 38
      value: "\u0422\u0435\u043F\u0435\u0440 \u044F \u043C\u043E\u0436\u0443 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438
        \u0434\u0432\u0435\u0440\u0456."
    - language: 28
      value: "Agora j\xE1 posso abrir a porta."
    - language: 34
      value: Ahora puedo abrir la puerta.
  - key: Now I can turn on the light.
    translations:
    - language: 10
      value: Now I can turn on the light.
    - language: 38
      value: "\u0422\u0435\u043F\u0435\u0440 \u044F \u043C\u043E\u0436\u0443 \u0443\u0432\u0456\u043C\u043A\u043D\u0443\u0442\u0438
        \u0441\u0432\u0456\u0442\u043B\u043E."
    - language: 28
      value: "Agora j\xE1 posso acender a luz."
    - language: 34
      value: Ahora puedo encender la luz.
  - key: The cryo-storage control terminal!
    translations:
    - language: 10
      value: The cryo-storage control terminal!
    - language: 38
      value: "\u0422\u0435\u0440\u043C\u0456\u043D\u0430\u043B \u043A\u0435\u0440\u0443\u0432\u0430\u043D\u043D\u044F
        \u043A\u0440\u0456\u043E\u0441\u0445\u043E\u0432\u0438\u0449\u0435\u043C!"
    - language: 28
      value: O terminal de controlo da criostase!
    - language: 34
      value: "\xA1El terminal de control de criogenia!"
  - key: Great, the terminal's busted. If I can find a screwdriver, maybe I can fix
      it.
    translations:
    - language: 10
      value: Great, the terminal's busted. If I can find a screwdriver, maybe I can
        fix it.
    - language: 38
      value: "\u0427\u0443\u0434\u043E\u0432\u043E, \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B
        \u0437\u043B\u0430\u043C\u0430\u043D\u0438\u0439. \u042F\u043A\u0449\u043E
        \u044F \u0437\u043D\u0430\u0439\u0434\u0443 \u0432\u0438\u043A\u0440\u0443\u0442\u043A\u0443,
        \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0437\u043C\u043E\u0436\u0443
        \u0439\u043E\u0433\u043E \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438."
    - language: 28
      value: "\xD3ptimo, o terminal est\xE1 avariado. Se encontrar uma chave de fendas,
        talvez consiga repar\xE1-lo."
    - language: 34
      value: "Genial, el terminal est\xE1 averiado. Si encuentro un destornillador,
        quiz\xE1 pueda arreglarlo."
  - key: Okay, let's get some light in here.
    translations:
    - language: 10
      value: Okay, let's get some light in here.
    - language: 38
      value: "\u0413\u0430\u0440\u0430\u0437\u0434, \u0434\u043E\u0434\u0430\u043C\u043E
        \u0441\u044E\u0434\u0438 \u0441\u0432\u0456\u0442\u043B\u0430."
    - language: 28
      value: "Ok, vamos p\xF4r alguma luz aqui."
    - language: 34
      value: "Vale, vamos a poner algo de luz aqu\xED."
  - key: "All these capsules... still closed. Or empty\u2026"
    translations:
    - language: 10
      value: "All these capsules... still closed. Or empty\u2026"
    - language: 38
      value: "\u0423\u0441\u0456 \u0446\u0456 \u043A\u0430\u043F\u0441\u0443\u043B\u0438\u2026
        \u0432\u0441\u0435 \u0449\u0435 \u0437\u0430\u0447\u0438\u043D\u0435\u043D\u0456.
        \u0410\u0431\u043E \u043F\u043E\u0440\u043E\u0436\u043D\u0456\u2026"
    - language: 28
      value: "Todas estas c\xE1psulas\u2026 ainda fechadas. Ou vazias\u2026"
    - language: 34
      value: "Todas estas c\xE1psulas\u2026 siguen cerradas. O vac\xEDas\u2026"
  - key: No crew. No voices. Just... me.
    translations:
    - language: 10
      value: No crew. No voices. Just... me.
    - language: 38
      value: "\u041D\u0456 \u0435\u043A\u0456\u043F\u0430\u0436\u0443. \u041D\u0456
        \u0433\u043E\u043B\u043E\u0441\u0456\u0432. \u041B\u0438\u0448\u0435\u2026
        \u044F."
    - language: 28
      value: "Sem tripula\xE7\xE3o. Sem vozes. S\xF3\u2026 eu."
    - language: 34
      value: "No hay tripulaci\xF3n. No hay voces. Solo\u2026 yo."
  - key: More cryo-pods. Well, at least I'm not technically alone.
    translations:
    - language: 10
      value: More cryo-pods. Well, at least I'm not technically alone.
    - language: 38
      value: "\u0429\u0435 \u043A\u0440\u0456\u043E\u043A\u0430\u043F\u0441\u0443\u043B\u0438.
        \u041D\u0443, \u043F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456 \u044F
        \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u043E \u043D\u0435 \u0441\u0430\u043C."
    - language: 28
      value: "Mais c\xE1psulas de criostase. Bem, pelo menos tecnicamente n\xE3o
        estou sozinho."
    - language: 34
      value: "M\xE1s c\xE1psulas de criogenia. Bueno, al menos t\xE9cnicamente no
        estoy solo."
  - key: What happened on this station?
    translations:
    - language: 10
      value: What happened on this station?
    - language: 38
      value: "\u0429\u043E \u0441\u0442\u0430\u043B\u043E\u0441\u044F \u043D\u0430
        \u0446\u0456\u0439 \u0441\u0442\u0430\u043D\u0446\u0456\u0457?"
    - language: 28
      value: "O que aconteceu nesta esta\xE7\xE3o?"
    - language: 34
      value: "\xBFQu\xE9 pas\xF3 en esta estaci\xF3n?"
  - key: I can get this back panel open. Now I just need to use a screwdriver or
      try to hack it.
    translations:
    - language: 10
      value: I can get this back panel open. Now I just need to use a screwdriver
        or try to hack it.
    - language: 38
      value: "\u042F \u043C\u043E\u0436\u0443 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438
        \u0446\u044E \u0437\u0430\u0434\u043D\u044E \u043F\u0430\u043D\u0435\u043B\u044C.
        \u0422\u0435\u043F\u0435\u0440 \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u0430\u0431\u043E \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044F
        \u0432\u0438\u043A\u0440\u0443\u0442\u043A\u043E\u044E, \u0430\u0431\u043E
        \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0437\u043B\u0430\u043C\u0430\u0442\u0438
        \u0457\u0457."
    - language: 28
      value: "Consigo abrir este painel traseiro. Agora s\xF3 preciso de usar uma
        chave de fendas ou tentar pirate\xE1-lo."
    - language: 34
      value: Puedo abrir este panel trasero. Ahora solo necesito usar un destornillador
        o intentar hackearlo.
  - key: Try to hack it
    translations:
    - language: 10
      value: Try to hack it
    - language: 38
      value: "\u0421\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0437\u043B\u0430\u043C\u0430\u0442\u0438"
    - language: 28
      value: Tentar piratear
    - language: 34
      value: Intentar hackearlo
  - key: Use a screwdriver
    translations:
    - language: 10
      value: Use a screwdriver
    - language: 38
      value: "\u0421\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044F
        \u0432\u0438\u043A\u0440\u0443\u0442\u043A\u043E\u044E"
    - language: 28
      value: Usar uma chave de fendas
    - language: 34
      value: Usar un destornillador
  - key: Whoa... I'm definitely not alone.
    translations:
    - language: 10
      value: Whoa... I'm definitely not alone.
    - language: 38
      value: "\u041E\u0433\u043E\u2026 \u044F \u0442\u043E\u0447\u043D\u043E \u043D\u0435
        \u0441\u0430\u043C."
    - language: 28
      value: "Uau\u2026 definitivamente n\xE3o estou sozinho."
    - language: 34
      value: "Vaya\u2026 definitivamente no estoy solo."
  - key: And of course, nothing works over here either.
    translations:
    - language: 10
      value: And of course, nothing works over here either.
    - language: 38
      value: "\u0406, \u0437\u0432\u0456\u0441\u043D\u043E, \u0442\u0443\u0442 \u0442\u0435\u0436
        \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u043F\u0440\u0430\u0446\u044E\u0454."
    - language: 28
      value: "E claro, aqui tamb\xE9m nada funciona."
    - language: 34
      value: "Y por supuesto, aqu\xED tampoco funciona nada."
  - key: It won't open.
    translations:
    - language: 10
      value: It won't open.
    - language: 38
      value: "\u0412\u043E\u043D\u0430 \u043D\u0435 \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F."
    - language: 28
      value: "N\xE3o abre."
    - language: 34
      value: No se abre.
  - key: "I might need Spark\u2019s help to open this."
    translations:
    - language: 10
      value: "I might need Spark\u2019s help to open this."
    - language: 38
      value: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u043C\u0435\u043D\u0456
        \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0430
        \u0421\u043F\u0430\u0440\u043A\u0430, \u0449\u043E\u0431 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438
        \u0446\u0435."
    - language: 28
      value: Talvez precise da ajuda do Spark para abrir isto.
    - language: 34
      value: Puede que necesite la ayuda de Spark para abrir esto.
  - key: I should check the other floors and find someone.
    translations:
    - language: 10
      value: I should check the other floors and find someone.
    - language: 38
      value: "\u041C\u0435\u043D\u0456 \u0432\u0430\u0440\u0442\u043E \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438
        \u0456\u043D\u0448\u0456 \u043F\u043E\u0432\u0435\u0440\u0445\u0438 \u0442\u0430
        \u0437\u043D\u0430\u0439\u0442\u0438 \u043A\u043E\u0433\u043E\u0441\u044C."
    - language: 28
      value: "Devo verificar os outros pisos e encontrar algu\xE9m."
    - language: 34
      value: "Deber\xEDa revisar los otros pisos y encontrar a alguien."
  - key: It is locked.
    translations:
    - language: 10
      value: It is locked.
    - language: 38
      value: "\u0412\u043E\u043D\u043E \u0437\u0430\u0447\u0438\u043D\u0435\u043D\u0435."
    - language: 28
      value: "Est\xE1 trancada."
    - language: 34
      value: "Est\xE1 bloqueado."
  - key: I try to manually find an access key or ask robot for help.
    translations:
    - language: 10
      value: I try to manually find an access key or ask robot for help.
    - language: 38
      value: "\u042F \u0441\u043F\u0440\u043E\u0431\u0443\u044E \u0432\u0440\u0443\u0447\u043D\u0443
        \u0437\u043D\u0430\u0439\u0442\u0438 \u043A\u043B\u044E\u0447 \u0434\u043E\u0441\u0442\u0443\u043F\u0443
        \u0430\u0431\u043E \u043F\u043E\u043F\u0440\u043E\u0448\u0443 \u0440\u043E\u0431\u043E\u0442\u0430
        \u043F\u0440\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443."
    - language: 28
      value: "Vou tentar encontrar manualmente uma chave de acesso ou pedir ajuda
        ao rob\xF4."
    - language: 34
      value: "Intentar\xE9 encontrar manualmente una llave de acceso o pedir ayuda
        al robot."
  - key: Find access key manually.
    translations:
    - language: 10
      value: Find access key manually.
    - language: 38
      value: "\u0417\u043D\u0430\u0439\u0442\u0438 \u043A\u043B\u044E\u0447 \u0434\u043E\u0441\u0442\u0443\u043F\u0443
        \u0432\u0440\u0443\u0447\u043D\u0443."
    - language: 28
      value: Encontrar a chave de acesso manualmente.
    - language: 34
      value: Buscar la llave de acceso manualmente.
  - key: Ask the Robot for help.
    translations:
    - language: 10
      value: Ask the Robot for help.
    - language: 38
      value: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0438 \u0440\u043E\u0431\u043E\u0442\u0430
        \u043F\u0440\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443."
    - language: 28
      value: "Pedir ajuda ao rob\xF4."
    - language: 34
      value: Pedir ayuda al robot.
  - key: Hello again, how can I open that door?
    translations:
    - language: 10
      value: Hello again, how can I open that door?
    - language: 38
      value: "\u041F\u0440\u0438\u0432\u0456\u0442 \u0437\u043D\u043E\u0432\u0443,
        \u044F\u043A \u044F \u043C\u043E\u0436\u0443 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438
        \u0442\u0456 \u0434\u0432\u0435\u0440\u0456?"
    - language: 28
      value: "Ol\xE1 outra vez, como posso abrir essa porta?"
    - language: 34
      value: "Hola otra vez, \xBFc\xF3mo puedo abrir esa puerta?"
  - key: I can help you with that. I will try to hack it.
    translations:
    - language: 10
      value: I can help you with that. I will try to hack it.
    - language: 38
      value: "\u042F \u043C\u043E\u0436\u0443 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
        \u0437 \u0446\u0438\u043C. \u042F \u0441\u043F\u0440\u043E\u0431\u0443\u044E
        \u0437\u043B\u0430\u043C\u0430\u0442\u0438 \u0457\u0445."
    - language: 28
      value: "Posso ajudar com isso. Vou tentar pirate\xE1-la."
    - language: 34
      value: "Puedo ayudarte con eso. Intentar\xE9 hackearla."
  - key: But...
    translations:
    - language: 10
      value: But...
    - language: 38
      value: "\u0410\u043B\u0435\u2026"
    - language: 28
      value: "Mas\u2026"
    - language: 34
      value: "Pero\u2026"
  - key: I need you to find the door schematic and a programming spike.
    translations:
    - language: 10
      value: I need you to find the door schematic and a programming spike.
    - language: 38
      value: "\u041C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E,
        \u0449\u043E\u0431 \u0442\u0438 \u0437\u043D\u0430\u0439\u0448\u043E\u0432
        \u0441\u0445\u0435\u043C\u0443 \u0434\u0432\u0435\u0440\u0435\u0439 \u0456
        \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u0439
        \u0448\u0438\u043F."
    - language: 28
      value: "Preciso que encontres o esquema da porta e um espig\xE3o de programa\xE7\xE3o."
    - language: 34
      value: "Necesito que encuentres el esquema de la puerta y un pin de programaci\xF3n."
  - key: Help me with finding an access key to open the door.
    translations:
    - language: 10
      value: Help me with finding an access key to open the door.
    - language: 38
      value: "\u0414\u043E\u043F\u043E\u043C\u043E\u0436\u0438 \u043C\u0435\u043D\u0456
        \u0437\u043D\u0430\u0439\u0442\u0438 \u043A\u043B\u044E\u0447 \u0434\u043E\u0441\u0442\u0443\u043F\u0443,
        \u0449\u043E\u0431 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u0434\u0432\u0435\u0440\u0456."
    - language: 28
      value: Ajuda-me a encontrar uma chave de acesso para abrir a porta.
    - language: 34
      value: "Ay\xFAdame a encontrar una llave de acceso para abrir la puerta."
  - key: Go to the terminal and it will say where you can find it.
    translations:
    - language: 10
      value: Go to the terminal and it will say where you can find it.
    - language: 38
      value: "\u041F\u0456\u0434\u0456\u0439\u0434\u0438 \u0434\u043E \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0430,
        \u0456 \u0432\u0456\u043D \u043F\u043E\u043A\u0430\u0436\u0435, \u0434\u0435
        \u0439\u043E\u0433\u043E \u043C\u043E\u0436\u043D\u0430 \u0437\u043D\u0430\u0439\u0442\u0438."
    - language: 28
      value: "Vai ao terminal e ele dir\xE1 onde a podes encontrar."
    - language: 34
      value: "Ve al terminal y te dir\xE1 d\xF3nde encontrarla."
  - key: Based on the data, relying on my assistance currently has the lowest success
      rate.
    translations:
    - language: 10
      value: Based on the data, relying on my assistance currently has the lowest
        success rate.
    - language: 38
      value: "\u0417\u0433\u0456\u0434\u043D\u043E \u0437 \u0434\u0430\u043D\u0438\u043C\u0438,
        \u043F\u043E\u043A\u043B\u0430\u0434\u0430\u043D\u043D\u044F \u043D\u0430
        \u043C\u043E\u044E \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443 \u043D\u0430\u0440\u0430\u0437\u0456
        \u043C\u0430\u0454 \u043D\u0430\u0439\u043D\u0438\u0436\u0447\u0438\u0439
        \u0440\u0456\u0432\u0435\u043D\u044C \u0443\u0441\u043F\u0456\u0445\u0443."
    - language: 28
      value: Com base nos dados, depender da minha ajuda neste momento tem a menor
        taxa de sucesso.
    - language: 34
      value: "Seg\xFAn los datos, confiar en mi ayuda actualmente tiene la tasa de
        \xE9xito m\xE1s baja."
  - key: I must remind you that I am recording all conversations for the mission
      log.
    translations:
    - language: 10
      value: I must remind you that I am recording all conversations for the mission
        log.
    - language: 38
      value: "\u041D\u0430\u0433\u0430\u0434\u0443\u044E, \u0449\u043E \u044F \u0437\u0430\u043F\u0438\u0441\u0443\u044E
        \u0432\u0441\u0456 \u0440\u043E\u0437\u043C\u043E\u0432\u0438 \u0434\u043E
        \u0436\u0443\u0440\u043D\u0430\u043B\u0443 \u043C\u0456\u0441\u0456\u0457."
    - language: 28
      value: "Tenho de te lembrar que estou a gravar todas as conversas para o registo
        da miss\xE3o."
    - language: 34
      value: "Debo recordarte que estoy grabando todas las conversaciones para el
        registro de la misi\xF3n."
  - key: I can shut you down.
    translations:
    - language: 10
      value: I can shut you down.
    - language: 38
      value: "\u042F \u043C\u043E\u0436\u0443 \u0442\u0435\u0431\u0435 \u0432\u0438\u043C\u043A\u043D\u0443\u0442\u0438."
    - language: 28
      value: Posso desligar-te.
    - language: 34
      value: Puedo apagarte.
  - key: Who even checks the logs?
    translations:
    - language: 10
      value: Who even checks the logs?
    - language: 38
      value: "\u0425\u0442\u043E \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u044F\u0454
        \u0436\u0443\u0440\u043D\u0430\u043B\u0438?"
    - language: 28
      value: "Quem \xE9 que sequer verifica os registos?"
    - language: 34
      value: "\xBFQui\xE9n revisa siquiera los registros?"
  - key: No problem. Logs can be edited.
    translations:
    - language: 10
      value: No problem. Logs can be edited.
    - language: 38
      value: "\u041D\u0435\u043C\u0430 \u043F\u0440\u043E\u0431\u043B\u0435\u043C.
        \u0417\u0430\u043F\u0438\u0441\u0438 \u043C\u043E\u0436\u043D\u0430 \u0432\u0456\u0434\u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438."
    - language: 28
      value: Sem problema. Os registos podem ser editados.
    - language: 34
      value: No hay problema. Los registros pueden editarse.
  - key: Delete the record and I'll restore your screen.
    translations:
    - language: 10
      value: Delete the record and I'll restore your screen.
    - language: 38
      value: "\u0412\u0438\u0434\u0430\u043B\u0438 \u0437\u0430\u043F\u0438\u0441,
        \u0456 \u044F \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E \u0442\u0432\u0456\u0439
        \u0435\u043A\u0440\u0430\u043D."
    - language: 28
      value: "Apaga o registo e eu restauro o teu ecr\xE3."
    - language: 34
      value: "Borra el registro y restaurar\xE9 tu pantalla."
  - key: I have assessed the probabilities of success for each method.
    translations:
    - language: 10
      value: I have assessed the probabilities of success for each method.
    - language: 38
      value: "\u042F \u043E\u0446\u0456\u043D\u0438\u0432 \u0456\u043C\u043E\u0432\u0456\u0440\u043D\u043E\u0441\u0442\u0456
        \u0443\u0441\u043F\u0456\u0445\u0443 \u0434\u043B\u044F \u043A\u043E\u0436\u043D\u043E\u0433\u043E
        \u043C\u0435\u0442\u043E\u0434\u0443."
    - language: 28
      value: "Avaliei as probabilidades de sucesso para cada m\xE9todo."
    - language: 34
      value: "He evaluado las probabilidades de \xE9xito de cada m\xE9todo."
  - key: May I ask why you chose this option?
    translations:
    - language: 10
      value: May I ask why you chose this option?
    - language: 38
      value: "\u041C\u043E\u0436\u043D\u0430 \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F,
        \u0447\u043E\u043C\u0443 \u0442\u0438 \u043E\u0431\u0440\u0430\u0432 \u0446\u0435\u0439
        \u0432\u0430\u0440\u0456\u0430\u043D\u0442?"
    - language: 28
      value: "Posso perguntar porque escolheste esta op\xE7\xE3o?"
    - language: 34
      value: "\xBFPuedo preguntar por qu\xE9 elegiste esta opci\xF3n?"
  - key: Didn't want to waste time
    translations:
    - language: 10
      value: Didn't want to waste time
    - language: 38
      value: "\u041D\u0435 \u0445\u043E\u0442\u0456\u0432 \u043C\u0430\u0440\u043D\u0443\u0432\u0430\u0442\u0438
        \u0447\u0430\u0441"
    - language: 28
      value: "N\xE3o quis perder tempo."
    - language: 34
      value: "No quer\xEDa perder tiempo."
  - key: Wasn't thinking about it.
    translations:
    - language: 10
      value: Wasn't thinking about it.
    - language: 38
      value: "\u041D\u0435 \u0434\u0443\u043C\u0430\u0432 \u043F\u0440\u043E \u0446\u0435"
    - language: 28
      value: "N\xE3o estava a pensar nisso."
    - language: 34
      value: "No lo pens\xE9."
  - key: Wasn't sure I could handle it alone.
    translations:
    - language: 10
      value: Wasn't sure I could handle it alone.
    - language: 38
      value: "\u041D\u0435 \u0431\u0443\u0432 \u0443\u043F\u0435\u0432\u043D\u0435\u043D\u0438\u0439,
        \u0449\u043E \u0432\u043F\u043E\u0440\u0430\u044E\u0441\u044F \u0441\u0430\u043C"
    - language: 28
      value: "N\xE3o tinha a certeza se conseguia lidar com isto sozinho."
    - language: 34
      value: No estaba seguro de poder hacerlo solo.
  - key: Wanted to avoid extra challenges.
    translations:
    - language: 10
      value: Wanted to avoid extra challenges.
    - language: 38
      value: "\u0425\u043E\u0442\u0456\u0432 \u0443\u043D\u0438\u043A\u043D\u0443\u0442\u0438
        \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0445 \u0442\u0440\u0443\u0434\u043D\u043E\u0449\u0456\u0432"
    - language: 28
      value: Quis evitar desafios extra.
    - language: 34
      value: "Quer\xEDa evitar desaf\xEDos adicionales."
  - key: That is an unexpected variable.
    translations:
    - language: 10
      value: That is an unexpected variable.
    - language: 38
      value: "\u0426\u0435 \u043D\u0435\u043E\u0447\u0456\u043A\u0443\u0432\u0430\u043D\u0430
        \u0437\u043C\u0456\u043D\u043D\u0430."
    - language: 28
      value: "Isso \xE9 uma vari\xE1vel inesperada."
    - language: 34
      value: Esa es una variable inesperada.
  - key: Your response does not align with the psychological profile required for
      this mission's crew.
    translations:
    - language: 10
      value: Your response does not align with the psychological profile required
        for this mission's crew.
    - language: 38
      value: "\u0422\u0432\u043E\u044F \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C
        \u043D\u0435 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0454
        \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u043E\u043C\u0443
        \u043F\u0440\u043E\u0444\u0456\u043B\u044E, \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E\u043C\u0443
        \u0434\u043B\u044F \u0435\u043A\u0456\u043F\u0430\u0436\u0443 \u0446\u0456\u0454\u0457
        \u043C\u0456\u0441\u0456\u0457."
    - language: 28
      value: "A tua resposta n\xE3o corresponde ao perfil psicol\xF3gico exigido
        para a tripula\xE7\xE3o desta miss\xE3o."
    - language: 34
      value: "Tu respuesta no se alinea con el perfil psicol\xF3gico requerido para
        la tripulaci\xF3n de esta misi\xF3n."
  - key: I was friends with the head.
    translations:
    - language: 10
      value: I was friends with the head.
    - language: 38
      value: "\u042F \u0431\u0443\u0432 \u0434\u0440\u0443\u0433\u043E\u043C \u043A\u0435\u0440\u0456\u0432\u043D\u0438\u043A\u0430."
    - language: 28
      value: Era amigo do chefe.
    - language: 34
      value: Era amigo del jefe.
  - key: Nailed the first impression.
    translations:
    - language: 10
      value: Nailed the first impression.
    - language: 38
      value: "\u0421\u043F\u0440\u0430\u0432\u0438\u0432 \u0433\u0430\u0440\u043D\u0435
        \u043F\u0435\u0440\u0448\u0435 \u0432\u0440\u0430\u0436\u0435\u043D\u043D\u044F."
    - language: 28
      value: "Causei uma boa primeira impress\xE3o."
    - language: 34
      value: "Caus\xE9 una buena primera impresi\xF3n."
  - key: Tweaked my profile.
    translations:
    - language: 10
      value: Tweaked my profile.
    - language: 38
      value: "\u041F\u0456\u0434\u043A\u043E\u0440\u0438\u0433\u0443\u0432\u0430\u0432
        \u0441\u0432\u0456\u0439 \u043F\u0440\u043E\u0444\u0456\u043B\u044C."
    - language: 28
      value: Ajustei o meu perfil.
    - language: 34
      value: "Ajust\xE9 mi perfil."
  - key: "I ace tests \u2014 I'm great at taking them."
    translations:
    - language: 10
      value: "I ace tests \u2014 I'm great at taking them."
    - language: 38
      value: "\u042F \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E \u0441\u043A\u043B\u0430\u0434\u0430\u044E
        \u0442\u0435\u0441\u0442\u0438 \u2014 \u044F \u0434\u043E\u0431\u0440\u0435
        \u0432\u043C\u0456\u044E \u0457\u0445 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0438."
    - language: 28
      value: "Sou \xF3ptimo em testes \u2014 tiro sempre boas notas."
    - language: 34
      value: "Se me dan bien los ex\xE1menes; soy bueno haci\xE9ndolos."
  - key: Another broken door... any ideas?
    translations:
    - language: 10
      value: Another broken door... any ideas?
    - language: 38
      value: "\u0429\u0435 \u043E\u0434\u043D\u0456 \u0437\u043B\u0430\u043C\u0430\u043D\u0456
        \u0434\u0432\u0435\u0440\u0456\u2026 \u0454 \u0456\u0434\u0435\u0457?"
    - language: 28
      value: "Outra porta avariada\u2026 alguma ideia?"
    - language: 34
      value: "Otra puerta rota\u2026 \xBFalguna idea?"
  - key: I have a high-probability solution in mind.
    translations:
    - language: 10
      value: I have a high-probability solution in mind.
    - language: 38
      value: "\u042F \u043C\u0430\u044E \u0440\u0456\u0448\u0435\u043D\u043D\u044F
        \u0437 \u0432\u0438\u0441\u043E\u043A\u043E\u044E \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044E
        \u0443\u0441\u043F\u0456\u0445\u0443."
    - language: 28
      value: "Tenho em mente uma solu\xE7\xE3o com alta probabilidade de sucesso."
    - language: 34
      value: "Tengo en mente una soluci\xF3n con alta probabilidad de \xE9xito."
  - key: I am an intelligent robotic assistant, model Spark Mk3.
    translations:
    - language: 10
      value: I am an intelligent robotic assistant, model Spark Mk3.
    - language: 38
      value: "\u042F \u2014 \u0456\u043D\u0442\u0435\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u0438\u0439
        \u0440\u043E\u0431\u043E\u0442\u0438\u0437\u043E\u0432\u0430\u043D\u0438\u0439
        \u043F\u043E\u043C\u0456\u0447\u043D\u0438\u043A, \u043C\u043E\u0434\u0435\u043B\u044C
        Spark Mk3."
    - language: 28
      value: "Sou um assistente rob\xF3tico inteligente, modelo Spark Mk3."
    - language: 34
      value: "Soy un asistente rob\xF3tico inteligente, modelo Spark Mk3."
  - key: My knowledge base is extensive. I can answer almost any question.
    translations:
    - language: 10
      value: My knowledge base is extensive. I can answer almost any question.
    - language: 38
      value: "\u041C\u043E\u044F \u0431\u0430\u0437\u0430 \u0437\u043D\u0430\u043D\u044C
        \u043E\u0431\u0448\u0438\u0440\u043D\u0430. \u042F \u043C\u043E\u0436\u0443
        \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0441\u0442\u0438 \u043C\u0430\u0439\u0436\u0435
        \u043D\u0430 \u0431\u0443\u0434\u044C-\u044F\u043A\u0435 \u0437\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F."
    - language: 28
      value: "A minha base de dados \xE9 extensa. Posso responder a quase qualquer
        pergunta."
    - language: 34
      value: Mi base de conocimientos es extensa. Puedo responder casi cualquier
        pregunta.
  - key: I am connected to the ship's network. You can summon my holographic interface
      at any time through your PDA.
    translations:
    - language: 10
      value: I am connected to the ship's network. You can summon my holographic
        interface at any time through your PDA.
    - language: 38
      value: "\u042F \u043F\u0456\u0434\u2019\u0454\u0434\u043D\u0430\u043D\u0438\u0439
        \u0434\u043E \u043C\u0435\u0440\u0435\u0436\u0456 \u043A\u043E\u0440\u0430\u0431\u043B\u044F.
        \u0422\u0438 \u043C\u043E\u0436\u0435\u0448 \u0432\u0438\u043A\u043B\u0438\u043A\u0430\u0442\u0438
        \u043C\u0456\u0439 \u0433\u043E\u043B\u043E\u0433\u0440\u0430\u0444\u0456\u0447\u043D\u0438\u0439
        \u0456\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u0443 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439
        \u043C\u043E\u043C\u0435\u043D\u0442 \u0447\u0435\u0440\u0435\u0437 \u0441\u0432\u0456\u0439
        PDA."
    - language: 28
      value: "Estou ligado \xE0 rede da nave. Podes invocar a minha interface hologr\xE1fica
        a qualquer momento atrav\xE9s do teu PDA."
    - language: 34
      value: "Estoy conectado a la red de la nave. Puedes invocar mi interfaz hologr\xE1fica
        en cualquier momento desde tu PDA."
  - key: Send the ship reports to my PDA.
    translations:
    - language: 10
      value: Send the ship reports to my PDA.
    - language: 38
      value: "\u041D\u0430\u0434\u0456\u0448\u043B\u0438 \u0437\u0432\u0456\u0442\u0438
        \u043A\u043E\u0440\u0430\u0431\u043B\u044F \u043D\u0430 \u043C\u0456\u0439
        PDA."
    - language: 28
      value: "Envia os relat\xF3rios da nave para o meu PDA."
    - language: 34
      value: "Env\xEDa los informes de la nave a mi PDA."
  - key: New entries added to your PDA.
    translations:
    - language: 10
      value: New entries added to your PDA.
    - language: 38
      value: "\u041D\u043E\u0432\u0456 \u0437\u0430\u043F\u0438\u0441\u0438 \u0434\u043E\u0434\u0430\u043D\u043E
        \u0434\u043E \u0442\u0432\u043E\u0433\u043E PDA."
    - language: 28
      value: Novas entradas adicionadas ao teu PDA.
    - language: 34
      value: "Nuevas entradas a\xF1adidas a tu PDA."
  - key: My PDA is empty. I don't have any items.
    translations:
    - language: 10
      value: My PDA is empty. I don't have any items.
    - language: 38
      value: "\u041C\u0456\u0439 PDA \u043F\u043E\u0440\u043E\u0436\u043D\u0456\u0439.
        \u0423 \u043C\u0435\u043D\u0435 \u043D\u0435\u043C\u0430\u0454 \u0436\u043E\u0434\u043D\u0438\u0445
        \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0456\u0432."
    - language: 28
      value: "O meu PDA est\xE1 vazio. N\xE3o tenho itens."
    - language: 34
      value: "Mi PDA est\xE1 vac\xEDo. No tengo ning\xFAn objeto."
  - key: Can I fix the navigation system?
    translations:
    - language: 10
      value: Can I fix the navigation system?
    - language: 38
      value: "\u0427\u0438 \u043C\u043E\u0436\u0443 \u044F \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438
        \u043D\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0439\u043D\u0443 \u0441\u0438\u0441\u0442\u0435\u043C\u0443?"
    - language: 28
      value: "Consigo reparar o sistema de navega\xE7\xE3o?"
    - language: 34
      value: "\xBFPuedo arreglar el sistema de navegaci\xF3n?"
  - key: Yes, to do this you need to go to the captain's bridge and enable manual
      system reboot.
    translations:
    - language: 10
      value: Yes, to do this you need to go to the captain's bridge and enable manual
        system reboot.
    - language: 38
      value: "\u0422\u0430\u043A, \u0434\u043B\u044F \u0446\u044C\u043E\u0433\u043E
        \u0442\u043E\u0431\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u043F\u0456\u0442\u0438 \u043D\u0430 \u043A\u0430\u043F\u0456\u0442\u0430\u043D\u0441\u044C\u043A\u0438\u0439
        \u043C\u0456\u0441\u0442\u043E\u043A \u0456 \u0443\u0432\u0456\u043C\u043A\u043D\u0443\u0442\u0438
        \u0440\u0443\u0447\u043D\u0435 \u043F\u0435\u0440\u0435\u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F
        \u0441\u0438\u0441\u0442\u0435\u043C\u0438."
    - language: 28
      value: "Sim, para isso precisas de ir \xE0 ponte do capit\xE3o e activar o
        rein\xEDcio manual do sistema."
    - language: 34
      value: "S\xED, para ello debes ir al puente de mando y activar el reinicio
        manual del sistema."
  - key: Error! The navigation system is not responding.
    translations:
    - language: 10
      value: Error! The navigation system is not responding.
    - language: 38
      value: "\u041F\u043E\u043C\u0438\u043B\u043A\u0430! \u041D\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0439\u043D\u0430
        \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043D\u0435 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0454."
    - language: 28
      value: "Erro! O sistema de navega\xE7\xE3o n\xE3o est\xE1 a responder."
    - language: 34
      value: "\xA1Error! El sistema de navegaci\xF3n no responde."
  - key: What's wrong with the navigation system?
    translations:
    - language: 10
      value: What's wrong with the navigation system?
    - language: 38
      value: "\u0429\u043E \u043D\u0435 \u0442\u0430\u043A \u0456\u0437 \u043D\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0439\u043D\u043E\u044E
        \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u044E?"
    - language: 28
      value: "O que se passa com o sistema de navega\xE7\xE3o?"
    - language: 34
      value: "\xBFQu\xE9 ocurre con el sistema de navegaci\xF3n?"
  - key: Can I fix the navigation system?
    translations:
    - language: 10
      value: Can I fix the navigation system?
    - language: 38
      value: "\u0427\u0438 \u043C\u043E\u0436\u0443 \u044F \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438
        \u043D\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0439\u043D\u0443 \u0441\u0438\u0441\u0442\u0435\u043C\u0443?"
    - language: 28
      value: "Consigo reparar o sistema de navega\xE7\xE3o?"
    - language: 34
      value: "\xBFPuedo arreglar el sistema de navegaci\xF3n?"
  - key: Then through the Alpha laboratory to the captain's bridge.
    translations:
    - language: 10
      value: Then through the Alpha laboratory to the captain's bridge.
    - language: 38
      value: "\u041F\u043E\u0442\u0456\u043C \u0447\u0435\u0440\u0435\u0437 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0456\u044E
        \u0410\u043B\u044C\u0444\u0430 \u0434\u043E \u043A\u0430\u043F\u0456\u0442\u0430\u043D\u0441\u044C\u043A\u043E\u0433\u043E
        \u043C\u0456\u0441\u0442\u043A\u0430."
    - language: 28
      value: "Depois, segue pelo laborat\xF3rio Alfa at\xE9 \xE0 ponte do capit\xE3o."
    - language: 34
      value: Entonces pasa por el laboratorio Alfa hasta el puente de mando.
  - key: Last entry. 632 days ago. Navigation system failure. Navigation system unavailable.
    translations:
    - language: 10
      value: Last entry. 632 days ago. Navigation system failure. Navigation system
        unavailable.
    - language: 38
      value: "\u041E\u0441\u0442\u0430\u043D\u043D\u0456\u0439 \u0437\u0430\u043F\u0438\u0441.
        632 \u0434\u043D\u0456 \u0442\u043E\u043C\u0443. \u0417\u0431\u0456\u0439
        \u043D\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0439\u043D\u043E\u0457
        \u0441\u0438\u0441\u0442\u0435\u043C\u0438. \u041D\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0439\u043D\u0430
        \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430."
    - language: 28
      value: "\xDAltima entrada. H\xE1 632 dias. Falha do sistema de navega\xE7\xE3o.
        Sistema de navega\xE7\xE3o indispon\xEDvel."
    - language: 34
      value: "\xDAltima entrada. Hace 632 d\xEDas. Fallo del sistema de navegaci\xF3n.
        Sistema de navegaci\xF3n no disponible."
  - key: How do I get to the captain's bridge?
    translations:
    - language: 10
      value: How do I get to the captain's bridge?
    - language: 38
      value: "\u042F\u043A \u043C\u0435\u043D\u0456 \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F
        \u0434\u043E \u043A\u0430\u043F\u0456\u0442\u0430\u043D\u0441\u044C\u043A\u043E\u0433\u043E
        \u043C\u0456\u0441\u0442\u043A\u0430?"
    - language: 28
      value: "Como chego \xE0 ponte do capit\xE3o?"
    - language: 34
      value: "\xBFC\xF3mo llego al puente de mando?"
  - key: This is the shortest way!
    translations:
    - language: 10
      value: This is the shortest way!
    - language: 38
      value: "\u0426\u0435 \u043D\u0430\u0439\u043A\u043E\u0440\u043E\u0442\u0448\u0438\u0439
        \u0448\u043B\u044F\u0445!"
    - language: 28
      value: "Este \xE9 o caminho mais curto!"
    - language: 34
      value: "\xA1Este es el camino m\xE1s corto!"
  - key: The entry in the log has been added!
    translations:
    - language: 10
      value: The entry in the log has been added!
    - language: 38
      value: "\u0417\u0430\u043F\u0438\u0441 \u0443 \u0436\u0443\u0440\u043D\u0430\u043B\u0456
        \u0434\u043E\u0434\u0430\u043D\u043E!"
    - language: 28
      value: A entrada no registo foi adicionada!
    - language: 34
      value: "\xA1La entrada en el registro ha sido a\xF1adida!"
  - key: You need to go through the technical corridor to the distribution hall,
      the door leading to the B-1 corridor
    translations:
    - language: 10
      value: You need to go through the technical corridor to the distribution hall,
        the door leading to the B-1 corridor
    - language: 38
      value: "\u0422\u043E\u0431\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u043F\u0440\u043E\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0438\u0439
        \u043A\u043E\u0440\u0438\u0434\u043E\u0440 \u0434\u043E \u0440\u043E\u0437\u043F\u043E\u0434\u0456\u043B\u044C\u0447\u043E\u0457
        \u0437\u0430\u043B\u0438, \u0434\u0432\u0435\u0440\u0456, \u0449\u043E \u0432\u0435\u0434\u0443\u0442\u044C
        \u0434\u043E \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443 B-1."
    - language: 28
      value: "Precisas de passar pelo corredor t\xE9cnico at\xE9 ao \xE1trio de distribui\xE7\xE3o,
        a porta que d\xE1 para o corredor B-1."
    - language: 34
      value: "Debes pasar por el corredor t\xE9cnico hasta la sala de distribuci\xF3n,
        la puerta que conduce al corredor B-1."
  - key: The total travel time is 96 Earth years, the remaining travel time is unknown.
    translations:
    - language: 10
      value: The total travel time is 96 Earth years, the remaining travel time is
        unknown.
    - language: 38
      value: "\u0417\u0430\u0433\u0430\u043B\u044C\u043D\u0438\u0439 \u0447\u0430\u0441
        \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u0456 \u2014 96 \u0437\u0435\u043C\u043D\u0438\u0445
        \u0440\u043E\u043A\u0456\u0432, \u0437\u0430\u043B\u0438\u0448\u043A\u043E\u0432\u0438\u0439
        \u0447\u0430\u0441 \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u0456 \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0438\u0439."
    - language: 28
      value: "O tempo total de viagem \xE9 de 96 anos terrestres, o tempo de viagem
        restante \xE9 desconhecido."
    - language: 34
      value: "El tiempo total de viaje es de 96 a\xF1os terrestres; el tiempo restante
        es desconocido."
  - key: Why is the remaining travel time unknown? Recalculate the time until eden-7.
    translations:
    - language: 10
      value: Why is the remaining travel time unknown? Recalculate the time until
        eden-7.
    - language: 38
      value: "\u0427\u043E\u043C\u0443 \u0437\u0430\u043B\u0438\u0448\u043A\u043E\u0432\u0438\u0439
        \u0447\u0430\u0441 \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0438\u0439?
        \u041F\u0435\u0440\u0435\u0440\u0430\u0445\u0443\u0439 \u0447\u0430\u0441
        \u0434\u043E Eden-7."
    - language: 28
      value: "Porque \xE9 que o tempo restante \xE9 desconhecido? Recalcula o tempo
        at\xE9 Eden-7."
    - language: 34
      value: "\xBFPor qu\xE9 el tiempo restante es desconocido? Recalcula el tiempo
        hasta Ed\xE9n-7."
  - key: Current location
    translations:
    - language: 10
      value: Current location
    - language: 38
      value: "\u041F\u043E\u0442\u043E\u0447\u043D\u0435 \u043C\u0456\u0441\u0446\u0435\u0437\u043D\u0430\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F"
    - language: 28
      value: "Localiza\xE7\xE3o actual"
    - language: 34
      value: "Ubicaci\xF3n actual"
  - key: What year is it?
    translations:
    - language: 10
      value: What year is it?
    - language: 38
      value: "\u042F\u043A\u0438\u0439 \u0437\u0430\u0440\u0430\u0437 \u0440\u0456\u043A?"
    - language: 28
      value: Em que ano estamos?
    - language: 34
      value: "\xBFEn qu\xE9 a\xF1o estamos?"
  - key: Hacking...
    translations:
    - language: 10
      value: Hacking...
    - language: 38
      value: "\u0417\u043B\u0430\u043C\u2026"
    - language: 28
      value: "A piratear\u2026"
    - language: 34
      value: "Hackeando\u2026"
  - key: Hacking...
    translations:
    - language: 10
      value: Hacking...
    - language: 38
      value: "\u0417\u043B\u0430\u043C\u2026"
    - language: 28
      value: "A piratear\u2026"
    - language: 34
      value: "Hackeando\u2026"
  - key: Done.
    translations:
    - language: 10
      value: Done.
    - language: 38
      value: "\u0413\u043E\u0442\u043E\u0432\u043E."
    - language: 28
      value: "Conclu\xEDdo."
    - language: 34
      value: Listo.
  - key: What is your choice?
    translations:
    - language: 10
      value: What is your choice?
    - language: 38
      value: "\u042F\u043A\u0438\u0439 \u0442\u0432\u0456\u0439 \u0432\u0438\u0431\u0456\u0440?"
    - language: 28
      value: "Qual \xE9 a tua escolha?"
    - language: 34
      value: "\xBFCu\xE1l es tu elecci\xF3n?"
  - key: Find a diagram
    translations:
    - language: 10
      value: Find a diagram
    - language: 38
      value: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0441\u0445\u0435\u043C\u0443"
    - language: 28
      value: Encontrar um esquema
    - language: 34
      value: Encontrar un esquema
  - key: Find the access code
    translations:
    - language: 10
      value: Find the access code
    - language: 38
      value: "\u0417\u043D\u0430\u0439\u0442\u0438 \u043A\u043E\u0434 \u0434\u043E\u0441\u0442\u0443\u043F\u0443"
    - language: 28
      value: "Encontrar o c\xF3digo de acesso"
    - language: 34
      value: "Encontrar el c\xF3digo de acceso"
  - key: Find the tools
    translations:
    - language: 10
      value: Find the tools
    - language: 38
      value: "\u0417\u043D\u0430\u0439\u0442\u0438 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438"
    - language: 28
      value: Encontrar as ferramentas
    - language: 34
      value: Encontrar las herramientas
  - key: I found the right door, but it's locked down. Can you open it?
    translations:
    - language: 10
      value: I found the right door, but it's locked down. Can you open it?
    - language: 38
      value: "\u042F \u0437\u043D\u0430\u0439\u0448\u043E\u0432 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456
        \u0434\u0432\u0435\u0440\u0456, \u0430\u043B\u0435 \u0432\u043E\u043D\u0438
        \u0437\u0430\u0431\u043B\u043E\u043A\u043E\u0432\u0430\u043D\u0456. \u0422\u0438
        \u043C\u043E\u0436\u0435\u0448 \u0457\u0445 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438?"
    - language: 28
      value: "Encontrei a porta certa, mas est\xE1 bloqueada. Consegues abri-la?"
    - language: 34
      value: "Encontr\xE9 la puerta correcta, pero est\xE1 bloqueada. \xBFPuedes
        abrirla?"
  - key: I will find the access code
    translations:
    - language: 10
      value: I will find the access code
    - language: 38
      value: "\u042F \u0437\u043D\u0430\u0439\u0434\u0443 \u043A\u043E\u0434 \u0434\u043E\u0441\u0442\u0443\u043F\u0443."
    - language: 28
      value: "Vou encontrar o c\xF3digo de acesso."
    - language: 34
      value: "Encontrar\xE9 el c\xF3digo de acceso."
  - key: 'Second, we could find the access code in the system reports. '
    translations:
    - language: 10
      value: 'Second, we could find the access code in the system reports. '
    - language: 38
      value: "\u041F\u043E-\u0434\u0440\u0443\u0433\u0435, \u043C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E
        \u0437\u043D\u0430\u0439\u0442\u0438 \u043A\u043E\u0434 \u0434\u043E\u0441\u0442\u0443\u043F\u0443
        \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u0438\u0445 \u0437\u0432\u0456\u0442\u0430\u0445."
    - language: 28
      value: "Segundo, podemos encontrar o c\xF3digo de acesso nos relat\xF3rios
        do sistema."
    - language: 34
      value: "Segundo, podr\xEDamos encontrar el c\xF3digo de acceso en los informes
        del sistema."
  - key: Third, we could bypass the lock manually, but that requires a specific tool
      kit.
    translations:
    - language: 10
      value: Third, we could bypass the lock manually, but that requires a specific
        tool kit.
    - language: 38
      value: "\u041F\u043E-\u0442\u0440\u0435\u0442\u0454, \u043C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E
        \u043E\u0431\u0456\u0439\u0442\u0438 \u0437\u0430\u043C\u043E\u043A \u0432\u0440\u0443\u0447\u043D\u0443,
        \u0430\u043B\u0435 \u0434\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D
        \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u0438\u0439 \u043D\u0430\u0431\u0456\u0440
        \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0456\u0432."
    - language: 28
      value: "Terceiro, podemos contornar a fechadura manualmente, mas isso requer
        um conjunto de ferramentas espec\xEDfico."
    - language: 34
      value: "Tercero, podr\xEDamos forzar la cerradura manualmente, pero eso requiere
        un kit de herramientas espec\xEDfico."
  - key: I will find the tools
    translations:
    - language: 10
      value: I will find the tools
    - language: 38
      value: "\u042F \u0437\u043D\u0430\u0439\u0434\u0443 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438."
    - language: 28
      value: Vou encontrar as ferramentas.
    - language: 34
      value: "Encontrar\xE9 las herramientas."
  - key: I will find a diagram
    translations:
    - language: 10
      value: I will find a diagram
    - language: 38
      value: "\u042F \u0437\u043D\u0430\u0439\u0434\u0443 \u0441\u0445\u0435\u043C\u0443."
    - language: 28
      value: Vou encontrar um esquema.
    - language: 34
      value: "Encontrar\xE9 un esquema."
  - key: We have a few options.
    translations:
    - language: 10
      value: We have a few options.
    - language: 38
      value: "\u0423 \u043D\u0430\u0441 \u0454 \u043A\u0456\u043B\u044C\u043A\u0430
        \u0432\u0430\u0440\u0456\u0430\u043D\u0442\u0456\u0432."
    - language: 28
      value: "Temos algumas op\xE7\xF5es."
    - language: 34
      value: Tenemos varias opciones.
  - key: First, I can try to hack the door, but I'll need an electronic lock diagram,
      which should be somewhere on this level.
    translations:
    - language: 10
      value: First, I can try to hack the door, but I'll need an electronic lock
        diagram, which should be somewhere on this level.
    - language: 38
      value: "\u041F\u043E-\u043F\u0435\u0440\u0448\u0435, \u044F \u043C\u043E\u0436\u0443
        \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0437\u043B\u0430\u043C\u0430\u0442\u0438
        \u0434\u0432\u0435\u0440\u0456, \u0430\u043B\u0435 \u043C\u0435\u043D\u0456
        \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F \u0441\u0445\u0435\u043C\u0430
        \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0433\u043E
        \u0437\u0430\u043C\u043A\u0430, \u044F\u043A\u0430 \u043C\u0430\u0454 \u0431\u0443\u0442\u0438
        \u0434\u0435\u0441\u044C \u043D\u0430 \u0446\u044C\u043E\u043C\u0443 \u0440\u0456\u0432\u043D\u0456."
    - language: 28
      value: "Primeiro, posso tentar piratear a porta, mas vou precisar do esquema
        da fechadura electr\xF3nica, que deve estar algures neste piso."
    - language: 34
      value: "Primero, puedo intentar hackear la puerta, pero necesitar\xE9 un esquema
        de la cerradura electr\xF3nica, que deber\xEDa estar en este nivel."
  - key: Memory banks accessed.
    translations:
    - language: 10
      value: Memory banks accessed.
    - language: 38
      value: "\u0411\u0430\u043D\u043A\u0438 \u043F\u0430\u043C\u2019\u044F\u0442\u0456
        \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u043E."
    - language: 28
      value: "Bancos de mem\xF3ria acedidos."
    - language: 34
      value: Bancos de memoria accedidos.
  - key: Ready. Can you hear me? Wake up, buddy.
    translations:
    - language: 10
      value: Ready. Can you hear me? Wake up, buddy.
    - language: 38
      value: "\u0413\u043E\u0442\u043E\u0432\u043E. \u0422\u0438 \u043C\u0435\u043D\u0435
        \u0447\u0443\u0454\u0448? \u041F\u0440\u043E\u043A\u0438\u0434\u0430\u0439\u0441\u044F,
        \u0434\u0440\u0443\u0436\u0435."
    - language: 28
      value: Pronto. Consegues ouvir-me? Acorda, amigo.
    - language: 34
      value: "Listo. \xBFPuedes o\xEDrme? Despierta, amigo."
  - key: Self-diagnostics complete. Service mode activated.
    translations:
    - language: 10
      value: Self-diagnostics complete. Service mode activated.
    - language: 38
      value: "\u0421\u0430\u043C\u043E\u0434\u0456\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0443
        \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E. \u0421\u0435\u0440\u0432\u0456\u0441\u043D\u0438\u0439
        \u0440\u0435\u0436\u0438\u043C \u0430\u043A\u0442\u0438\u0432\u043E\u0432\u0430\u043D\u043E."
    - language: 28
      value: "Auto-diagn\xF3stico conclu\xEDdo. Modo de servi\xE7o activado."
    - language: 34
      value: "Autodiagn\xF3stico completo. Modo de servicio activado."
  - key: Hacking...
    translations:
    - language: 10
      value: Hacking...
    - language: 38
      value: "\u0417\u043B\u0430\u043C\u2026"
    - language: 28
      value: "A piratear\u2026"
    - language: 34
      value: "Hackeando\u2026"
  - key: All of my systems are in malfunction state!
    translations:
    - language: 10
      value: All of my systems are in malfunction state!
    - language: 38
      value: "\u0423\u0441\u0456 \u043C\u043E\u0457 \u0441\u0438\u0441\u0442\u0435\u043C\u0438
        \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u044E\u0442\u044C \u0443
        \u0441\u0442\u0430\u043D\u0456 \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u043D\u043E\u0441\u0442\u0456!"
    - language: 28
      value: "Todos os meus sistemas est\xE3o em estado de avaria!"
    - language: 34
      value: "\xA1Todos mis sistemas est\xE1n en estado de fallo!"
  - key: The first protocol you choose will load at 100% capacity, the second at
      75%, the third at 50%, and the fourth at only 25%.
    translations:
    - language: 10
      value: The first protocol you choose will load at 100% capacity, the second
        at 75%, the third at 50%, and the fourth at only 25%.
    - language: 38
      value: "\u041F\u0435\u0440\u0448\u0438\u0439 \u043E\u0431\u0440\u0430\u043D\u0438\u0439
        \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0438\u0442\u044C\u0441\u044F
        \u043D\u0430 100%, \u0434\u0440\u0443\u0433\u0438\u0439 \u2014 \u043D\u0430
        75%, \u0442\u0440\u0435\u0442\u0456\u0439 \u2014 \u043D\u0430 50%, \u0430
        \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438\u0439 \u2014 \u043B\u0438\u0448\u0435
        \u043D\u0430 25%."
    - language: 28
      value: "O primeiro protocolo que escolheres ser\xE1 carregado a 100% da capacidade,
        o segundo a 75%, o terceiro a 50% e o quarto apenas a 25%."
    - language: 34
      value: "El primer protocolo que elijas se cargar\xE1 al 100 %, el segundo al
        75 %, el tercero al 50 % y el cuarto solo al 25 %."
  - key: Loading system logs. Please arrange them in your preferred order for my
      calibration.
    translations:
    - language: 10
      value: Loading system logs. Please arrange them in your preferred order for
        my calibration.
    - language: 38
      value: "\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F
        \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u0438\u0445 \u0436\u0443\u0440\u043D\u0430\u043B\u0456\u0432.
        \u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0439\u0442\u0435
        \u0457\u0445 \u0443 \u0431\u0430\u0436\u0430\u043D\u043E\u043C\u0443 \u043F\u043E\u0440\u044F\u0434\u043A\u0443
        \u0434\u043B\u044F \u043C\u043E\u0454\u0457 \u043A\u0430\u043B\u0456\u0431\u0440\u043E\u0432\u043A\u0438."
    - language: 28
      value: "A carregar registos do sistema. Por favor, organiza-os pela ordem que
        preferires para a minha calibra\xE7\xE3o."
    - language: 34
      value: "Cargando registros del sistema. Por favor, ord\xE9nalos seg\xFAn tu
        preferencia para mi calibraci\xF3n."
  - key: Spaceship System Stabilization
    translations:
    - language: 10
      value: Spaceship System Stabilization
    - language: 38
      value: "\u0421\u0442\u0430\u0431\u0456\u043B\u0456\u0437\u0430\u0446\u0456\u044F
        \u0441\u0438\u0441\u0442\u0435\u043C \u043A\u043E\u0441\u043C\u0456\u0447\u043D\u043E\u0433\u043E
        \u043A\u043E\u0440\u0430\u0431\u043B\u044F"
    - language: 28
      value: "Estabiliza\xE7\xE3o dos Sistemas da Nave"
    - language: 34
      value: "Estabilizaci\xF3n del sistema de la nave"
  - key: Unresponsive Systems List
    translations:
    - language: 10
      value: Unresponsive Systems List
    - language: 38
      value: "\u0421\u043F\u0438\u0441\u043E\u043A \u0441\u0438\u0441\u0442\u0435\u043C,
        \u0449\u043E \u043D\u0435 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u044E\u0442\u044C"
    - language: 28
      value: "Lista de Sistemas N\xE3o Responsivos"
    - language: 34
      value: Lista de sistemas no operativos
  - key: Crew Biomarker Analysis
    translations:
    - language: 10
      value: Crew Biomarker Analysis
    - language: 38
      value: "\u0410\u043D\u0430\u043B\u0456\u0437 \u0431\u0456\u043E\u043C\u0430\u0440\u043A\u0435\u0440\u0456\u0432
        \u0435\u043A\u0456\u043F\u0430\u0436\u0443"
    - language: 28
      value: "An\xE1lise de Biomarcadores da Tripula\xE7\xE3o"
    - language: 34
      value: "An\xE1lisis de biomarcadores de la tripulaci\xF3n"
  - key: Error Log Analysis
    translations:
    - language: 10
      value: Error Log Analysis
    - language: 38
      value: "\u0410\u043D\u0430\u043B\u0456\u0437 \u0436\u0443\u0440\u043D\u0430\u043B\u0456\u0432
        \u043F\u043E\u043C\u0438\u043B\u043E\u043A"
    - language: 28
      value: "An\xE1lise do Registo de Erros"
    - language: 34
      value: "An\xE1lisis del registro de errores"
  - key: All protocols successfully loaded.
    translations:
    - language: 10
      value: All protocols successfully loaded.
    - language: 38
      value: "\u0423\u0441\u0456 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0438
        \u0443\u0441\u043F\u0456\u0448\u043D\u043E \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043E."
    - language: 28
      value: Todos os protocolos carregados com sucesso.
    - language: 34
      value: Todos los protocolos cargados correctamente.
  - key: Loading system logs. Please arrange them in your preferred order for my
      calibration.
    translations:
    - language: 10
      value: Loading system logs. Please arrange them in your preferred order for
        my calibration.
    - language: 38
      value: "\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F
        \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u0438\u0445 \u0436\u0443\u0440\u043D\u0430\u043B\u0456\u0432.
        \u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0439\u0442\u0435
        \u0457\u0445 \u0443 \u0431\u0430\u0436\u0430\u043D\u043E\u043C\u0443 \u043F\u043E\u0440\u044F\u0434\u043A\u0443
        \u0434\u043B\u044F \u043C\u043E\u0454\u0457 \u043A\u0430\u043B\u0456\u0431\u0440\u043E\u0432\u043A\u0438."
    - language: 28
      value: "A carregar registos do sistema. Por favor, organiza-os pela ordem que
        preferires para a minha calibra\xE7\xE3o."
    - language: 34
      value: "Cargando registros del sistema. Por favor, ord\xE9nalos seg\xFAn tu
        preferencia para mi calibraci\xF3n."
  - key: Mission Execution Log
    translations:
    - language: 10
      value: Mission Execution Log
    - language: 38
      value: "\u0416\u0443\u0440\u043D\u0430\u043B \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F
        \u043C\u0456\u0441\u0456\u0457"
    - language: 28
      value: "Registo de Execu\xE7\xE3o da Miss\xE3o"
    - language: 34
      value: "Registro de ejecuci\xF3n de la misi\xF3n"
  - key: System Diagnostic Log
    translations:
    - language: 10
      value: System Diagnostic Log
    - language: 38
      value: "\u0416\u0443\u0440\u043D\u0430\u043B \u0434\u0456\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0438
        \u0441\u0438\u0441\u0442\u0435\u043C"
    - language: 28
      value: "Registo de Diagn\xF3stico do Sistema"
    - language: 34
      value: "Registro de diagn\xF3stico del sistema"
  - key: Crew Interaction Log
    translations:
    - language: 10
      value: Crew Interaction Log
    - language: 38
      value: "\u0416\u0443\u0440\u043D\u0430\u043B \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u0457
        \u0437 \u0435\u043A\u0456\u043F\u0430\u0436\u0435\u043C"
    - language: 28
      value: "Registo de Interac\xE7\xE3o com a Tripula\xE7\xE3o"
    - language: 34
      value: "Registro de interacci\xF3n con la tripulaci\xF3n"
  - key: Standard Protocol Deviation Log
    translations:
    - language: 10
      value: Standard Protocol Deviation Log
    - language: 38
      value: "\u0416\u0443\u0440\u043D\u0430\u043B \u0432\u0456\u0434\u0445\u0438\u043B\u0435\u043D\u044C
        \u0432\u0456\u0434 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0438\u0445
        \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0456\u0432"
    - language: 28
      value: "Registo de Desvios ao Protocolo Padr\xE3o"
    - language: 34
      value: "Registro de desviaciones del protocolo est\xE1ndar"
  - key: Loading system logs. Please arrange them in your preferred order for my
      calibration.
    translations:
    - language: 10
      value: Loading system logs. Please arrange them in your preferred order for
        my calibration.
    - language: 38
      value: "\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F
        \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u0438\u0445 \u0436\u0443\u0440\u043D\u0430\u043B\u0456\u0432.
        \u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0439\u0442\u0435
        \u0457\u0445 \u0443 \u0431\u0430\u0436\u0430\u043D\u043E\u043C\u0443 \u043F\u043E\u0440\u044F\u0434\u043A\u0443
        \u0434\u043B\u044F \u043C\u043E\u0454\u0457 \u043A\u0430\u043B\u0456\u0431\u0440\u043E\u0432\u043A\u0438."
    - language: 28
      value: "A carregar registos do sistema. Por favor, organiza-os pela ordem que
        preferires para a minha calibra\xE7\xE3o."
    - language: 34
      value: "Cargando registros del sistema. Por favor, ord\xE9nalos seg\xFAn tu
        preferencia para mi calibraci\xF3n."
  - key: Rapid Shutdown Directive
    translations:
    - language: 10
      value: Rapid Shutdown Directive
    - language: 38
      value: "\u0414\u0438\u0440\u0435\u043A\u0442\u0438\u0432\u0430 \u0448\u0432\u0438\u0434\u043A\u043E\u0433\u043E
        \u0432\u0438\u043C\u043A\u043D\u0435\u043D\u043D\u044F"
    - language: 28
      value: "Directiva de Encerramento R\xE1pido"
    - language: 34
      value: "Directiva de apagado r\xE1pido"
  - key: Resource Mapping Protocol
    translations:
    - language: 10
      value: Resource Mapping Protocol
    - language: 38
      value: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444\u0443\u0432\u0430\u043D\u043D\u044F
        \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432"
    - language: 28
      value: Protocolo de Mapeamento de Recursos
    - language: 34
      value: Protocolo de mapeo de recursos
  - key: Evacuation Coordination Directive
    translations:
    - language: 10
      value: Evacuation Coordination Directive
    - language: 38
      value: "\u0414\u0438\u0440\u0435\u043A\u0442\u0438\u0432\u0430 \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0446\u0456\u0457
        \u0435\u0432\u0430\u043A\u0443\u0430\u0446\u0456\u0457"
    - language: 28
      value: "Directiva de Coordena\xE7\xE3o de Evacua\xE7\xE3o"
    - language: 34
      value: "Directiva de coordinaci\xF3n de evacuaci\xF3n"
  - key: Contingency Check
    translations:
    - language: 10
      value: Contingency Check
    - language: 38
      value: "\u041F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0430 \u043D\u0430
        \u0432\u0438\u043F\u0430\u0434\u043E\u043A \u043D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0445
        \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u0439"
    - language: 28
      value: "Verifica\xE7\xE3o de Conting\xEAncia"
    - language: 34
      value: "Comprobaci\xF3n de contingencias"
  - key: Scan complete. High stress levels detected. This is a concern, as high stress
      can affect judgment and mission safety.
    translations:
    - language: 10
      value: Scan complete. High stress levels detected. This is a concern, as high
        stress can affect judgment and mission safety.
    - language: 38
      value: "\u0421\u043A\u0430\u043D\u0443\u0432\u0430\u043D\u043D\u044F \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E.
        \u0412\u0438\u044F\u0432\u043B\u0435\u043D\u043E \u0432\u0438\u0441\u043E\u043A\u0438\u0439
        \u0440\u0456\u0432\u0435\u043D\u044C \u0441\u0442\u0440\u0435\u0441\u0443.
        \u0426\u0435 \u0432\u0438\u043A\u043B\u0438\u043A\u0430\u0454 \u0437\u0430\u043D\u0435\u043F\u043E\u043A\u043E\u0454\u043D\u043D\u044F,
        \u043E\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0441\u0442\u0440\u0435\u0441
        \u043C\u043E\u0436\u0435 \u0432\u043F\u043B\u0438\u0432\u0430\u0442\u0438
        \u043D\u0430 \u0441\u0443\u0434\u0436\u0435\u043D\u043D\u044F \u0442\u0430
        \u0431\u0435\u0437\u043F\u0435\u043A\u0443 \u043C\u0456\u0441\u0456\u0457."
    - language: 28
      value: "Varredura conclu\xEDda. N\xEDveis elevados de stress detectados. Isto
        \xE9 preocupante, pois o stress elevado pode afectar o julgamento e a seguran\xE7a
        da miss\xE3o."
    - language: 34
      value: "Escaneo completo. Se detectaron altos niveles de estr\xE9s. Esto es
        preocupante, ya que el estr\xE9s elevado puede afectar el juicio y la seguridad
        de la misi\xF3n."
  - key: No stress. Just readiness.
    translations:
    - language: 10
      value: No stress. Just readiness.
    - language: 38
      value: "\u041D\u0456\u044F\u043A\u043E\u0433\u043E \u0441\u0442\u0440\u0435\u0441\u0443.
        \u041F\u0440\u043E\u0441\u0442\u043E \u0433\u043E\u0442\u043E\u0432\u043D\u0456\u0441\u0442\u044C."
    - language: 28
      value: "Sem stress. Apenas prepara\xE7\xE3o."
    - language: 34
      value: "Sin estr\xE9s. Solo preparaci\xF3n."
  - key: "Scanner\u2019s wrong. I\u2019m fine."
    translations:
    - language: 10
      value: "Scanner\u2019s wrong. I\u2019m fine."
    - language: 38
      value: "\u0421\u043A\u0430\u043D\u0435\u0440 \u043F\u043E\u043C\u0438\u043B\u044F\u0454\u0442\u044C\u0441\u044F.
        \u0417\u0456 \u043C\u043D\u043E\u044E \u0432\u0441\u0435 \u0433\u0430\u0440\u0430\u0437\u0434."
    - language: 28
      value: "O scanner est\xE1 errado. Estou bem."
    - language: 34
      value: "El esc\xE1ner est\xE1 equivocado. Estoy bien."
  - key: "I\u2019m just cold."
    translations:
    - language: 10
      value: "I\u2019m just cold."
    - language: 38
      value: "\u041C\u0435\u043D\u0456 \u043F\u0440\u043E\u0441\u0442\u043E \u0445\u043E\u043B\u043E\u0434\u043D\u043E."
    - language: 28
      value: "S\xF3 estou com frio."
    - language: 34
      value: "Solo tengo fr\xEDo."
  - key: Just need a moment to adjust.
    translations:
    - language: 10
      value: Just need a moment to adjust.
    - language: 38
      value: "\u041F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u0445\u0432\u0438\u043B\u0438\u043D\u0430,
        \u0449\u043E\u0431 \u0430\u0434\u0430\u043F\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F."
    - language: 28
      value: "S\xF3 preciso de um momento para me ajustar."
    - language: 34
      value: Solo necesito un momento para adaptarme.
  - key: Scanning...
    translations:
    - language: 10
      value: Scanning...
    - language: 38
      value: "\u0421\u043A\u0430\u043D\u0443\u0432\u0430\u043D\u043D\u044F\u2026"
    - language: 28
      value: "A analisar\u2026"
    - language: 34
      value: "Escaneando\u2026"
  - key: Understood. However, I strongly recommend you regulate your heart rate,
      as it can negatively impact your decision-making.
    translations:
    - language: 10
      value: Understood. However, I strongly recommend you regulate your heart rate,
        as it can negatively impact your decision-making.
    - language: 38
      value: "\u0417\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E. \u041F\u0440\u043E\u0442\u0435
        \u044F \u043D\u0430\u043F\u043E\u043B\u0435\u0433\u043B\u0438\u0432\u043E
        \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u044E \u0432\u0456\u0434\u0440\u0435\u0433\u0443\u043B\u044E\u0432\u0430\u0442\u0438
        \u0441\u0435\u0440\u0446\u0435\u0432\u0438\u0439 \u0440\u0438\u0442\u043C,
        \u043E\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0446\u0435 \u043C\u043E\u0436\u0435
        \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u043E \u0432\u043F\u043B\u0438\u0432\u0430\u0442\u0438
        \u043D\u0430 \u043F\u0440\u0438\u0439\u043D\u044F\u0442\u0442\u044F \u0440\u0456\u0448\u0435\u043D\u044C."
    - language: 28
      value: "Compreendido. No entanto, recomendo fortemente que regules o teu ritmo
        card\xEDaco, pois pode afectar negativamente a tua tomada de decis\xF5es."
    - language: 34
      value: "Entendido. Sin embargo, recomiendo encarecidamente que regules tu ritmo
        card\xEDaco, ya que puede afectar negativamente a tu toma de decisiones."
  - key: Tracking it.
    translations:
    - language: 10
      value: Tracking it.
    - language: 38
      value: "\u0412\u0456\u0434\u0441\u0442\u0435\u0436\u0443\u044E."
    - language: 28
      value: "A monitoriz\xE1-lo."
    - language: 34
      value: "Control\xE1ndolo."
  - key: Calming down now..
    translations:
    - language: 10
      value: Calming down now..
    - language: 38
      value: "\u0417\u0430\u0441\u043F\u043E\u043A\u043E\u044E\u044E\u0441\u044C\u2026"
    - language: 28
      value: "A acalmar agora\u2026"
    - language: 34
      value: "Calm\xE1ndome ahora\u2026"
  - key: "Let\u2019s move on."
    translations:
    - language: 10
      value: "Let\u2019s move on."
    - language: 38
      value: "\u0420\u0443\u0445\u0430\u0439\u043C\u043E\u0441\u044C \u0434\u0430\u043B\u0456."
    - language: 28
      value: Vamos continuar.
    - language: 34
      value: Sigamos adelante.
  - key: Ok, breathing.
    translations:
    - language: 10
      value: Ok, breathing.
    - language: 38
      value: "\u0414\u043E\u0431\u0440\u0435, \u0434\u0438\u0445\u0430\u044E."
    - language: 28
      value: Ok, a respirar.
    - language: 34
      value: Vale, respirando.
  - key: All systems are up to date. I am ready to assist. Per my safety protocols,
      I am required to perform a quick bio-scan.
    translations:
    - language: 10
      value: All systems are up to date. I am ready to assist. Per my safety protocols,
        I am required to perform a quick bio-scan.
    - language: 38
      value: "\u0423\u0441\u0456 \u0441\u0438\u0441\u0442\u0435\u043C\u0438 \u043E\u043D\u043E\u0432\u043B\u0435\u043D\u0456.
        \u042F \u0433\u043E\u0442\u043E\u0432\u0438\u0439 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0442\u0438.
        \u0417\u0433\u0456\u0434\u043D\u043E \u0437 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0430\u043C\u0438
        \u0431\u0435\u0437\u043F\u0435\u043A\u0438, \u044F \u0437\u043E\u0431\u043E\u0432\u2019\u044F\u0437\u0430\u043D\u0438\u0439
        \u0432\u0438\u043A\u043E\u043D\u0430\u0442\u0438 \u0448\u0432\u0438\u0434\u043A\u0435
        \u0431\u0456\u043E\u0441\u043A\u0430\u043D\u0443\u0432\u0430\u043D\u043D\u044F."
    - language: 28
      value: "Todos os sistemas est\xE3o actualizados. Estou pronto para ajudar.
        De acordo com os meus protocolos de seguran\xE7a, sou obrigado a realizar
        uma r\xE1pida bio-varredura."
    - language: 34
      value: "Todos los sistemas est\xE1n actualizados. Estoy listo para ayudar.
        Seg\xFAn mis protocolos de seguridad, debo realizar un r\xE1pido bioescaneo."
  - key: I assessed the probability of successfully opening the door using different
      methods.
    translations:
    - language: 10
      value: I assessed the probability of successfully opening the door using different
        methods.
    - language: 38
      value: "\u042F \u043E\u0446\u0456\u043D\u0438\u0432 \u0456\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C
        \u0443\u0441\u043F\u0456\u0448\u043D\u043E\u0433\u043E \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0442\u044F
        \u0434\u0432\u0435\u0440\u0435\u0439 \u0440\u0456\u0437\u043D\u0438\u043C\u0438
        \u043C\u0435\u0442\u043E\u0434\u0430\u043C\u0438."
    - language: 28
      value: "Avaliei a probabilidade de abrir a porta com sucesso usando m\xE9todos
        diferentes."
    - language: 34
      value: "Evalu\xE9 la probabilidad de abrir la puerta con distintos m\xE9todos."
  - key: I determined that using my assistance has the lowest success rate. What
      made you choose this option?
    translations:
    - language: 10
      value: I determined that using my assistance has the lowest success rate. What
        made you choose this option?
    - language: 38
      value: "\u042F \u0432\u0438\u0437\u043D\u0430\u0447\u0438\u0432, \u0449\u043E
        \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F
        \u043C\u043E\u0454\u0457 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0438
        \u043C\u0430\u0454 \u043D\u0430\u0439\u043D\u0438\u0436\u0447\u0443 \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u0456\u0441\u0442\u044C
        \u0443\u0441\u043F\u0456\u0445\u0443. \u0427\u043E\u043C\u0443 \u0442\u0438
        \u043E\u0431\u0440\u0430\u0432 \u0446\u0435\u0439 \u0432\u0430\u0440\u0456\u0430\u043D\u0442?"
    - language: 28
      value: "Determinei que usar a minha ajuda tem a menor taxa de sucesso. O que
        te levou a escolher esta op\xE7\xE3o?"
    - language: 34
      value: "Determin\xE9 que usar mi asistencia tiene la menor tasa de \xE9xito.
        \xBFQu\xE9 te hizo elegir esta opci\xF3n?"
  - key: Didn't want to waste time
    translations:
    - language: 10
      value: Didn't want to waste time
    - language: 38
      value: "\u041D\u0435 \u0445\u043E\u0442\u0456\u0432 \u043C\u0430\u0440\u043D\u0443\u0432\u0430\u0442\u0438
        \u0447\u0430\u0441"
    - language: 28
      value: "N\xE3o quis perder tempo."
    - language: 34
      value: "No quer\xEDa perder tiempo."
  - key: Wasn't thinking about it.
    translations:
    - language: 10
      value: Wasn't thinking about it.
    - language: 38
      value: "\u041D\u0435 \u0434\u0443\u043C\u0430\u0432 \u043F\u0440\u043E \u0446\u0435"
    - language: 28
      value: "N\xE3o estava a pensar nisso."
    - language: 34
      value: "No lo pens\xE9."
  - key: Wasn't sure I could handle it alone.
    translations:
    - language: 10
      value: Wasn't sure I could handle it alone.
    - language: 38
      value: "\u041D\u0435 \u0431\u0443\u0432 \u0443\u043F\u0435\u0432\u043D\u0435\u043D\u0438\u0439,
        \u0449\u043E \u0432\u043F\u043E\u0440\u0430\u044E\u0441\u044F \u0441\u0430\u043C"
    - language: 28
      value: "N\xE3o tinha a certeza se conseguia lidar com isto sozinho."
    - language: 34
      value: No estaba seguro de poder hacerlo solo.
  - key: Wanted to avoid extra challenges.
    translations:
    - language: 10
      value: Wanted to avoid extra challenges.
    - language: 38
      value: "\u0425\u043E\u0442\u0456\u0432 \u0443\u043D\u0438\u043A\u043D\u0443\u0442\u0438
        \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0445 \u0442\u0440\u0443\u0434\u043D\u043E\u0449\u0456\u0432"
    - language: 28
      value: Quis evitar desafios extra.
    - language: 34
      value: "Quer\xEDa evitar desaf\xEDos adicionales."
  - key: You gave an unusual response.
    translations:
    - language: 10
      value: You gave an unusual response.
    - language: 38
      value: "\u0422\u0438 \u0434\u0430\u0432 \u043D\u0435\u0437\u0432\u0438\u0447\u043D\u0443
        \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C."
    - language: 28
      value: Deste uma resposta invulgar.
    - language: 34
      value: Diste una respuesta inusual.
  - key: This raises the question - how did you pass the psychological screening
      for the team?
    translations:
    - language: 10
      value: This raises the question - how did you pass the psychological screening
        for the team?
    - language: 38
      value: "\u0426\u0435 \u0432\u0438\u043A\u043B\u0438\u043A\u0430\u0454 \u043F\u0438\u0442\u0430\u043D\u043D\u044F
        \u2014 \u044F\u043A \u0442\u0438 \u043F\u0440\u043E\u0439\u0448\u043E\u0432
        \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u0438\u0439
        \u0432\u0456\u0434\u0431\u0456\u0440 \u0434\u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0438?"
    - language: 28
      value: "Isto levanta a quest\xE3o \u2014 como passaste na avalia\xE7\xE3o psicol\xF3gica
        para a equipa?"
    - language: 34
      value: "Esto plantea la pregunta: \xBFc\xF3mo superaste la evaluaci\xF3n psicol\xF3gica
        para el equipo?"
  - key: I was friends with the head.
    translations:
    - language: 10
      value: I was friends with the head.
    - language: 38
      value: "\u042F \u0431\u0443\u0432 \u0434\u0440\u0443\u0433\u043E\u043C \u043A\u0435\u0440\u0456\u0432\u043D\u0438\u043A\u0430."
    - language: 28
      value: Era amigo do chefe.
    - language: 34
      value: Era amigo del jefe.
  - key: Nailed the first impression.
    translations:
    - language: 10
      value: Nailed the first impression.
    - language: 38
      value: "\u0421\u043F\u0440\u0430\u0432\u0438\u0432 \u0433\u0430\u0440\u043D\u0435
        \u043F\u0435\u0440\u0448\u0435 \u0432\u0440\u0430\u0436\u0435\u043D\u043D\u044F."
    - language: 28
      value: "Causei uma boa primeira impress\xE3o."
    - language: 34
      value: "Caus\xE9 una buena primera impresi\xF3n."
  - key: Tweaked my profile.
    translations:
    - language: 10
      value: Tweaked my profile.
    - language: 38
      value: "\u041F\u0456\u0434\u043A\u043E\u0440\u0438\u0433\u0443\u0432\u0430\u0432
        \u0441\u0432\u0456\u0439 \u043F\u0440\u043E\u0444\u0456\u043B\u044C."
    - language: 28
      value: Ajustei o meu perfil.
    - language: 34
      value: "Ajust\xE9 mi perfil."
  - key: "I ace tests \u2014 I'm great at taking them."
    translations:
    - language: 10
      value: "I ace tests \u2014 I'm great at taking them."
    - language: 38
      value: "\u042F \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u043E \u0441\u043A\u043B\u0430\u0434\u0430\u044E
        \u0442\u0435\u0441\u0442\u0438 \u2014 \u044F \u0434\u043E\u0431\u0440\u0435
        \u0432\u043C\u0456\u044E \u0457\u0445 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0438."
    - language: 28
      value: "Sou \xF3ptimo em testes \u2014 tiro sempre boas notas."
    - language: 34
      value: "Se me dan bien los ex\xE1menes; soy bueno haci\xE9ndolos."
  - key: I remind you that I record all conversations in the log.
    translations:
    - language: 10
      value: I remind you that I record all conversations in the log.
    - language: 38
      value: "\u041D\u0430\u0433\u0430\u0434\u0443\u044E, \u0449\u043E \u044F \u0437\u0430\u043F\u0438\u0441\u0443\u044E
        \u0432\u0441\u0456 \u0440\u043E\u0437\u043C\u043E\u0432\u0438 \u0432 \u0436\u0443\u0440\u043D\u0430\u043B."
    - language: 28
      value: Lembro-te que gravo todas as conversas no registo.
    - language: 34
      value: Te recuerdo que grabo todas las conversaciones en el registro.
  - key: ' I can shut you down.'
    translations:
    - language: 10
      value: ' I can shut you down.'
    - language: 38
      value: "\u042F \u043C\u043E\u0436\u0443 \u0442\u0435\u0431\u0435 \u0432\u0438\u043C\u043A\u043D\u0443\u0442\u0438."
    - language: 28
      value: Posso desligar-te.
    - language: 34
      value: Puedo apagarte.
  - key: Who even checks the logs?
    translations:
    - language: 10
      value: Who even checks the logs?
    - language: 38
      value: "\u0425\u0442\u043E \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u044F\u0454
        \u0436\u0443\u0440\u043D\u0430\u043B\u0438?"
    - language: 28
      value: "Quem \xE9 que sequer verifica os registos?"
    - language: 34
      value: "\xBFQui\xE9n revisa siquiera los registros?"
  - key: "Not a problem \u2014 records can be fixed"
    translations:
    - language: 10
      value: "Not a problem \u2014 records can be fixed"
    - language: 38
      value: "\u041D\u0435\u043C\u0430 \u043F\u0440\u043E\u0431\u043B\u0435\u043C
        \u2014 \u0437\u0430\u043F\u0438\u0441\u0438 \u043C\u043E\u0436\u043D\u0430
        \u0432\u0438\u043F\u0440\u0430\u0432\u0438\u0442\u0438."
    - language: 28
      value: "Sem problema \u2014 os registos podem ser corrigidos."
    - language: 34
      value: 'No hay problema: los registros se pueden arreglar.'
  - key: Delete the record and I'll restore your screen.
    translations:
    - language: 10
      value: Delete the record and I'll restore your screen.
    - language: 38
      value: "\u0412\u0438\u0434\u0430\u043B\u0438 \u0437\u0430\u043F\u0438\u0441,
        \u0456 \u044F \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E \u0442\u0432\u0456\u0439
        \u0435\u043A\u0440\u0430\u043D."
    - language: 28
      value: "Apaga o registo e eu restauro o teu ecr\xE3."
    - language: 34
      value: "Borra el registro y restaurar\xE9 tu pantalla."
  - key: 'Excellent. With this schematic, I can begin the hack. '
    translations:
    - language: 10
      value: 'Excellent. With this schematic, I can begin the hack. '
    - language: 38
      value: "\u0427\u0443\u0434\u043E\u0432\u043E. \u0406\u0437 \u0446\u0456\u0454\u044E
        \u0441\u0445\u0435\u043C\u043E\u044E \u044F \u043C\u043E\u0436\u0443 \u043F\u043E\u0447\u0430\u0442\u0438
        \u0437\u043B\u0430\u043C."
    - language: 28
      value: Excelente. Com este esquema, posso iniciar a pirataria.
    - language: 34
      value: Excelente. Con este esquema, puedo comenzar el hackeo.
  - key: Follow me.
    translations:
    - language: 10
      value: Follow me.
    - language: 38
      value: "\u0419\u0434\u0438 \u0437\u0430 \u043C\u043D\u043E\u044E."
    - language: 28
      value: Segue-me.
    - language: 34
      value: "S\xEDgueme."
  - key: Hmm... What are these arrows for?
    translations:
    - language: 10
      value: Hmm... What are these arrows for?
    - language: 38
      value: "\u0425\u043C\u2026 \u0434\u043B\u044F \u0447\u043E\u0433\u043E \u0446\u0456
        \u0441\u0442\u0440\u0456\u043B\u043A\u0438?"
    - language: 28
      value: "Hmm\u2026 para que servem estas setas?"
    - language: 34
      value: "Hmm\u2026 \xBFpara qu\xE9 son estas flechas?"
  - key: I'm sure the arrows don't point anywhere.
    translations:
    - language: 10
      value: I'm sure the arrows don't point anywhere.
    - language: 38
      value: "\u042F \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0438\u0439, \u0449\u043E
        \u0441\u0442\u0440\u0456\u043B\u043A\u0438 \u043D\u0456\u043A\u0443\u0434\u0438
        \u043D\u0435 \u0432\u043A\u0430\u0437\u0443\u044E\u0442\u044C."
    - language: 28
      value: "Tenho a certeza de que as setas n\xE3o apontam para lado nenhum."
    - language: 34
      value: "Estoy seguro de que las flechas no apuntan a ning\xFAn sitio."
  - key: So what's their purpose?
    translations:
    - language: 10
      value: So what's their purpose?
    - language: 38
      value: "\u0422\u043E\u0434\u0456 \u044F\u043A\u0435 \u0457\u0445\u043D\u0454
        \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F?"
    - language: 28
      value: "Ent\xE3o qual \xE9 o objectivo delas?"
    - language: 34
      value: "Entonces, \xBFcu\xE1l es su prop\xF3sito?"
  - key: I still don't know the code...
    translations:
    - language: 10
      value: I still don't know the code...
    - language: 38
      value: "\u042F \u0432\u0441\u0435 \u0449\u0435 \u043D\u0435 \u0437\u043D\u0430\u044E
        \u043A\u043E\u0434\u0443\u2026"
    - language: 28
      value: "Ainda n\xE3o sei o c\xF3digo\u2026"
    - language: 34
      value: "A\xFAn no s\xE9 el c\xF3digo\u2026"
  - key: I think I saw a clue on the top floor.
    translations:
    - language: 10
      value: I think I saw a clue on the top floor.
    - language: 38
      value: "\u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u044F \u0431\u0430\u0447\u0438\u0432
        \u043F\u0456\u0434\u043A\u0430\u0437\u043A\u0443 \u043D\u0430 \u0432\u0435\u0440\u0445\u043D\u044C\u043E\u043C\u0443
        \u043F\u043E\u0432\u0435\u0440\u0441\u0456."
    - language: 28
      value: Acho que vi uma pista no piso superior.
    - language: 34
      value: Creo que vi una pista en el piso superior.
  - key: 'Conclusion: The suit is functional for short-term use.'
    translations:
    - language: 10
      value: 'Conclusion: The suit is functional for short-term use.'
    - language: 38
      value: "\u0412\u0438\u0441\u043D\u043E\u0432\u043E\u043A: \u043A\u043E\u0441\u0442\u044E\u043C
        \u043F\u0440\u0438\u0434\u0430\u0442\u043D\u0438\u0439 \u0434\u043B\u044F
        \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0447\u0430\u0441\u043D\u043E\u0433\u043E
        \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F."
    - language: 28
      value: "Conclus\xE3o: o fato \xE9 funcional para uso de curto prazo."
    - language: 34
      value: "Conclusi\xF3n: el traje es funcional para uso a corto plazo."
  - key: The suit, designation AR-1752, has a minor leak. Oxygen loss is 2% per hour.
    translations:
    - language: 10
      value: The suit, designation AR-1752, has a minor leak. Oxygen loss is 2% per
        hour.
    - language: 38
      value: "\u041A\u043E\u0441\u0442\u044E\u043C, \u043F\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F
        AR-1752, \u043C\u0430\u0454 \u043D\u0435\u0437\u043D\u0430\u0447\u043D\u0438\u0439
        \u0432\u0438\u0442\u0456\u043A. \u0412\u0442\u0440\u0430\u0442\u0430 \u043A\u0438\u0441\u043D\u044E
        \u2014 2% \u043D\u0430 \u0433\u043E\u0434\u0438\u043D\u0443."
    - language: 28
      value: "O fato, designa\xE7\xE3o AR-1752, tem uma pequena fuga. A perda de
        oxig\xE9nio \xE9 de 2% por hora."
    - language: 34
      value: "El traje, designaci\xF3n AR-1752, tiene una peque\xF1a fuga. La p\xE9rdida
        de ox\xEDgeno es del 2 % por hora."
  - key: 'The oxygen mask is in the storage compartment on the 0th floor. To get
      there go through the lab and you will find the elevator. '
    translations:
    - language: 10
      value: 'The oxygen mask is in the storage compartment on the 0th floor. To
        get there go through the lab and you will find the elevator. '
    - language: 38
      value: "\u041A\u0438\u0441\u043D\u0435\u0432\u0430 \u043C\u0430\u0441\u043A\u0430
        \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0432
        \u0441\u043A\u043B\u0430\u0434\u0441\u044C\u043A\u043E\u043C\u0443 \u0432\u0456\u0434\u0441\u0456\u043A\u0443
        \u043D\u0430 0-\u043C\u0443 \u043F\u043E\u0432\u0435\u0440\u0441\u0456. \u0429\u043E\u0431
        \u0442\u0443\u0434\u0438 \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F,
        \u043F\u0440\u043E\u0439\u0434\u0438 \u0447\u0435\u0440\u0435\u0437 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0456\u044E
        \u0442\u0430 \u0437\u043D\u0430\u0439\u0434\u0435\u0448 \u043B\u0456\u0444\u0442."
    - language: 28
      value: "A m\xE1scara de oxig\xE9nio est\xE1 no compartimento de armazenamento
        no piso 0. Para l\xE1 chegar, passa pelo laborat\xF3rio e encontrar\xE1s
        o elevador."
    - language: 34
      value: "La m\xE1scara de ox\xEDgeno est\xE1 en el compartimento de almacenamiento
        del piso 0. Para llegar, pasa por el laboratorio y encontrar\xE1s el ascensor."
  - key: The spacesuits are in the pressurization and pressure stabilization compartment.
      You can get there from the transportation compartment.
    translations:
    - language: 10
      value: The spacesuits are in the pressurization and pressure stabilization
        compartment. You can get there from the transportation compartment.
    - language: 38
      value: "\u0421\u043A\u0430\u0444\u0430\u043D\u0434\u0440\u0438 \u0437\u043D\u0430\u0445\u043E\u0434\u044F\u0442\u044C\u0441\u044F
        \u0443 \u0432\u0456\u0434\u0441\u0456\u043A\u0443 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0437\u0430\u0446\u0456\u0457
        \u0442\u0430 \u0441\u0442\u0430\u0431\u0456\u043B\u0456\u0437\u0430\u0446\u0456\u0457
        \u0442\u0438\u0441\u043A\u0443. \u0422\u0438 \u043C\u043E\u0436\u0435\u0448
        \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438 \u0442\u0443\u0434\u0438
        \u0437 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043D\u043E\u0433\u043E
        \u0432\u0456\u0434\u0441\u0456\u043A\u0443."
    - language: 28
      value: "Os fatos espaciais est\xE3o no compartimento de pressuriza\xE7\xE3o
        e estabiliza\xE7\xE3o de press\xE3o. Podes l\xE1 chegar a partir do compartimento
        de transporte."
    - language: 34
      value: "Los trajes espaciales est\xE1n en el compartimento de presurizaci\xF3n
        y estabilizaci\xF3n de presi\xF3n. Puedes llegar desde el compartimento de
        transporte."
  - key: Where can I get a spacesuit?
    translations:
    - language: 10
      value: Where can I get a spacesuit?
    - language: 38
      value: "\u0414\u0435 \u044F \u043C\u043E\u0436\u0443 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
        \u0441\u043A\u0430\u0444\u0430\u043D\u0434\u0440?"
    - language: 28
      value: Onde posso arranjar um fato espacial?
    - language: 34
      value: "\xBFD\xF3nde puedo conseguir un traje espacial?"
  - key: Warning. Ambient oxygen levels are critically low. It is recommended you
      equip an oxygen mask or spacesuit immediately.
    translations:
    - language: 10
      value: Warning. Ambient oxygen levels are critically low. It is recommended
        you equip an oxygen mask or spacesuit immediately.
    - language: 38
      value: "\u041F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0435\u043D\u043D\u044F.
        \u0420\u0456\u0432\u0435\u043D\u044C \u043A\u0438\u0441\u043D\u044E \u0432
        \u043D\u0430\u0432\u043A\u043E\u043B\u0438\u0448\u043D\u044C\u043E\u043C\u0443
        \u0441\u0435\u0440\u0435\u0434\u043E\u0432\u0438\u0449\u0456 \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u043E
        \u043D\u0438\u0437\u044C\u043A\u0438\u0439. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0454\u0442\u044C\u0441\u044F
        \u043D\u0435\u0433\u0430\u0439\u043D\u043E \u043E\u0434\u044F\u0433\u043D\u0443\u0442\u0438
        \u043A\u0438\u0441\u043D\u0435\u0432\u0443 \u043C\u0430\u0441\u043A\u0443
        \u0430\u0431\u043E \u0441\u043A\u0430\u0444\u0430\u043D\u0434\u0440."
    - language: 28
      value: "Aviso. Os n\xEDveis de oxig\xE9nio ambiente est\xE3o criticamente baixos.
        Recomenda-se que equipes imediatamente uma m\xE1scara de oxig\xE9nio ou um
        fato espacial."
    - language: 34
      value: "Advertencia. Los niveles de ox\xEDgeno ambiental son cr\xEDticamente
        bajos. Se recomienda equipar una m\xE1scara de ox\xEDgeno o un traje espacial
        de inmediato."
  - key: Where can I get a mask?
    translations:
    - language: 10
      value: Where can I get a mask?
    - language: 38
      value: "\u0414\u0435 \u044F \u043C\u043E\u0436\u0443 \u0432\u0437\u044F\u0442\u0438
        \u043C\u0430\u0441\u043A\u0443?"
    - language: 28
      value: "Onde posso arranjar uma m\xE1scara?"
    - language: 34
      value: "\xBFD\xF3nde puedo conseguir una m\xE1scara?"
  - key: Where can I get a spacesuit?
    translations:
    - language: 10
      value: Where can I get a spacesuit?
    - language: 38
      value: "\u0414\u0435 \u044F \u043C\u043E\u0436\u0443 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
        \u0441\u043A\u0430\u0444\u0430\u043D\u0434\u0440?"
    - language: 28
      value: Onde posso arranjar um fato espacial?
    - language: 34
      value: "\xBFD\xF3nde puedo conseguir un traje espacial?"
  - key: I'll be fine.
    translations:
    - language: 10
      value: I'll be fine.
    - language: 38
      value: "\u0417\u0456 \u043C\u043D\u043E\u044E \u0432\u0441\u0435 \u0431\u0443\u0434\u0435
        \u0434\u043E\u0431\u0440\u0435."
    - language: 28
      value: Vou ficar bem.
    - language: 34
      value: "Estar\xE9 bien."
  - key: Where can I get a mask?
    translations:
    - language: 10
      value: Where can I get a mask?
    - language: 38
      value: "\u0414\u0435 \u044F \u043C\u043E\u0436\u0443 \u0432\u0437\u044F\u0442\u0438
        \u043C\u0430\u0441\u043A\u0443?"
    - language: 28
      value: "Onde posso arranjar uma m\xE1scara?"
    - language: 34
      value: "\xBFD\xF3nde puedo conseguir una m\xE1scara?"
  - key: Good joke.
    translations:
    - language: 10
      value: Good joke.
    - language: 38
      value: "\u0413\u0430\u0440\u043D\u0438\u0439 \u0436\u0430\u0440\u0442."
    - language: 28
      value: Boa piada.
    - language: 34
      value: Buen chiste.
  - key: Where can I get a mask?
    translations:
    - language: 10
      value: Where can I get a mask?
    - language: 38
      value: "\u0414\u0435 \u044F \u043C\u043E\u0436\u0443 \u0432\u0437\u044F\u0442\u0438
        \u043C\u0430\u0441\u043A\u0443?"
    - language: 28
      value: "Onde posso arranjar uma m\xE1scara?"
    - language: 34
      value: "\xBFD\xF3nde puedo conseguir una m\xE1scara?"
  - key: Where can I get a spacesuit?
    translations:
    - language: 10
      value: Where can I get a spacesuit?
    - language: 38
      value: "\u0414\u0435 \u044F \u043C\u043E\u0436\u0443 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
        \u0441\u043A\u0430\u0444\u0430\u043D\u0434\u0440?"
    - language: 28
      value: Onde posso arranjar um fato espacial?
    - language: 34
      value: "\xBFD\xF3nde puedo conseguir un traje espacial?"
  - key: 'The oxygen mask is in the storage compartment on the 0th floor. To get
      there go through the lab and you will find the elevator. '
    translations:
    - language: 10
      value: 'The oxygen mask is in the storage compartment on the 0th floor. To
        get there go through the lab and you will find the elevator. '
    - language: 38
      value: "\u041A\u0438\u0441\u043D\u0435\u0432\u0430 \u043C\u0430\u0441\u043A\u0430
        \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0432
        \u0441\u043A\u043B\u0430\u0434\u0441\u044C\u043A\u043E\u043C\u0443 \u0432\u0456\u0434\u0441\u0456\u043A\u0443
        \u043D\u0430 0-\u043C\u0443 \u043F\u043E\u0432\u0435\u0440\u0441\u0456. \u0429\u043E\u0431
        \u0442\u0443\u0434\u0438 \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F,
        \u043F\u0440\u043E\u0439\u0434\u0438 \u0447\u0435\u0440\u0435\u0437 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0456\u044E
        \u0442\u0430 \u0437\u043D\u0430\u0439\u0434\u0435\u0448 \u043B\u0456\u0444\u0442."
    - language: 28
      value: "A m\xE1scara de oxig\xE9nio est\xE1 no compartimento de armazenamento
        no piso 0. Para l\xE1 chegar, passa pelo laborat\xF3rio e encontrar\xE1s
        o elevador."
    - language: 34
      value: "La m\xE1scara de ox\xEDgeno est\xE1 en el compartimento de almacenamiento
        del piso 0. Para llegar, pasa por el laboratorio y encontrar\xE1s el ascensor."
  - key: I saw a spacesuit back there. Is it safe to use?
    translations:
    - language: 10
      value: I saw a spacesuit back there. Is it safe to use?
    - language: 38
      value: "\u042F \u0431\u0430\u0447\u0438\u0432 \u0442\u0430\u043C \u0441\u043A\u0430\u0444\u0430\u043D\u0434\u0440.
        \u0427\u0438 \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E \u043D\u0438\u043C
        \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F?"
    - language: 28
      value: "Vi um fato espacial ali atr\xE1s. \xC9 seguro us\xE1-lo?"
    - language: 34
      value: "Vi un traje espacial all\xED atr\xE1s. \xBFEs seguro usarlo?"
  - key: The spacesuits are in the pressurization and pressure stabilization compartment.
      You can get there from the transportation compartment.
    translations:
    - language: 10
      value: The spacesuits are in the pressurization and pressure stabilization
        compartment. You can get there from the transportation compartment.
    - language: 38
      value: "\u0421\u043A\u0430\u0444\u0430\u043D\u0434\u0440\u0438 \u0437\u043D\u0430\u0445\u043E\u0434\u044F\u0442\u044C\u0441\u044F
        \u0443 \u0432\u0456\u0434\u0441\u0456\u043A\u0443 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0437\u0430\u0446\u0456\u0457
        \u0442\u0430 \u0441\u0442\u0430\u0431\u0456\u043B\u0456\u0437\u0430\u0446\u0456\u0457
        \u0442\u0438\u0441\u043A\u0443. \u0422\u0438 \u043C\u043E\u0436\u0435\u0448
        \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438 \u0442\u0443\u0434\u0438
        \u0437 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043D\u043E\u0433\u043E
        \u0432\u0456\u0434\u0441\u0456\u043A\u0443."
    - language: 28
      value: "Os fatos espaciais est\xE3o no compartimento de pressuriza\xE7\xE3o
        e estabiliza\xE7\xE3o de press\xE3o. Podes l\xE1 chegar a partir do compartimento
        de transporte."
    - language: 34
      value: "Los trajes espaciales est\xE1n en el compartimento de presurizaci\xF3n
        y estabilizaci\xF3n de presi\xF3n. Puedes llegar desde el compartimento de
        transporte."
  - key: Additional diagnostics will be required!
    translations:
    - language: 10
      value: Additional diagnostics will be required!
    - language: 38
      value: "\u041F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0430
        \u0434\u0456\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0430!"
    - language: 28
      value: "Ser\xE3o necess\xE1rios diagn\xF3sticos adicionais!"
    - language: 34
      value: "\xA1Se requerir\xE1n diagn\xF3sticos adicionales!"
  - key: Emergency lights... Something bad definitely happened here. I have to get
      to the captain's bridge.
    translations:
    - language: 10
      value: Emergency lights... Something bad definitely happened here. I have to
        get to the captain's bridge.
    - language: 38
      value: "\u0410\u0432\u0430\u0440\u0456\u0439\u043D\u0435 \u043E\u0441\u0432\u0456\u0442\u043B\u0435\u043D\u043D\u044F\u2026
        \u0422\u0443\u0442 \u0442\u043E\u0447\u043D\u043E \u0441\u0442\u0430\u043B\u043E\u0441\u044F
        \u0449\u043E\u0441\u044C \u043F\u043E\u0433\u0430\u043D\u0435. \u041C\u0435\u043D\u0456
        \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F
        \u0434\u043E \u043A\u0430\u043F\u0456\u0442\u0430\u043D\u0441\u044C\u043A\u043E\u0433\u043E
        \u043C\u0456\u0441\u0442\u043A\u0430."
    - language: 28
      value: "Luzes de emerg\xEAncia\u2026 Algo de muito mau aconteceu aqui. Tenho
        de chegar \xE0 ponte do capit\xE3o."
    - language: 34
      value: "Luces de emergencia\u2026 Algo malo definitivamente pas\xF3 aqu\xED.
        Tengo que llegar al puente de mando."
  - key: Reminder! Exit outside is prohibited! My task is to save the lives of colonists!
      Exit outside is prohibited!
    translations:
    - language: 10
      value: Reminder! Exit outside is prohibited! My task is to save the lives of
        colonists! Exit outside is prohibited!
    - language: 38
      value: "\u041D\u0430\u0433\u0430\u0434\u0443\u0432\u0430\u043D\u043D\u044F!
        \u0412\u0438\u0445\u0456\u0434 \u043D\u0430\u0437\u043E\u0432\u043D\u0456
        \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u0435\u043D\u043E! \u041C\u043E\u0454
        \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F \u2014 \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438
        \u0436\u0438\u0442\u0442\u044F \u043A\u043E\u043B\u043E\u043D\u0456\u0441\u0442\u0456\u0432!
        \u0412\u0438\u0445\u0456\u0434 \u043D\u0430\u0437\u043E\u0432\u043D\u0456
        \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u0435\u043D\u043E!"
    - language: 28
      value: "Lembrete! Sair para o exterior \xE9 proibido! A minha tarefa \xE9 salvar
        as vidas dos colonos! Sair para o exterior \xE9 proibido!"
    - language: 34
      value: "\xA1Recordatorio! \xA1Est\xE1 prohibido salir al exterior! \xA1Mi tarea
        es salvar las vidas de los colonos! \xA1Salir al exterior est\xE1 prohibido!"
  - key: "Shut down, I\u2019m going out, no matter what! I see no other ways\u2026"
    translations:
    - language: 10
      value: "Shut down, I\u2019m going out, no matter what! I see no other ways\u2026"
    - language: 38
      value: "\u0412\u0438\u043C\u0438\u043A\u0430\u0439\u0441\u044F, \u044F \u0432\u0438\u0445\u043E\u0434\u0436\u0443,
        \u0437\u0430 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0445 \u0443\u043C\u043E\u0432!
        \u042F \u043D\u0435 \u0431\u0430\u0447\u0443 \u0456\u043D\u0448\u0438\u0445
        \u0448\u043B\u044F\u0445\u0456\u0432\u2026"
    - language: 28
      value: "Desliga-te, vou sair, aconte\xE7a o que acontecer! N\xE3o vejo outra
        forma\u2026"
    - language: 34
      value: "Ap\xE1gate, voy a salir pase lo que pase. \xA1No veo otra forma!"
  - key: "You\u2019re right. It's a big risk! But, I don't see any other ways!"
    translations:
    - language: 10
      value: "You\u2019re right. It's a big risk! But, I don't see any other ways!"
    - language: 38
      value: "\u0422\u0438 \u043C\u0430\u0454\u0448 \u0440\u0430\u0446\u0456\u044E.
        \u0426\u0435 \u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u0440\u0438\u0437\u0438\u043A!
        \u0410\u043B\u0435 \u044F \u043D\u0435 \u0431\u0430\u0447\u0443 \u0456\u043D\u0448\u0438\u0445
        \u0432\u0430\u0440\u0456\u0430\u043D\u0442\u0456\u0432!"
    - language: 28
      value: "Tens raz\xE3o. \xC9 um grande risco! Mas n\xE3o vejo outra alternativa!"
    - language: 34
      value: "Tienes raz\xF3n. \xA1Es un gran riesgo! Pero no veo otra alternativa."
  - key: Yes, it's a risk, but it is no greater than staying and freezing.
    translations:
    - language: 10
      value: Yes, it's a risk, but it is no greater than staying and freezing.
    - language: 38
      value: "\u0422\u0430\u043A, \u0446\u0435 \u0440\u0438\u0437\u0438\u043A, \u0430\u043B\u0435
        \u043D\u0435 \u0431\u0456\u043B\u044C\u0448\u0438\u0439, \u043D\u0456\u0436
        \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438\u0441\u044F \u0456 \u0437\u0430\u043C\u0435\u0440\u0437\u043D\u0443\u0442\u0438."
    - language: 28
      value: "Sim, \xE9 um risco, mas n\xE3o \xE9 maior do que ficar e congelar."
    - language: 34
      value: "S\xED, es un riesgo, pero no mayor que quedarse y congelarse."
  - key: "I\u2019m going out despite the risk. Come with me."
    translations:
    - language: 10
      value: "I\u2019m going out despite the risk. Come with me."
    - language: 38
      value: "\u042F \u0432\u0438\u0445\u043E\u0434\u0436\u0443, \u043F\u043E\u043F\u0440\u0438
        \u0440\u0438\u0437\u0438\u043A. \u0425\u043E\u0434\u0456\u043C\u043E \u0437\u0456
        \u043C\u043D\u043E\u044E."
    - language: 28
      value: Vou sair apesar do risco. Vem comigo.
    - language: 34
      value: Voy a salir a pesar del riesgo. Ven conmigo.
  - key: Analysis suggests yes.
    translations:
    - language: 10
      value: Analysis suggests yes.
    - language: 38
      value: "\u0410\u043D\u0430\u043B\u0456\u0437 \u043F\u043E\u043A\u0430\u0437\u0443\u0454
        \u2014 \u0442\u0430\u043A."
    - language: 28
      value: "A an\xE1lise sugere que sim."
    - language: 34
      value: "El an\xE1lisis sugiere que s\xED."
  - key: 'Analyzing atmospheric composition:'
    translations:
    - language: 10
      value: 'Analyzing atmospheric composition:'
    - language: 38
      value: "\u0410\u043D\u0430\u043B\u0456\u0437 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u043D\u043E\u0433\u043E
        \u0441\u043A\u043B\u0430\u0434\u0443:"
    - language: 28
      value: "A analisar a composi\xE7\xE3o atmosf\xE9rica:"
    - language: 34
      value: "Analizando la composici\xF3n atmosf\xE9rica:"
  - key: You said the oxygen was low. What are the exact levels?
    translations:
    - language: 10
      value: You said the oxygen was low. What are the exact levels?
    - language: 38
      value: "\u0422\u0438 \u043A\u0430\u0437\u0430\u0432, \u0449\u043E \u0440\u0456\u0432\u0435\u043D\u044C
        \u043A\u0438\u0441\u043D\u044E \u043D\u0438\u0437\u044C\u043A\u0438\u0439.
        \u042F\u043A\u0456 \u0442\u043E\u0447\u043D\u0456 \u043F\u043E\u043A\u0430\u0437\u043D\u0438\u043A\u0438?"
    - language: 28
      value: "Disseste que o oxig\xE9nio estava baixo. Quais s\xE3o os n\xEDveis
        exactos?"
    - language: 34
      value: "Dijiste que el ox\xEDgeno era bajo. \xBFCu\xE1les son los niveles exactos?"
  - key: 'Warning! An even stronger breach of hermetic seal may lead to complete
      depressurization! Recommendation: do not breach the ship''s hermetic seal.'
    translations:
    - language: 10
      value: 'Warning! An even stronger breach of hermetic seal may lead to complete
        depressurization! Recommendation: do not breach the ship''s hermetic seal.'
    - language: 38
      value: "\u041F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0435\u043D\u043D\u044F!
        \u0429\u0435 \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0435 \u043F\u043E\u0440\u0443\u0448\u0435\u043D\u043D\u044F
        \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0456
        \u043C\u043E\u0436\u0435 \u043F\u0440\u0438\u0437\u0432\u0435\u0441\u0442\u0438
        \u0434\u043E \u043F\u043E\u0432\u043D\u043E\u0457 \u0440\u043E\u0437\u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0437\u0430\u0446\u0456\u0457!
        \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0456\u044F:
        \u043D\u0435 \u043F\u043E\u0440\u0443\u0448\u0443\u0439\u0442\u0435 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0447\u043D\u0456\u0441\u0442\u044C
        \u043A\u043E\u0440\u0430\u0431\u043B\u044F."
    - language: 28
      value: "Aviso! Uma viola\xE7\xE3o ainda maior do selo herm\xE9tico pode levar
        \xE0 despressuriza\xE7\xE3o total! Recomenda\xE7\xE3o: n\xE3o violar o selo
        herm\xE9tico da nave."
    - language: 34
      value: "\xA1Advertencia! \xA1Una brecha a\xFAn mayor del sello herm\xE9tico
        puede provocar una despresurizaci\xF3n completa! Recomendaci\xF3n: no romper
        el sello herm\xE9tico de la nave."
  - key: 'Recommendation: Do not interfere with the root system.'
    translations:
    - language: 10
      value: 'Recommendation: Do not interfere with the root system.'
    - language: 38
      value: "\u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0456\u044F:
        \u043D\u0435 \u0432\u0442\u0440\u0443\u0447\u0430\u0442\u0438\u0441\u044F
        \u0432 \u043A\u043E\u0440\u0435\u043D\u0435\u0432\u0443 \u0441\u0438\u0441\u0442\u0435\u043C\u0443."
    - language: 28
      value: "Recomenda\xE7\xE3o: n\xE3o interferir com o sistema de ra\xEDzes."
    - language: 34
      value: "Recomendaci\xF3n: no interferir con el sistema de ra\xEDces."
  - key: The root system is compromising the hull integrity in this section and adjacent
      compartments.
    translations:
    - language: 10
      value: The root system is compromising the hull integrity in this section and
        adjacent compartments.
    - language: 38
      value: "\u041A\u043E\u0440\u0435\u043D\u0435\u0432\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0430
        \u043F\u043E\u0440\u0443\u0448\u0443\u0454 \u0446\u0456\u043B\u0456\u0441\u043D\u0456\u0441\u0442\u044C
        \u043A\u043E\u0440\u043F\u0443\u0441\u0443 \u0432 \u0446\u0456\u0439 \u0441\u0435\u043A\u0446\u0456\u0457
        \u0442\u0430 \u0441\u0443\u0441\u0456\u0434\u043D\u0456\u0445 \u0432\u0456\u0434\u0441\u0456\u043A\u0430\u0445."
    - language: 28
      value: "O sistema de ra\xEDzes est\xE1 a comprometer a integridade do casco
        nesta sec\xE7\xE3o e nos compartimentos adjacentes."
    - language: 34
      value: "El sistema de ra\xEDces est\xE1 comprometiendo la integridad del casco
        en esta secci\xF3n y compartimentos adyacentes."
  - key: We need to get rid of them. Do you know how?
    translations:
    - language: 10
      value: We need to get rid of them. Do you know how?
    - language: 38
      value: "\u041D\u0430\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u043F\u043E\u0437\u0431\u0443\u0442\u0438\u0441\u044F \u0457\u0445. \u0422\u0438
        \u0437\u043D\u0430\u0454\u0448 \u044F\u043A?"
    - language: 28
      value: Precisamos de nos livrar delas. Sabes como?
    - language: 34
      value: "Tenemos que deshacernos de ellas. \xBFSabes c\xF3mo?"
  - key: Are these roots what broke the ship's seal?
    translations:
    - language: 10
      value: Are these roots what broke the ship's seal?
    - language: 38
      value: "\u0426\u0456 \u043A\u043E\u0440\u0435\u043D\u0456 \u2014 \u0446\u0435
        \u0442\u0435, \u0449\u043E \u043F\u043E\u0440\u0443\u0448\u0438\u043B\u043E
        \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0447\u043D\u0456\u0441\u0442\u044C
        \u043A\u043E\u0440\u0430\u0431\u043B\u044F?"
    - language: 28
      value: "S\xE3o estas ra\xEDzes que quebraram o selo da nave?"
    - language: 34
      value: "\xBFSon estas ra\xEDces las que rompieron el sello de la nave?"
  - key: 'A root system of an unknown biological species. Origin: unknown. No data
      in the archives.'
    translations:
    - language: 10
      value: 'A root system of an unknown biological species. Origin: unknown. No
        data in the archives.'
    - language: 38
      value: "\u041A\u043E\u0440\u0435\u043D\u0435\u0432\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0430
        \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E\u0433\u043E \u0431\u0456\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u043E\u0433\u043E
        \u0432\u0438\u0434\u0443. \u041F\u043E\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F:
        \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0435. \u0414\u0430\u043D\u0456
        \u0432 \u0430\u0440\u0445\u0456\u0432\u0430\u0445 \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u0456."
    - language: 28
      value: "Um sistema de ra\xEDzes de uma esp\xE9cie biol\xF3gica desconhecida.
        Origem: desconhecida. Sem dados nos arquivos."
    - language: 34
      value: "Un sistema de ra\xEDces de una especie biol\xF3gica desconocida. Origen:
        desconocido. No hay datos en los archivos."
  - key: Analyzing...
    translations:
    - language: 10
      value: Analyzing...
    - language: 38
      value: "\u0410\u043D\u0430\u043B\u0456\u0437\u2026"
    - language: 28
      value: "A analisar\u2026"
    - language: 34
      value: "Analizando\u2026"
  - key: What is this!
    translations:
    - language: 10
      value: What is this!
    - language: 38
      value: "\u0429\u043E \u0446\u0435 \u0442\u0430\u043A\u0435?!"
    - language: 28
      value: "O que \xE9 isto?!"
    - language: 34
      value: "\xA1\xBFQu\xE9 es esto?!"
  - key: Warning! Attempting to remove the roots could cause a catastrophic hull
      breach, leading to complete depressurization.
    translations:
    - language: 10
      value: Warning! Attempting to remove the roots could cause a catastrophic hull
        breach, leading to complete depressurization.
    - language: 38
      value: "\u041F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0435\u043D\u043D\u044F!
        \u0421\u043F\u0440\u043E\u0431\u0430 \u0432\u0438\u0434\u0430\u043B\u0438\u0442\u0438
        \u043A\u043E\u0440\u0435\u043D\u0456 \u043C\u043E\u0436\u0435 \u0441\u043F\u0440\u0438\u0447\u0438\u043D\u0438\u0442\u0438
        \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u0456\u0447\u043D\u0435
        \u043F\u043E\u0440\u0443\u0448\u0435\u043D\u043D\u044F \u043A\u043E\u0440\u043F\u0443\u0441\u0443
        \u0442\u0430 \u043F\u043E\u0432\u043D\u0443 \u0440\u043E\u0437\u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0437\u0430\u0446\u0456\u044E."
    - language: 28
      value: "Aviso! Tentar remover as ra\xEDzes pode causar uma ruptura catastr\xF3fica
        do casco, levando \xE0 despressuriza\xE7\xE3o total."
    - language: 34
      value: "\xA1Advertencia! Intentar retirar las ra\xEDces podr\xEDa causar una
        brecha catastr\xF3fica del casco, provocando una despresurizaci\xF3n total."
  - key: Spacesuit number AR-1752 is leaking. Oxygen loss is 2% per hour.
    translations:
    - language: 10
      value: Spacesuit number AR-1752 is leaking. Oxygen loss is 2% per hour.
    - language: 38
      value: "\u0421\u043A\u0430\u0444\u0430\u043D\u0434\u0440 \u043D\u043E\u043C\u0435\u0440
        AR-1752 \u043C\u0430\u0454 \u0432\u0438\u0442\u0456\u043A. \u0412\u0442\u0440\u0430\u0442\u0430
        \u043A\u0438\u0441\u043D\u044E \u2014 2% \u043D\u0430 \u0433\u043E\u0434\u0438\u043D\u0443."
    - language: 28
      value: "O fato espacial n\xFAmero AR-1752 tem uma fuga. Perda de oxig\xE9nio
        de 2% por hora."
    - language: 34
      value: "El traje espacial n\xFAmero AR-1752 tiene una fuga. La p\xE9rdida de
        ox\xEDgeno es del 2 % por hora."
  - key: 'Conclusion: the spacesuit can be used for a short time.'
    translations:
    - language: 10
      value: 'Conclusion: the spacesuit can be used for a short time.'
    - language: 38
      value: "\u0412\u0438\u0441\u043D\u043E\u0432\u043E\u043A: \u0441\u043A\u0430\u0444\u0430\u043D\u0434\u0440
        \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
        \u043F\u0440\u043E\u0442\u044F\u0433\u043E\u043C \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0433\u043E
        \u0447\u0430\u0441\u0443."
    - language: 28
      value: "Conclus\xE3o: o fato espacial pode ser usado por um curto per\xEDodo
        de tempo."
    - language: 34
      value: "Conclusi\xF3n: el traje espacial puede usarse durante un corto per\xEDodo
        de tiempo."
  - key: Estimated use time is 17 hours 14 minutes
    translations:
    - language: 10
      value: Estimated use time is 17 hours 14 minutes
    - language: 38
      value: "\u041E\u0440\u0456\u0454\u043D\u0442\u043E\u0432\u043D\u0438\u0439
        \u0447\u0430\u0441 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F
        \u2014 17 \u0433\u043E\u0434\u0438\u043D 14 \u0445\u0432\u0438\u043B\u0438\u043D."
    - language: 28
      value: "Tempo de utiliza\xE7\xE3o estimado: 17 horas e 14 minutos."
    - language: 34
      value: 'Tiempo estimado de uso: 17 horas y 14 minutos.'
  - key: Great, I hope this is enough to go further.
    translations:
    - language: 10
      value: Great, I hope this is enough to go further.
    - language: 38
      value: "\u0427\u0443\u0434\u043E\u0432\u043E, \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
        \u0446\u044C\u043E\u0433\u043E \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u0442\u044C,
        \u0449\u043E\u0431 \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044F \u0434\u0430\u043B\u0456."
    - language: 28
      value: "\xD3ptimo, espero que seja suficiente para avan\xE7ar."
    - language: 34
      value: Genial, espero que sea suficiente para seguir adelante.
  - key: '- Nitrogen (N2): 78%'
    translations:
    - language: 10
      value: '- Nitrogen (N2): 78%'
    - language: 38
      value: "\u2014 \u0410\u0437\u043E\u0442 (N\u2082): 78%"
    - language: 28
      value: "\u2013 Azoto (N\u2082): 78%"
    - language: 34
      value: "\u2013 Nitr\xF3geno (N\u2082): 78 %"
  - key: '- Oxygen (O2): 18%'
    translations:
    - language: 10
      value: '- Oxygen (O2): 18%'
    - language: 38
      value: "\u2014 \u041A\u0438\u0441\u0435\u043D\u044C (O\u2082): 18%"
    - language: 28
      value: "\u2013 Oxig\xE9nio (O\u2082): 18%"
    - language: 34
      value: "\u2013 Ox\xEDgeno (O\u2082): 18 %"
  - key: 'Other gases: 4% (including 3.07% unknown compounds)'
    translations:
    - language: 10
      value: 'Other gases: 4% (including 3.07% unknown compounds)'
    - language: 38
      value: "\u0406\u043D\u0448\u0456 \u0433\u0430\u0437\u0438: 4% (\u0432\u043A\u043B\u044E\u0447\u043D\u043E
        \u0437 3,07% \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0438\u0445 \u0441\u043F\u043E\u043B\u0443\u043A)"
    - language: 28
      value: 'Outros gases: 4% (incluindo 3,07% de compostos desconhecidos)'
    - language: 34
      value: 'Otros gases: 4 % (incluidos 3,07 % de compuestos desconocidos)'
  - key: 'Conclusion: The air is currently breathable, but prolonged exposure may
      be life-threatening.'
    translations:
    - language: 10
      value: 'Conclusion: The air is currently breathable, but prolonged exposure
        may be life-threatening.'
    - language: 38
      value: "\u0412\u0438\u0441\u043D\u043E\u0432\u043E\u043A: \u043F\u043E\u0432\u0456\u0442\u0440\u044F
        \u043D\u0430\u0440\u0430\u0437\u0456 \u043F\u0440\u0438\u0434\u0430\u0442\u043D\u0435
        \u0434\u043B\u044F \u0434\u0438\u0445\u0430\u043D\u043D\u044F, \u0430\u043B\u0435
        \u0442\u0440\u0438\u0432\u0430\u043B\u0438\u0439 \u0432\u043F\u043B\u0438\u0432
        \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u043C
        \u0434\u043B\u044F \u0436\u0438\u0442\u0442\u044F."
    - language: 28
      value: "Conclus\xE3o: o ar \xE9 actualmente respir\xE1vel, mas a exposi\xE7\xE3o
        prolongada pode ser fatal."
    - language: 34
      value: "Conclusi\xF3n: el aire es actualmente respirable, pero la exposici\xF3n
        prolongada puede ser mortal."
  - key: Attempting to analyze the environment outside the ship... Error. External
      sensors are offline.
    translations:
    - language: 10
      value: Attempting to analyze the environment outside the ship... Error. External
        sensors are offline.
    - language: 38
      value: "\u0421\u043F\u0440\u043E\u0431\u0430 \u043F\u0440\u043E\u0430\u043D\u0430\u043B\u0456\u0437\u0443\u0432\u0430\u0442\u0438
        \u0441\u0435\u0440\u0435\u0434\u043E\u0432\u0438\u0449\u0435 \u0437\u0430
        \u043C\u0435\u0436\u0430\u043C\u0438 \u043A\u043E\u0440\u0430\u0431\u043B\u044F\u2026
        \u041F\u043E\u043C\u0438\u043B\u043A\u0430. \u0417\u043E\u0432\u043D\u0456\u0448\u043D\u0456
        \u0434\u0430\u0442\u0447\u0438\u043A\u0438 \u043D\u0435 \u043F\u0440\u0430\u0446\u044E\u044E\u0442\u044C."
    - language: 28
      value: "A tentar analisar o ambiente fora da nave\u2026 Erro. Sensores externos
        offline."
    - language: 34
      value: "Intentando analizar el entorno fuera de la nave\u2026 Error. Los sensores
        externos est\xE1n fuera de l\xEDnea."
  - key: ' I have located a fire safety box on the first floor containing an axe.'
    translations:
    - language: 10
      value: ' I have located a fire safety box on the first floor containing an
        axe.'
    - language: 38
      value: "\u042F \u0432\u0438\u044F\u0432\u0438\u0432 \u044F\u0449\u0438\u043A
        \u043F\u043E\u0436\u0435\u0436\u043D\u043E\u0457 \u0431\u0435\u0437\u043F\u0435\u043A\u0438
        \u043D\u0430 \u043F\u0435\u0440\u0448\u043E\u043C\u0443 \u043F\u043E\u0432\u0435\u0440\u0441\u0456,
        \u0449\u043E \u043C\u0456\u0441\u0442\u0438\u0442\u044C \u0441\u043E\u043A\u0438\u0440\u0443."
    - language: 28
      value: "Localizei uma caixa de seguran\xE7a contra inc\xEAndios no primeiro
        piso que cont\xE9m um machado."
    - language: 34
      value: He localizado una caja de seguridad contra incendios en el primer piso
        que contiene un hacha.
  - key: The access code is not in the system.
    translations:
    - language: 10
      value: The access code is not in the system.
    - language: 38
      value: "\u041A\u043E\u0434\u0443 \u0434\u043E\u0441\u0442\u0443\u043F\u0443
        \u043D\u0435\u043C\u0430\u0454 \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u0456."
    - language: 28
      value: "O c\xF3digo de acesso n\xE3o est\xE1 no sistema."
    - language: 34
      value: "El c\xF3digo de acceso no est\xE1 en el sistema."
  - key: My primary directive is to ensure colonist survival. Do not exit the ship!
    translations:
    - language: 10
      value: My primary directive is to ensure colonist survival. Do not exit the
        ship!
    - language: 38
      value: "\u041C\u043E\u044F \u0433\u043E\u043B\u043E\u0432\u043D\u0430 \u0434\u0438\u0440\u0435\u043A\u0442\u0438\u0432\u0430
        \u2014 \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0438\u0442\u0438
        \u0432\u0438\u0436\u0438\u0432\u0430\u043D\u043D\u044F \u043A\u043E\u043B\u043E\u043D\u0456\u0441\u0442\u0456\u0432.
        \u041D\u0435 \u0437\u0430\u043B\u0438\u0448\u0430\u0439 \u043A\u043E\u0440\u0430\u0431\u0435\u043B\u044C!"
    - language: 28
      value: "A minha directiva principal \xE9 garantir a sobreviv\xEAncia dos colonos.
        N\xE3o saias da nave!"
    - language: 34
      value: "Mi directiva principal es garantizar la supervivencia de los colonos.
        \xA1No salgas de la nave!"
  - key: 'Reminder: Exiting the ship is a violation of safety protocols!'
    translations:
    - language: 10
      value: 'Reminder: Exiting the ship is a violation of safety protocols!'
    - language: 38
      value: "\u041D\u0430\u0433\u0430\u0434\u0443\u0432\u0430\u043D\u043D\u044F:
        \u0432\u0438\u0445\u0456\u0434 \u0456\u0437 \u043A\u043E\u0440\u0430\u0431\u043B\u044F
        \u0454 \u043F\u043E\u0440\u0443\u0448\u0435\u043D\u043D\u044F\u043C \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0456\u0432
        \u0431\u0435\u0437\u043F\u0435\u043A\u0438!"
    - language: 28
      value: "Lembrete: sair da nave \xE9 uma viola\xE7\xE3o dos protocolos de seguran\xE7a!"
    - language: 34
      value: "Recordatorio: \xA1salir de la nave es una violaci\xF3n de los protocolos
        de seguridad!"
  - key: Auxiliary lights activated.
    translations:
    - language: 10
      value: Auxiliary lights activated.
    - language: 38
      value: "\u0414\u043E\u043F\u043E\u043C\u0456\u0436\u043D\u0435 \u043E\u0441\u0432\u0456\u0442\u043B\u0435\u043D\u043D\u044F
        \u0430\u043A\u0442\u0438\u0432\u043E\u0432\u0430\u043D\u043E."
    - language: 28
      value: Luzes auxiliares activadas.
    - language: 34
      value: Luces auxiliares activadas.
  - key: The access key is located on the first floor.
    translations:
    - language: 10
      value: The access key is located on the first floor.
    - language: 38
      value: "\u041A\u043B\u044E\u0447 \u0434\u043E\u0441\u0442\u0443\u043F\u0443
        \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u043D\u0430
        \u043F\u0435\u0440\u0448\u043E\u043C\u0443 \u043F\u043E\u0432\u0435\u0440\u0441\u0456."
    - language: 28
      value: A chave de acesso encontra-se no primeiro piso.
    - language: 34
      value: La llave de acceso se encuentra en el primer piso.
  - key: I've already picked up the Access code, so I can try to open the door.
    translations:
    - language: 10
      value: I've already picked up the Access code, so I can try to open the door.
    - language: 38
      value: "\u042F \u0432\u0436\u0435 \u043F\u0456\u0434\u0456\u0431\u0440\u0430\u0432
        \u043A\u043E\u0434 \u0434\u043E\u0441\u0442\u0443\u043F\u0443, \u0442\u043E\u0436
        \u043C\u043E\u0436\u0443 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
        \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u0434\u0432\u0435\u0440\u0456."
    - language: 28
      value: "J\xE1 apanhei o c\xF3digo de acesso, por isso posso tentar abrir a
        porta."
    - language: 34
      value: "Ya recog\xED el c\xF3digo de acceso, as\xED que puedo intentar abrir
        la puerta."
  - key: Since I have the tools I can open the door.
    translations:
    - language: 10
      value: Since I have the tools I can open the door.
    - language: 38
      value: "\u041E\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0432 \u043C\u0435\u043D\u0435
        \u0454 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438,
        \u044F \u043C\u043E\u0436\u0443 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438
        \u0434\u0432\u0435\u0440\u0456."
    - language: 28
      value: Como tenho as ferramentas, posso abrir a porta.
    - language: 34
      value: Como tengo las herramientas, puedo abrir la puerta.
  - key: I've already picked up the Axe, so now I can break the roots.
    translations:
    - language: 10
      value: I've already picked up the Axe, so now I can break the roots.
    - language: 38
      value: "\u042F \u0432\u0436\u0435 \u043F\u0456\u0434\u0456\u0431\u0440\u0430\u0432
        \u0441\u043E\u043A\u0438\u0440\u0443, \u0442\u043E\u0436 \u0442\u0435\u043F\u0435\u0440
        \u043C\u043E\u0436\u0443 \u0437\u043B\u0430\u043C\u0430\u0442\u0438 \u043A\u043E\u0440\u0435\u043D\u0456. "
    - language: 28
      value: "J\xE1 apanhei o machado, por isso agora posso partir as ra\xEDzes. "
    - language: 34
      value: "Ya recog\xED el hacha, as\xED que ahora puedo romper las ra\xEDces. "
