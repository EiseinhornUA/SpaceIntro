  - key: Loading...
    translations:
    - language: 10
      value: Loading...
    - language: 38
      value: "\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F..."
    - language: 28
      value: A carregar...
    - language: 34
      value: Cargando...
