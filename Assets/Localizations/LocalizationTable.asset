    - language: 34
      value: "Radar de Estado de \xC1nimo"
    - language: 30
      value: "\u0420\u0430\u0434\u0430\u0440 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F"
    - language: 16
      value: "\u03A1\u03B1\u03BD\u03C4\u03AC\u03C1 \u0394\u03B9\u03AC\u03B8\u03B5\u03C3\u03B7\u03C2"
  - key: Hair
