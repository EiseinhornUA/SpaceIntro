  m_Name: LocalizationTable
  m_EditorClassIdentifier: 
  entries:
  - key: Pick the character that looks like you.
    translations:
    - language: 10
      value: Pick the character that looks like you.
    - language: 38
      value: "\u041E\u0431\u0435\u0440\u0438 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430,
        \u044F\u043A\u0438\u0439 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
        \u044F\u043A \u0442\u0438."
    - language: 28
      value: Escolhe a personagem que se parece contigo.
    - language: 34
      value: Elige el personaje que se parezca a ti.
    - language: 30
      value: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0445\u043E\u0436
        \u043D\u0430 \u0442\u0435\u0431\u044F."
    - language: 16
      value: "\u0395\u03C0\u03AF\u03BB\u03B5\u03BE\u03B5 \u03C4\u03BF\u03BD \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B1
        \u03C0\u03BF\u03C5 \u03C3\u03BF\u03C5 \u03BC\u03BF\u03B9\u03AC\u03B6\u03B5\u03B9."
  - key: Ok
    translations:
    - language: 10
      value: Ok
    - language: 38
      value: "\u0414\u043E\u0431\u0440\u0435"
    - language: 28
      value: Ok
    - language: 34
      value: Ok
    - language: 30
      value: "\u041E\u043A"
    - language: 16
      value: "\u0395\u03BD\u03C4\u03AC\u03BE\u03B5\u03B9"
  - key: Please complete the storyline first to review your profile.
    translations:
    - language: 10
      value: Please complete the storyline first to review your profile.
    - language: 38
      value: "\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443
        \u043F\u0440\u043E\u0439\u0434\u0438 \u0441\u044E\u0436\u0435\u0442, \u0449\u043E\u0431
        \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u0442\u0438 \u0441\u0432\u0456\u0439
        \u043F\u0440\u043E\u0444\u0456\u043B\u044C."
    - language: 28
      value: "Por favor, completa primeiro a hist\xF3ria para rever o teu perfil."
    - language: 34
      value: Por favor, completa primero la historia para revisar tu perfil.
    - language: 30
      value: "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0441\u043D\u0430\u0447\u0430\u043B\u0430
        \u043F\u0440\u043E\u0439\u0434\u0438 \u0441\u044E\u0436\u0435\u0442, \u0447\u0442\u043E\u0431\u044B
        \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0441\u0432\u043E\u0439
        \u043F\u0440\u043E\u0444\u0438\u043B\u044C."
    - language: 16
      value: "\u03A0\u03B1\u03C1\u03B1\u03BA\u03B1\u03BB\u03CE \u03BF\u03BB\u03BF\u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B5
        \u03C0\u03C1\u03CE\u03C4\u03B1 \u03C4\u03B7\u03BD \u03B9\u03C3\u03C4\u03BF\u03C1\u03AF\u03B1
        \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B4\u03B5\u03B9\u03C2 \u03C4\u03BF \u03C0\u03C1\u03BF\u03C6\u03AF\u03BB
        \u03C3\u03BF\u03C5."
  - key: Puzzle Power
    translations:
    - language: 10
      value: Puzzle Power
    - language: 38
