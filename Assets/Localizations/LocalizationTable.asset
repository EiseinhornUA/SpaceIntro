  m_Script: {fileID: 11500000, guid: e21a67a49d4758b4290470032ed95e9a, type: 3}
  m_Name: LocalizationTable
  m_EditorClassIdentifier: 
  entries:
  - key: Pick the character that looks like you.
    translations:
    - language: 10
      value: Pick the character that looks like you.
    - language: 38
      value: "\u041E\u0431\u0435\u0440\u0438 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430,
        \u044F\u043A\u0438\u0439 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
        \u044F\u043A \u0442\u0438."
    - language: 28
      value: Escolhe a personagem que se parece contigo.
    - language: 34
      value: Elige el personaje que se parezca a ti.
  - key: Ok
    translations:
    - language: 10
      value: Ok
    - language: 38
      value: "\u0414\u043E\u0431\u0440\u0435"
    - language: 28
      value: Ok
    - language: 34
      value: Ok
  - key: Please complete the storyline first to review your profile.
    translations:
    - language: 10
      value: Please complete the storyline first to review your profile.
    - language: 38
      value: "\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443
        \u043F\u0440\u043E\u0439\u0434\u0438 \u0441\u044E\u0436\u0435\u0442, \u0449\u043E\u0431
        \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u0442\u0438 \u0441\u0432\u0456\u0439
        \u043F\u0440\u043E\u0444\u0456\u043B\u044C."
    - language: 28
      value: "Por favor, completa primeiro a hist\xF3ria para rever o teu perfil."
    - language: 34
      value: Por favor, completa primero la historia para revisar tu perfil.
  - key: Puzzle Power
    translations:
    - language: 10
      value: Puzzle Power
    - language: 38
      value: "\u0421\u0438\u043B\u0430 \u0433\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043E\u043A"
    - language: 28
      value: Poder dos Puzzles
    - language: 34
      value: Poder de los Puzles
  - key: Credits
    translations:
    - language: 10
      value: Credits
    - language: 38
      value: "\u0422\u0438\u0442\u0440\u0438"
    - language: 28
      value: "Cr\xE9ditos"
    - language: 34
      value: "Cr\xE9ditos"
  - key: Truth Detector
    translations:
    - language: 10
      value: Truth Detector
    - language: 38
      value: "\u0414\u0435\u0442\u0435\u043A\u0442\u043E\u0440 \u043F\u0440\u0430\u0432\u0434\u0438"
    - language: 28
      value: Detector de Verdade
    - language: 34
      value: Detector de la Verdad
  - key: Report
    translations:
    - language: 10
      value: Report
    - language: 38
      value: "\u0417\u0432\u0456\u0442"
    - language: 28
      value: "Relat\xF3rio"
    - language: 34
      value: Informe
  - key: Settings
    translations:
    - language: 10
      value: Settings
    - language: 38
      value: "\u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F"
    - language: 28
      value: "Defini\xE7\xF5es"
    - language: 34
      value: Ajustes
  - key: Flex Mode
    translations:
    - language: 10
      value: Flex Mode
    - language: 38
      value: "\u0413\u043D\u0443\u0447\u043A\u0438\u0439 \u0440\u0435\u0436\u0438\u043C"
    - language: 28
      value: "Modo Flex\xEDvel"
    - language: 34
      value: Modo Flexible
  - key: Mood Radar
    translations:
    - language: 10
      value: Mood Radar
    - language: 38
      value: "\u0420\u0430\u0434\u0430\u0440 \u043D\u0430\u0441\u0442\u0440\u043E\u044E"
    - language: 28
      value: Radar de Humor
    - language: 34
      value: "Radar de Estado de \xC1nimo"
  - key: Hair
    translations:
    - language: 10
      value: Hair
    - language: 38
      value: "\u0417\u0430\u0447\u0456\u0441\u043A\u0430"
    - language: 28
      value: Cabelo
    - language: 34
      value: Cabello
  - key: Team Vibes
    translations:
    - language: 10
      value: Team Vibes
    - language: 38
      value: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u0456 \u0432\u0430\u0439\u0431\u0438"
    - language: 28
      value: "Vibra\xE7\xF5es da Equipa"
    - language: 34
      value: Vibras del Equipo
  - key: Yes
    translations:
    - language: 10
      value: Yes
    - language: 38
      value: "\u0422\u0430\u043A"
    - language: 28
      value: Sim
    - language: 34
      value: "S\xED"
  - key: Skin
    translations:
    - language: 10
      value: Skin
    - language: 38
      value: "\u041A\u043E\u043B\u0456\u0440 \u0448\u043A\u0456\u0440\u0438"
    - language: 28
      value: Tom de Pele
    - language: 34
      value: Tono de Piel
  - key: Loading...
    translations:
    - language: 10
      value: Loading...
    - language: 38
      value: "\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F..."
    - language: 28
      value: A carregar...
    - language: 34
      value: Cargando...
  - key: game progress will be reset
    translations:
    - language: 10
      value: All current game progress will be reset. Are you sure you want to start
        a new game?
    - language: 38
      value: "\u0423\u0432\u0435\u0441\u044C \u043F\u043E\u0442\u043E\u0447\u043D\u0438\u0439
        \u043F\u0440\u043E\u0433\u0440\u0435\u0441 \u0433\u0440\u0438 \u0431\u0443\u0434\u0435
        \u0441\u043A\u0438\u043D\u0443\u0442\u043E. \u0412\u0438 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0456,
        \u0449\u043E \u0445\u043E\u0447\u0435\u0442\u0435 \u043F\u043E\u0447\u0430\u0442\u0438
        \u043D\u043E\u0432\u0443 \u0433\u0440\u0443?"
    - language: 28
      value: "Todo o progresso atual do jogo ser\xE1 reposto. Tens a certeza de que
        queres iniciar um novo jogo?"
    - language: 34
      value: "Todo el progreso actual del juego se restablecer\xE1. \xBFEst\xE1s
        seguro de que quieres iniciar una nueva partida?"
  - key: Enter name...
    translations:
    - language: 10
      value: Enter name...
    - language: 38
      value: "\u0412\u0432\u0435\u0434\u0456\u0442\u044C \u0456\u043C\u2019\u044F..."
    - language: 28
      value: Introduzir nome...
    - language: 34
      value: Introducir nombre...
  - key: Introspection Profile
    translations:
    - language: 10
      value: Introspection Profile
    - language: 38
      value: "\u041F\u0440\u043E\u0444\u0456\u043B\u044C \u0441\u0430\u043C\u043E\u0430\u043D\u0430\u043B\u0456\u0437\u0443"
    - language: 28
      value: "Perfil de Introspe\xE7\xE3o"
    - language: 34
      value: "Perfil de Introspecci\xF3n"
  - key: Continue
    translations:
    - language: 10
      value: Continue
    - language: 38
      value: "\u041F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438"
    - language: 28
      value: Continuar
    - language: 34
      value: Continuar
  - key: New Game
    translations:
    - language: 10
      value: New Game
    - language: 38
      value: "\u041D\u043E\u0432\u0430 \u0433\u0440\u0430"
    - language: 28
      value: Novo Jogo
    - language: 34
      value: Nuevo Juego
  - key: No
    translations:
    - language: 10
      value: No
    - language: 38
      value: "\u041D\u0456"
    - language: 28
      value: "N\xE3o"
    - language: 34
      value: No
  - key: A skilled maker who always finds a clever workaround. You're a quick thinker
      who loves solving puzzles and improving systems.
    translations:
    - language: 10
      value: A skilled maker who always finds a clever workaround. You're a quick
        thinker who loves solving puzzles and improving systems.
    - language: 38
      value: "\u041C\u0430\u0439\u0441\u0442\u0435\u0440, \u044F\u043A\u0438\u0439
        \u0437\u0430\u0432\u0436\u0434\u0438 \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C
        \u0445\u0438\u0442\u0440\u0438\u0439 \u043E\u0431\u0445\u0456\u0434\u043D\u0438\u0439
        \u0448\u043B\u044F\u0445. \u0412\u0438 \u0448\u0432\u0438\u0434\u043A\u043E
        \u043C\u0438\u0441\u043B\u0438\u0442\u0435, \u043B\u044E\u0431\u0438\u0442\u0435
        \u0432\u0438\u0440\u0456\u0448\u0443\u0432\u0430\u0442\u0438 \u0433\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043A\u0438
        \u0442\u0430 \u043F\u043E\u043A\u0440\u0430\u0449\u0443\u0432\u0430\u0442\u0438
        \u0441\u0438\u0441\u0442\u0435\u043C\u0438."
    - language: 28
      value: "Um criador habilidoso que encontra sempre uma solu\xE7\xE3o engenhosa.
        Pensas r\xE1pido, adoras resolver enigmas e melhorar sistemas."
    - language: 34
      value: "Un creador h\xE1bil que siempre encuentra una soluci\xF3n ingeniosa.
        Piensas r\xE1pido, te encanta resolver acertijos y mejorar sistemas."
  - key: A natural-born leader. You're calm, competent, and amazing at getting people
      to work together.
    translations:
    - language: 10
      value: A natural-born leader. You're calm, competent, and amazing at getting
        people to work together.
    - language: 38
      value: "\u041F\u0440\u0438\u0440\u043E\u0434\u0436\u0435\u043D\u0438\u0439
        \u043B\u0456\u0434\u0435\u0440. \u0412\u0438 \u0441\u043F\u043E\u043A\u0456\u0439\u043D\u0456,
        \u043A\u043E\u043C\u043F\u0435\u0442\u0435\u043D\u0442\u043D\u0456 \u0442\u0430
        \u0447\u0443\u0434\u043E\u0432\u043E \u0432\u043C\u0456\u0454\u0442\u0435
        \u043E\u0431\u2019\u0454\u0434\u043D\u0443\u0432\u0430\u0442\u0438 \u043B\u044E\u0434\u0435\u0439
        \u0434\u043B\u044F \u0440\u043E\u0431\u043E\u0442\u0438 \u0440\u0430\u0437\u043E\u043C."
    - language: 28
      value: "Um l\xEDder nato. \xC9s calmo, competente e incr\xEDvel a fazer as
        pessoas trabalharem em equipa."
    - language: 34
      value: "Un l\xEDder nato. Eres calmado, competente y asombroso para lograr
        que las personas trabajen juntas."
  - key: A rule-breaker and system-breaker. You learn by taking things apart and
      building them back better.
    translations:
    - language: 10
      value: A rule-breaker and system-breaker. You learn by taking things apart
        and building them back better.
    - language: 38
      value: "\u041F\u043E\u0440\u0443\u0448\u043D\u0438\u043A \u043F\u0440\u0430\u0432\u0438\u043B
        \u0442\u0430 \u0441\u0438\u0441\u0442\u0435\u043C. \u0412\u0438 \u0432\u0447\u0438\u0442\u0435\u0441\u044F,
        \u0440\u043E\u0437\u0431\u0438\u0440\u0430\u044E\u0447\u0438 \u0440\u0435\u0447\u0456
        \u0442\u0430 \u0437\u0431\u0438\u0440\u0430\u044E\u0447\u0438 \u0457\u0445
        \u043A\u0440\u0430\u0449\u0435."
    - language: 28
      value: Um transgressor de regras e sistemas. Aprendes desmontando coisas e
        reconstruindo-as melhor.
    - language: 34
      value: "Un rompe-reglas y rompe-sistemas. Aprendes desarmando cosas y reconstruy\xE9ndolas
        mejor."
  - key: Empathic and attentive. You bring calm to a crisis, sense what others are
      feeling, and are often the unsung hero.
    translations:
    - language: 10
      value: Empathic and attentive. You bring calm to a crisis, sense what others
        are feeling, and are often the unsung hero.
    - language: 38
      value: "\u0415\u043C\u043F\u0430\u0442\u0438\u0447\u043D\u0438\u0439 \u0456
        \u0443\u0432\u0430\u0436\u043D\u0438\u0439. \u0412\u0438 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u0435
        \u0441\u043F\u043E\u043A\u0456\u0439 \u0443 \u043A\u0440\u0438\u0437\u0443,
        \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u0435, \u0449\u043E
        \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E\u0442\u044C \u0456\u043D\u0448\u0456,
        \u0456 \u0447\u0430\u0441\u0442\u043E \u0454 \u043D\u0435\u043F\u043E\u043C\u0456\u0447\u0435\u043D\u0438\u043C
        \u0433\u0435\u0440\u043E\u0454\u043C."
    - language: 28
      value: "Emp\xE1tico e atento. Trazes calma em crises, sentes o que os outros
        est\xE3o a sentir e muitas vezes \xE9s o her\xF3i desconhecido."
    - language: 34
      value: "Emp\xE1tico y atento. Traes calma en una crisis, percibes lo que sienten
        los dem\xE1s y a menudo eres el h\xE9roe desconocido."
  - key: Calm under pressure, you see all sides of a problem. You're the bridge between
      logic, teamwork, and intuition.
    translations:
    - language: 10
      value: Calm under pressure, you see all sides of a problem. You're the bridge
        between logic, teamwork, and intuition.
    - language: 38
      value: "\u0421\u043F\u043E\u043A\u0456\u0439\u043D\u0438\u0439 \u043F\u0456\u0434
        \u0442\u0438\u0441\u043A\u043E\u043C, \u0432\u0438 \u0431\u0430\u0447\u0438\u0442\u0435
        \u0432\u0441\u0456 \u0441\u0442\u043E\u0440\u043E\u043D\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0438.
        \u0412\u0438 \u043C\u0456\u0441\u0442 \u043C\u0456\u0436 \u043B\u043E\u0433\u0456\u043A\u043E\u044E,
        \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u044E \u0440\u043E\u0431\u043E\u0442\u043E\u044E
        \u0442\u0430 \u0456\u043D\u0442\u0443\u0457\u0446\u0456\u0454\u044E."
    - language: 28
      value: "Calmo sob press\xE3o, v\xEAs todos os lados de um problema. \xC9s a
        ponte entre l\xF3gica, trabalho em equipa e intui\xE7\xE3o."
    - language: 34
      value: "Calmado bajo presi\xF3n, ves todos los lados de un problema. Eres el
        puente entre la l\xF3gica, el trabajo en equipo y la intuici\xF3n."
  - key: A witty improviser who bends the rules to win. You're a charming and manipulative
      social hacker.
    translations:
    - language: 10
      value: A witty improviser who bends the rules to win. You're a charming and
        manipulative social hacker.
    - language: 38
      value: "\u0414\u043E\u0442\u0435\u043F\u043D\u0438\u0439 \u0456\u043C\u043F\u0440\u043E\u0432\u0456\u0437\u0430\u0442\u043E\u0440,
        \u044F\u043A\u0438\u0439 \u043F\u043E\u0440\u0443\u0448\u0443\u0454 \u043F\u0440\u0430\u0432\u0438\u043B\u0430,
        \u0449\u043E\u0431 \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0442\u0438.
        \u0412\u0438 \u0447\u0430\u0440\u0456\u0432\u043D\u0438\u0439 \u0456 \u043C\u0430\u043D\u0456\u043F\u0443\u043B\u044F\u0442\u0438\u0432\u043D\u0438\u0439
        \u0441\u043E\u0446\u0456\u0430\u043B\u044C\u043D\u0438\u0439 \u0445\u0430\u043A\u0435\u0440. "
    - language: 28
      value: "Um improvisador espirituoso que dobra as regras para vencer. \xC9s
        um hacker social charmoso e manipulador. "
    - language: 34
      value: 'Un improvisador ingenioso que dobla las reglas para ganar. Eres un
        hacker social encantador y manipulador. '
  - key: Play
    translations:
    - language: 10
      value: Play
    - language: 38
      value: "\u0413\u0440\u0430\u0442\u0438"
    - language: 28
      value: Jogar
    - language: 34
      value: Jugar
  - key: Looks like this challenge is taking some time. Do you want to skip it or
      keep playing?
    translations:
    - language: 10
      value: Looks like this challenge is taking some time. Do you want to skip it
        or keep playing?
    - language: 38
      value: "\u0421\u0445\u043E\u0436\u0435, \u0446\u0435 \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u043D\u044F
        \u0437\u0430\u0439\u043C\u0430\u0454 \u0431\u0430\u0433\u0430\u0442\u043E
        \u0447\u0430\u0441\u0443. \u0425\u043E\u0447\u0435\u0448 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0438
        \u0439\u043E\u0433\u043E \u0447\u0438 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438
        \u0433\u0440\u0443?"
    - language: 28
      value: "Parece que este desafio est\xE1 a demorar algum tempo. Queres salt\xE1-lo
        ou continuar a jogar?"
    - language: 34
      value: "Parece que este desaf\xEDo est\xE1 llevando algo de tiempo. \xBFQuieres
        omitirlo o seguir jugando?"
  - key: Ask Robot
    translations:
    - language: 10
      value: Ask Robot
    - language: 38
      value: "\u0417\u0430\u043F\u0438\u0442\u0430\u0442\u0438 \u0440\u043E\u0431\u043E\u0442\u0430"
    - language: 28
      value: "Perguntar ao rob\xF4"
    - language: 34
      value: Preguntar al robot
  - key: Hold Up, Explorer!
    translations:
    - language: 10
      value: Hold Up, Explorer!
    - language: 38
      value: "\u0417\u0430\u0447\u0435\u043A\u0430\u0439, \u0434\u043E\u0441\u043B\u0456\u0434\u043D\u0438\u043A\u0443!"
    - language: 28
      value: Espera, Explorador!
    - language: 34
      value: "\xA1Espera, Explorador!"
  - key: Skip
    translations:
    - language: 10
      value: Skip
    - language: 38
      value: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0438"
    - language: 28
      value: Saltar
    - language: 34
      value: Omitir
  - key: Radio Settings
    translations:
    - language: 10
      value: Radio Settings
    - language: 38
      value: "\u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
        \u0440\u0430\u0434\u0456\u043E"
    - language: 28
      value: "Defini\xE7\xF5es de r\xE1dio"
    - language: 34
      value: Ajustes de radio
  - key: Skipping chats = missing clues about you
    translations:
    - language: 10
      value: Skipping chats = missing clues about you
    - language: 38
      value: "\u041F\u0440\u043E\u043F\u0443\u0441\u043A \u0434\u0456\u0430\u043B\u043E\u0433\u0456\u0432
        = \u0432\u0442\u0440\u0430\u0442\u0430 \u043F\u0456\u0434\u043A\u0430\u0437\u043E\u043A
        \u043F\u0440\u043E \u0442\u0435\u0431\u0435"
    - language: 28
      value: "Saltar di\xE1logos = perder pistas sobre ti"
    - language: 34
      value: "Saltar di\xE1logos = perder pistas sobre ti"
  - key: 'Instructions: Tap a bolt to unscrew it. Then tap a hole where you want
      to put the bolt. Remove all the panels.'
    translations:
    - language: 10
      value: 'Instructions: Tap a bolt to unscrew it. Then tap a hole where you want
        to put the bolt. Remove all the panels.'
    - language: 38
      value: "\u0406\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u0457: \u0422\u043E\u0440\u043A\u043D\u0438\u0441\u044F
        \u0431\u043E\u043B\u0442\u0430, \u0449\u043E\u0431 \u0432\u0456\u0434\u043A\u0440\u0443\u0442\u0438\u0442\u0438
        \u0439\u043E\u0433\u043E. \u041F\u043E\u0442\u0456\u043C \u0442\u043E\u0440\u043A\u043D\u0438\u0441\u044F
        \u043E\u0442\u0432\u043E\u0440\u0443, \u043A\u0443\u0434\u0438 \u0445\u043E\u0447\u0435\u0448
        \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0431\u043E\u043B\u0442.
        \u0417\u043D\u0456\u043C\u0438 \u0432\u0441\u0456 \u043F\u0430\u043D\u0435\u043B\u0456."
    - language: 28
      value: "Instru\xE7\xF5es: Toca num parafuso para o desapertar. Depois toca
        num buraco onde queres colocar o parafuso. Remove todos os pain\xE9is."
    - language: 34
      value: 'Instrucciones: Toca un tornillo para desenroscarlo. Luego toca un agujero
        donde quieras poner el tornillo. Quita todos los paneles.'
  - key: Tasks
    translations:
    - language: 10
      value: Tasks
    - language: 38
      value: "\u0417\u0430\u0432\u0434\u0430\u043D\u043D\u044F"
    - language: 28
      value: Tarefas
    - language: 34
      value: Tareas
  - key: Reports
    translations:
    - language: 10
      value: Reports
    - language: 38
      value: "\u0417\u0432\u0456\u0442\u0438"
    - language: 28
      value: "Relat\xF3rios"
    - language: 34
      value: Informes
  - key: Inventory
    translations:
    - language: 10
      value: Inventory
    - language: 38
      value: "\u0406\u043D\u0432\u0435\u043D\u0442\u0430\u0440"
    - language: 28
      value: "Invent\xE1rio"
    - language: 34
      value: Inventario
  - key: Chat
    translations:
    - language: 10
      value: Chat
    - language: 38
      value: "\u0427\u0430\u0442"
    - language: 28
      value: Chat
    - language: 34
      value: Chat
  - key: Find out what happend
    translations:
    - language: 10
      value: Find out what happend
    - language: 38
      value: "\u0414\u0456\u0437\u043D\u0430\u0439\u0441\u044F, \u0449\u043E \u0441\u0442\u0430\u043B\u043E\u0441\u044F"
    - language: 28
      value: Descobre o que aconteceu
    - language: 34
      value: "Averigua qu\xE9 pas\xF3"
  - key: Description
    translations:
    - language: 10
      value: Description
    - language: 38
      value: "\u041E\u043F\u0438\u0441"
    - language: 28
      value: "Descri\xE7\xE3o"
    - language: 34
      value: "Descripci\xF3n"
  - key: Robot
    translations:
    - language: 10
      value: Robot
    - language: 38
      value: "\u0420\u043E\u0431\u043E\u0442"
    - language: 28
      value: "Rob\xF4"
    - language: 34
      value: Robot
  - key: How can I assist you?
    translations:
    - language: 10
      value: How can I assist you?
    - language: 38
      value: "\u0427\u0438\u043C \u044F \u043C\u043E\u0436\u0443 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438?"
    - language: 28
      value: Como posso ajudar?
    - language: 34
      value: "\xBFC\xF3mo puedo ayudarte?"
  - key: Enter the question...
    translations:
    - language: 10
      value: Enter the question...
    - language: 38
      value: "\u0412\u0432\u0435\u0434\u0438 \u0437\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F..."
    - language: 28
      value: Introduz a pergunta...
    - language: 34
      value: Introduce la pregunta...
  - key: Ask
    translations:
    - language: 10
      value: Ask
    - language: 38
      value: "\u0417\u0430\u043F\u0438\u0442\u0430\u0442\u0438"
    - language: 28
      value: Perguntar
    - language: 34
      value: Preguntar
  - key: Arrange tetrominoes in the grid. Tap to rotate.
    translations:
    - language: 10
      value: Arrange tetrominoes in the grid. Tap to rotate.
    - language: 38
      value: "\u0420\u043E\u0437\u043C\u0456\u0441\u0442\u0438 \u0442\u0435\u0442\u0440\u043E\u043C\u0456\u043D\u043E
        \u0432 \u0441\u0456\u0442\u0446\u0456. \u0422\u043E\u0440\u043A\u043D\u0438\u0441\u044F,
        \u0449\u043E\u0431 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438."
    - language: 28
      value: "Organiza os tetramin\xF3s na grelha. Toca para rodar."
    - language: 34
      value: "Organiza los tetromin\xF3s en la cuadr\xEDcula. Toca para rotar."
  - key: "Every answer you pick helps the system learn your style. So slow down,
      read, and choose like it means something (\u2019cause it does)."
    translations:
    - language: 10
      value: "Every answer you pick helps the system learn your style. So slow down,
        read, and choose like it means something (\u2019cause it does)."
    - language: 38
      value: "\u041A\u043E\u0436\u043D\u0430 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C,
        \u044F\u043A\u0443 \u0442\u0438 \u043E\u0431\u0438\u0440\u0430\u0454\u0448,
        \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454 \u0441\u0438\u0441\u0442\u0435\u043C\u0456
        \u0432\u0438\u0432\u0447\u0430\u0442\u0438 \u0442\u0432\u0456\u0439 \u0441\u0442\u0438\u043B\u044C.
        \u0422\u043E\u0436 \u043D\u0435 \u043F\u043E\u0441\u043F\u0456\u0448\u0430\u0439,
        \u0447\u0438\u0442\u0430\u0439 \u0456 \u043E\u0431\u0438\u0440\u0430\u0439
        \u0442\u0430\u043A, \u043D\u0456\u0431\u0438 \u0446\u0435 \u043C\u0430\u0454
        \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F (\u0431\u043E \u0442\u0430\u043A
        \u0456 \u0454)."
    - language: 28
      value: "Cada resposta que escolhes ajuda o sistema a aprender o teu estilo.
        Por isso abranda, l\xEA e escolhe como se isso tivesse import\xE2ncia (porque
        tem)."
    - language: 34
      value: "Cada respuesta que eliges ayuda al sistema a aprender tu estilo. As\xED
        que ve con calma, lee y elige como si importara (porque importa)."
  - key: Find the Code
    translations:
    - language: 10
      value: Find the Code
    - language: 38
      value: "\u0417\u043D\u0430\u0439\u0434\u0438 \u043A\u043E\u0434"
    - language: 28
      value: "Encontra o c\xF3digo"
    - language: 34
      value: "Encuentra el c\xF3digo"
  - key: "The door won\u2019t budge without an access code. Search the first floor
      to track it down."
    translations:
    - language: 10
      value: "The door won\u2019t budge without an access code. Search the first
        floor to track it down."
    - language: 38
      value: "\u0414\u0432\u0435\u0440\u0456 \u043D\u0435 \u0432\u0456\u0434\u0447\u0438\u043D\u044F\u0442\u044C\u0441\u044F
        \u0431\u0435\u0437 \u043A\u043E\u0434\u0443 \u0434\u043E\u0441\u0442\u0443\u043F\u0443.
        \u041E\u0431\u0448\u0443\u043A\u0430\u0439 \u043F\u0435\u0440\u0448\u0438\u0439
        \u043F\u043E\u0432\u0435\u0440\u0445, \u0449\u043E\u0431 \u0437\u043D\u0430\u0439\u0442\u0438
        \u0439\u043E\u0433\u043E."
    - language: 28
      value: "A porta n\xE3o se mexe sem um c\xF3digo de acesso. Explora o primeiro
        piso para o encontrar."
    - language: 34
      value: "La puerta no se mover\xE1 sin un c\xF3digo de acceso. Explora la primera
        planta para encontrarlo."
  - key: Guess the Code
    translations:
    - language: 10
      value: Guess the Code
    - language: 38
      value: "\u0412\u0433\u0430\u0434\u0430\u0439 \u043A\u043E\u0434"
    - language: 28
      value: "Adivinha o c\xF3digo"
    - language: 34
      value: "Adivina el c\xF3digo"
  - key: The numpad wants a number. Guess the code in reports and type it in. If
      you get it right, the door will giggle and open. If not, it will give you a
      sassy beep - error.
    translations:
    - language: 10
      value: The numpad wants a number. Guess the code in reports and type it in.
        If you get it right, the door will giggle and open. If not, it will give
        you a sassy beep - error.
    - language: 38
      value: "\u041A\u043B\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0430 \u0447\u0435\u043A\u0430\u0454
        \u0447\u0438\u0441\u043B\u043E. \u0412\u0433\u0430\u0434\u0430\u0439 \u043A\u043E\u0434
        \u0443 \u0437\u0432\u0456\u0442\u0430\u0445 \u0456 \u0432\u0432\u0435\u0434\u0438
        \u0439\u043E\u0433\u043E. \u042F\u043A\u0449\u043E \u0432\u0433\u0430\u0434\u0430\u0454\u0448,
        \u0434\u0432\u0435\u0440\u0456 \u0445\u0438\u0445\u0438\u043A\u043D\u0443\u0442\u044C
        \u0456 \u0432\u0456\u0434\u0447\u0438\u043D\u044F\u0442\u044C\u0441\u044F.
        \u042F\u043A\u0449\u043E \u043D\u0456 \u2014 \u043F\u0440\u043E\u043B\u0443\u043D\u0430\u0454
        \u0437\u0443\u0445\u0432\u0430\u043B\u0438\u0439 \u0441\u0438\u0433\u043D\u0430\u043B
        \u043F\u043E\u043C\u0438\u043B\u043A\u0438."
    - language: 28
      value: "O teclado num\xE9rico quer um n\xFAmero. Adivinha o c\xF3digo nos relat\xF3rios
        e introduz-o. Se acertares, a porta vai rir e abrir. Caso contr\xE1rio, vais
        ouvir um bip atrevido \u2014 erro."
    - language: 34
      value: "El teclado num\xE9rico quiere un n\xFAmero. Adivina el c\xF3digo en
        los informes y escr\xEDbelo. Si aciertas, la puerta soltar\xE1 una risita
        y se abrir\xE1. Si no, te dar\xE1 un pitido burl\xF3n de error."
  - key: Find the diagram
    translations:
    - language: 10
      value: Find the diagram
    - language: 38
      value: "\u0417\u043D\u0430\u0439\u0434\u0438 \u0441\u0445\u0435\u043C\u0443"
    - language: 28
      value: Encontra o diagrama
    - language: 34
      value: Encuentra el diagrama
  - key: "The door won\u2019t budge. Find the diagram on the first floor and give
      it to your robot helper so it can hack the lock for you."
    translations:
    - language: 10
      value: "The door won\u2019t budge. Find the diagram on the first floor and
        give it to your robot helper so it can hack the lock for you."
    - language: 38
      value: "\u0414\u0432\u0435\u0440\u0456 \u043D\u0435 \u0432\u0456\u0434\u0447\u0438\u043D\u044F\u044E\u0442\u044C\u0441\u044F.
        \u0417\u043D\u0430\u0439\u0434\u0438 \u0441\u0445\u0435\u043C\u0443 \u043D\u0430
        \u043F\u0435\u0440\u0448\u043E\u043C\u0443 \u043F\u043E\u0432\u0435\u0440\u0441\u0456
        \u0439 \u043F\u0435\u0440\u0435\u0434\u0430\u0439 \u0457\u0457 \u0440\u043E\u0431\u043E\u0442\u0443-\u043F\u043E\u043C\u0456\u0447\u043D\u0438\u043A\u0443,
        \u0449\u043E\u0431 \u0432\u0456\u043D \u0437\u043B\u0430\u043C\u0430\u0432
        \u0437\u0430\u043C\u043E\u043A."
    - language: 28
      value: "A porta n\xE3o se mexe. Encontra o diagrama no primeiro piso e entrega-o
        ao teu rob\xF4 ajudante para que ele possa piratear a fechadura."
    - language: 34
      value: "La puerta no se mueve. Encuentra el diagrama en la primera planta y
        d\xE1selo a tu robot ayudante para que pueda piratear la cerradura."
  - key: Override Lock
    translations:
    - language: 10
      value: Override Lock
    - language: 38
      value: "\u041E\u0431\u0456\u0439\u0434\u0438 \u0431\u043B\u043E\u043A\u0443\u0432\u0430\u043D\u043D\u044F"
    - language: 28
      value: Anular a fechadura
    - language: 34
      value: Anular la cerradura
  - key: The door is locked. Take the robot to the door terminal and let it use the
      diagram to reconfigure the lock. When the robot finishes, the door will release.
    translations:
    - language: 10
      value: The door is locked. Take the robot to the door terminal and let it use
        the diagram to reconfigure the lock. When the robot finishes, the door will
        release.
    - language: 38
      value: "\u0414\u0432\u0435\u0440\u0456 \u0437\u0430\u0447\u0438\u043D\u0435\u043D\u0456.
        \u0412\u0456\u0434\u0432\u0435\u0434\u0438 \u0440\u043E\u0431\u043E\u0442\u0430
        \u0434\u043E \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0430 \u0434\u0432\u0435\u0440\u0435\u0439
        \u0456 \u0434\u043E\u0437\u0432\u043E\u043B\u044C \u0439\u043E\u043C\u0443
        \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438 \u0441\u0445\u0435\u043C\u0443
        \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
        \u0437\u0430\u043C\u043A\u0430. \u041A\u043E\u043B\u0438 \u0440\u043E\u0431\u043E\u0442
        \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u044C, \u0434\u0432\u0435\u0440\u0456
        \u0432\u0456\u0434\u0447\u0438\u043D\u044F\u0442\u044C\u0441\u044F."
    - language: 28
      value: "A porta est\xE1 trancada. Leva o rob\xF4 at\xE9 ao terminal da porta
        e deixa-o usar o diagrama para reconfigurar a fechadura. Quando terminar,
        a porta ir\xE1 abrir."
    - language: 34
      value: "La puerta est\xE1 cerrada. Lleva al robot al terminal de la puerta
        y deja que use el diagrama para reconfigurar la cerradura. Cuando termine,
        la puerta se liberar\xE1."
  - key: Unlock the door
    translations:
    - language: 10
      value: Unlock the door
    - language: 38
      value: "\u0412\u0456\u0434\u0456\u043C\u043A\u043D\u0438 \u0434\u0432\u0435\u0440\u0456"
    - language: 28
      value: Destranca a porta
    - language: 34
      value: Desbloquea la puerta
  - key: "The door won\u2019t budge. Grab your tools and start tinkering. Twist,
      pry, and fiddle with the mechanism until it clicks - then the door will easily
      open."
    translations:
    - language: 10
      value: "The door won\u2019t budge. Grab your tools and start tinkering. Twist,
        pry, and fiddle with the mechanism until it clicks - then the door will easily
        open."
    - language: 38
      value: "\u0414\u0432\u0435\u0440\u0456 \u043D\u0435 \u043F\u0456\u0434\u0434\u0430\u044E\u0442\u044C\u0441\u044F.
        \u0412\u0456\u0437\u044C\u043C\u0438 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438
        \u0439 \u043F\u043E\u0447\u0438\u043D\u0430\u0439 \u043C\u0430\u0439\u0441\u0442\u0440\u0443\u0432\u0430\u0442\u0438.
        \u041A\u0440\u0443\u0442\u0438, \u043F\u0456\u0434\u0432\u0430\u0436\u0443\u0439
        \u0456 \u0432\u043E\u0437\u0438\u0441\u044F \u0437 \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u043E\u043C,
        \u043F\u043E\u043A\u0438 \u043D\u0435 \u043A\u043B\u0430\u0446\u043D\u0435
        \u2014 \u0442\u043E\u0434\u0456 \u0434\u0432\u0435\u0440\u0456 \u043B\u0435\u0433\u043A\u043E
        \u0432\u0456\u0434\u0447\u0438\u043D\u044F\u0442\u044C\u0441\u044F."
    - language: 28
      value: "A porta n\xE3o se mexe. Agarra nas ferramentas e come\xE7a a mexer.
        Roda, for\xE7a e ajusta o mecanismo at\xE9 fazer clique \u2014 depois a porta
        abrir\xE1 facilmente."
    - language: 34
      value: "La puerta no cede. Coge tus herramientas y empieza a trastear. Gira,
        haz palanca y manipula el mecanismo hasta que haga clic; entonces la puerta
        se abrir\xE1 sin problema."
  - key: Gather the Tools
    translations:
    - language: 10
      value: Gather the Tools
    - language: 38
      value: "\u0417\u0431\u0435\u0440\u0438 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438"
    - language: 28
      value: Recolhe as ferramentas
    - language: 34
      value: "Re\xFAne las herramientas"
  - key: "The door\u2019s broken and needs fixing. Head to the second floor to collect
      the soldering iron and a diagnostic tool."
    translations:
    - language: 10
      value: "The door\u2019s broken and needs fixing. Head to the second floor to
        collect the soldering iron and a diagnostic tool."
    - language: 38
      value: "\u0414\u0432\u0435\u0440\u0456 \u0437\u043B\u0430\u043C\u0430\u043D\u0456
        \u0439 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u044E\u0442\u044C \u0440\u0435\u043C\u043E\u043D\u0442\u0443.
        \u0412\u0438\u0440\u0443\u0448\u0430\u0439 \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0439
        \u043F\u043E\u0432\u0435\u0440\u0445, \u0449\u043E\u0431 \u0437\u0456\u0431\u0440\u0430\u0442\u0438
        \u043F\u0430\u044F\u043B\u044C\u043D\u0438\u043A \u0456 \u0434\u0456\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u0447\u043D\u0438\u0439
        \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442."
    - language: 28
      value: "A porta est\xE1 avariada e precisa de repara\xE7\xE3o. Vai ao segundo
        piso recolher o ferro de soldar e a ferramenta de diagn\xF3stico."
    - language: 34
      value: "La puerta est\xE1 rota y necesita reparaci\xF3n. Ve a la segunda planta
        para recoger el soldador y la herramienta de diagn\xF3stico."
  - key: Suit Up
    translations:
    - language: 10
      value: Suit Up
    - language: 38
      value: "\u041E\u0434\u044F\u0433\u043D\u0438\u0441\u044C"
    - language: 28
      value: Equipa-te
    - language: 34
      value: "Equ\xEDpate"
  - key: "Head to the space suit and get ready for whatever\u2019s waiting in the
      corridor."
    translations:
    - language: 10
      value: "Head to the space suit and get ready for whatever\u2019s waiting in
        the corridor."
    - language: 38
      value: "\u041F\u0456\u0434\u0456\u0439\u0434\u0438 \u0434\u043E \u0441\u043A\u0430\u0444\u0430\u043D\u0434\u0440\u0430
        \u0439 \u043F\u0456\u0434\u0433\u043E\u0442\u0443\u0439\u0441\u044F \u0434\u043E
        \u0432\u0441\u044C\u043E\u0433\u043E, \u0449\u043E \u0447\u0435\u043A\u0430\u0454
        \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0456."
    - language: 28
      value: "Vai at\xE9 ao fato espacial e prepara-te para o que quer que te espere
        no corredor."
    - language: 34
      value: "Dir\xEDgete al traje espacial y prep\xE1rate para lo que te espere
        en el pasillo."
  - key: Power Up
    translations:
    - language: 10
      value: Power Up
    - language: 38
      value: "\u0423\u0432\u0456\u043C\u043A\u043D\u0438 \u0436\u0438\u0432\u043B\u0435\u043D\u043D\u044F"
    - language: 28
      value: Liga a energia
    - language: 34
      value: "Enciende la energ\xEDa"
  - key: "Everything\u2019s offline when you wake up. Head to the terminal and bring
      the station back to life."
    translations:
    - language: 10
      value: "Everything\u2019s offline when you wake up. Head to the terminal and
        bring the station back to life."
    - language: 38
      value: "\u041A\u043E\u043B\u0438 \u0442\u0438 \u043F\u0440\u043E\u043A\u0438\u0434\u0430\u0454\u0448\u0441\u044F,
        \u0443\u0441\u0435 \u0432\u0438\u043C\u043A\u043D\u0435\u043D\u043E. \u0406\u0434\u0438
        \u0434\u043E \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0430 \u0439
        \u043F\u043E\u0432\u0435\u0440\u043D\u0438 \u0441\u0442\u0430\u043D\u0446\u0456\u044E
        \u0434\u043E \u0436\u0438\u0442\u0442\u044F."
    - language: 28
      value: "Tudo est\xE1 desligado quando acordas. Vai ao terminal e devolve a
        vida \xE0 esta\xE7\xE3o."
    - language: 34
      value: "Todo est\xE1 apagado cuando despiertas. Ve al terminal y devuelve la
        vida a la estaci\xF3n."
  - key: Grab the Axe
    translations:
    - language: 10
      value: Grab the Axe
    - language: 38
      value: "\u0412\u0456\u0437\u044C\u043C\u0438 \u0441\u043E\u043A\u0438\u0440\u0443"
    - language: 28
      value: Apanha o machado
    - language: 34
      value: Coge el hacha
  - key: The roots are blocking your way out. To get the axe, you first need to find
      the code. Unlock it, grab the axe, and chop your way out of the station.
    translations:
    - language: 10
      value: The roots are blocking your way out. To get the axe, you first need
        to find the code. Unlock it, grab the axe, and chop your way out of the station.
    - language: 38
      value: "\u041A\u043E\u0440\u0456\u043D\u043D\u044F \u0431\u043B\u043E\u043A\u0443\u0454
        \u0432\u0438\u0445\u0456\u0434. \u0429\u043E\u0431 \u0434\u0456\u0441\u0442\u0430\u0442\u0438
        \u0441\u043E\u043A\u0438\u0440\u0443, \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443
        \u0437\u043D\u0430\u0439\u0434\u0438 \u043A\u043E\u0434. \u0412\u0456\u0434\u0456\u043C\u043A\u043D\u0438,
        \u0432\u0456\u0437\u044C\u043C\u0438 \u0441\u043E\u043A\u0438\u0440\u0443
        \u0439 \u043F\u0440\u043E\u0440\u0443\u0431\u0430\u0439 \u0441\u043E\u0431\u0456
        \u0448\u043B\u044F\u0445 \u0437\u0456 \u0441\u0442\u0430\u043D\u0446\u0456\u0457."
    - language: 28
      value: "As ra\xEDzes est\xE3o a bloquear a sa\xEDda. Para obteres o machado,
        primeiro tens de encontrar o c\xF3digo. Desbloqueia, pega no machado e abre
        caminho para fora da esta\xE7\xE3o."
    - language: 34
      value: "Las ra\xEDces bloquean la salida. Para conseguir el hacha, primero
        debes encontrar el c\xF3digo. Desbloqu\xE9ala, toma el hacha y \xE1brete
        paso fuera de la estaci\xF3n."
  - key: Find the screwdriver
    translations:
    - language: 10
      value: Find the screwdriver
    - language: 38
      value: "\u0417\u043D\u0430\u0439\u0434\u0438 \u0432\u0438\u043A\u0440\u0443\u0442\u043A\u0443"
    - language: 28
      value: Encontra a chave de fendas
    - language: 34
      value: Encuentra el destornillador
  - key: "The terminal won\u2019t work without a little help. Find the screwdriver,
      and open its back panel to fix it."
    translations:
    - language: 10
      value: "The terminal won\u2019t work without a little help. Find the screwdriver,
        and open its back panel to fix it."
    - language: 38
      value: "\u0422\u0435\u0440\u043C\u0456\u043D\u0430\u043B \u043D\u0435 \u043F\u0440\u0430\u0446\u044E\u0454
        \u0431\u0435\u0437 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0438. \u0417\u043D\u0430\u0439\u0434\u0438
        \u0432\u0438\u043A\u0440\u0443\u0442\u043A\u0443 \u0439 \u0432\u0456\u0434\u043A\u0440\u0438\u0439
        \u0437\u0430\u0434\u043D\u044E \u043F\u0430\u043D\u0435\u043B\u044C, \u0449\u043E\u0431
        \u0439\u043E\u0433\u043E \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438."
    - language: 28
      value: "O terminal n\xE3o funciona sem uma ajudinha. Encontra a chave de fendas
        e abre o painel traseiro para o reparar."
    - language: 34
      value: "El terminal no funcionar\xE1 sin un poco de ayuda. Encuentra el destornillador
        y abre el panel trasero para arreglarlo."
  - key: Find Anyone
    translations:
    - language: 10
      value: Find Anyone
    - language: 38
      value: "\u0417\u043D\u0430\u0439\u0434\u0438 \u043A\u043E\u0433\u043E\u0441\u044C"
    - language: 28
      value: "Encontra algu\xE9m"
    - language: 34
      value: Encuentra a alguien
  - key: The station feels empty. Explore the corridors and look for any sign of
      another person.
    translations:
    - language: 10
      value: The station feels empty. Explore the corridors and look for any sign
        of another person.
    - language: 38
      value: "\u0421\u0442\u0430\u043D\u0446\u0456\u044F \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F
        \u043F\u043E\u0440\u043E\u0436\u043D\u044C\u043E\u044E. \u0414\u043E\u0441\u043B\u0456\u0434\u0438
        \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0438 \u0439 \u0448\u0443\u043A\u0430\u0439
        \u0431\u0443\u0434\u044C-\u044F\u043A\u0456 \u043E\u0437\u043D\u0430\u043A\u0438
        \u0456\u043D\u0448\u043E\u0457 \u043B\u044E\u0434\u0438\u043D\u0438."
    - language: 28
      value: "A esta\xE7\xE3o parece vazia. Explora os corredores e procura qualquer
        sinal de outra pessoa."
    - language: 34
      value: "La estaci\xF3n se siente vac\xEDa. Explora los pasillos y busca cualquier
        se\xF1al de otra persona."
  - key: Go to the Engineering Door
    translations:
    - language: 10
      value: Go to the Engineering Door
    - language: 38
      value: "\u0406\u0434\u0438 \u0434\u043E \u0456\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u0438\u0445
        \u0434\u0432\u0435\u0440\u0435\u0439"
    - language: 28
      value: "Vai at\xE9 \xE0 porta da Engenharia"
    - language: 34
      value: "Ve a la puerta de Ingenier\xEDa"
  - key: "You need to get into the engineering corridor. Go to the big metal door
      and try to open it\u2026 but of course, it is broken and does not want to listen."
    translations:
    - language: 10
      value: "You need to get into the engineering corridor. Go to the big metal
        door and try to open it\u2026 but of course, it is broken and does not want
        to listen."
    - language: 38
      value: "\u0422\u043E\u0431\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438 \u0432 \u0456\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u0438\u0439
        \u043A\u043E\u0440\u0438\u0434\u043E\u0440. \u041F\u0456\u0434\u0456\u0439\u0434\u0438
        \u0434\u043E \u0432\u0435\u043B\u0438\u043A\u0438\u0445 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0438\u0445
        \u0434\u0432\u0435\u0440\u0435\u0439 \u0456 \u0441\u043F\u0440\u043E\u0431\u0443\u0439
        \u0432\u0456\u0434\u0447\u0438\u043D\u0438\u0442\u0438 \u0457\u0445\u2026
        \u0430\u043B\u0435, \u0437\u0432\u0456\u0441\u043D\u043E, \u0432\u043E\u043D\u0438
        \u0437\u043B\u0430\u043C\u0430\u043D\u0456 \u0439 \u043D\u0435 \u0445\u043E\u0447\u0443\u0442\u044C
        \u0441\u043B\u0443\u0445\u0430\u0442\u0438\u0441\u044F."
    - language: 28
      value: "Precisas de entrar no corredor de engenharia. Vai at\xE9 \xE0 grande
        porta met\xE1lica e tenta abri-la\u2026 mas claro, est\xE1 avariada e n\xE3o
        quer colaborar."
    - language: 34
      value: "Necesitas entrar en el corredor de ingenier\xEDa. Ve a la gran puerta
        met\xE1lica e intenta abrirla\u2026 pero, por supuesto, est\xE1 rota y no
        quiere obedecer."
  - key: Locate the energy hall
    translations:
    - language: 10
      value: Locate the energy hall
    - language: 38
      value: "\u0417\u043D\u0430\u0439\u0434\u0438 \u0435\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u043D\u0438\u0439
        \u0437\u0430\u043B"
    - language: 28
      value: Localiza a sala de energia
    - language: 34
      value: "Localiza la sala de energ\xEDa"
  - key: Explore the station and find the door that leads to the Energy distribution
      hall.
    translations:
    - language: 10
      value: Explore the station and find the door that leads to the Energy distribution
        hall.
    - language: 38
      value: "\u0414\u043E\u0441\u043B\u0456\u0434\u0438 \u0441\u0442\u0430\u043D\u0446\u0456\u044E
        \u0439 \u0437\u043D\u0430\u0439\u0434\u0438 \u0434\u0432\u0435\u0440\u0456,
        \u0449\u043E \u0432\u0435\u0434\u0443\u0442\u044C \u0434\u043E \u0437\u0430\u043B\u0443
        \u0440\u043E\u0437\u043F\u043E\u0434\u0456\u043B\u0443 \u0435\u043D\u0435\u0440\u0433\u0456\u0457."
    - language: 28
      value: "Explora a esta\xE7\xE3o e encontra a porta que leva \xE0 sala de distribui\xE7\xE3o
        de energia."
    - language: 34
      value: "Explora la estaci\xF3n y encuentra la puerta que conduce a la sala
        de distribuci\xF3n de energ\xEDa."
  - key: Boot the Buddy
    translations:
    - language: 10
      value: Boot the Buddy
    - language: 38
      value: "\u0423\u0432\u0456\u043C\u043A\u043D\u0438 \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u0430"
    - language: 28
      value: Liga o companheiro
    - language: 34
      value: "Inicia al compa\xF1ero"
  - key: Switch the robot back on and get yourself some company.
    translations:
    - language: 10
      value: Switch the robot back on and get yourself some company.
    - language: 38
      value: "\u0423\u0432\u0456\u043C\u043A\u043D\u0438 \u0440\u043E\u0431\u043E\u0442\u0430
        \u0437\u043D\u043E\u0432\u0443 \u0439 \u0441\u043A\u043B\u0430\u0434\u0438
        \u0441\u043E\u0431\u0456 \u043A\u043E\u043C\u043F\u0430\u043D\u0456\u044E."
    - language: 28
      value: "Volta a ligar o rob\xF4 e ganha alguma companhia."
    - language: 34
      value: "Vuelve a encender al robot y cons\xEDguete compa\xF1\xEDa."
  - key: Head to the Door
    translations:
    - language: 10
      value: Head to the Door
    - language: 38
      value: "\u0406\u0434\u0438 \u0434\u043E \u0434\u0432\u0435\u0440\u0435\u0439"
    - language: 28
      value: "Vai at\xE9 \xE0 porta"
    - language: 34
      value: Ve a la puerta
  - key: "You need to leave the cryo room. Go to the door on the right and see if
      you can open it\u2026 though it might not be that simple."
    translations:
    - language: 10
      value: "You need to leave the cryo room. Go to the door on the right and see
        if you can open it\u2026 though it might not be that simple."
    - language: 38
      value: "\u0422\u043E\u0431\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u0438 \u043A\u0440\u0456\u043E\u043A\u0430\u043C\u0435\u0440\u0443.
        \u041F\u0456\u0434\u0456\u0439\u0434\u0438 \u0434\u043E \u0434\u0432\u0435\u0440\u0435\u0439
        \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447 \u0456 \u043F\u043E\u0434\u0438\u0432\u0438\u0441\u044F,
        \u0447\u0438 \u0437\u043C\u043E\u0436\u0435\u0448 \u0457\u0445 \u0432\u0456\u0434\u0447\u0438\u043D\u0438\u0442\u0438\u2026
        \u0445\u043E\u0447\u0430 \u0446\u0435 \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438
        \u043D\u0435 \u0442\u0430\u043A \u043F\u0440\u043E\u0441\u0442\u043E."
    - language: 28
      value: "Precisas de sair da sala criog\xE9nica. Vai at\xE9 \xE0 porta \xE0
        direita e v\xEA se a consegues abrir\u2026 embora possa n\xE3o ser assim
        t\xE3o simples."
    - language: 34
      value: "Necesitas salir de la sala criog\xE9nica. Ve a la puerta de la derecha
        e intenta abrirla\u2026 aunque puede que no sea tan sencillo."
  - key: Root Buster
    translations:
    - language: 10
      value: Root Buster
    - language: 38
      value: "\u0420\u0443\u0439\u043D\u0456\u0432\u043D\u0438\u043A \u043A\u043E\u0440\u0456\u043D\u043D\u044F"
    - language: 28
      value: "Destruidor de ra\xEDzes"
    - language: 34
      value: "Destructor de ra\xEDces"
  - key: The axe from the fire locker is yours. Swing it at the thick roots tangled
      in the wall and carve a path through - nothing should stand in your way!
    translations:
    - language: 10
      value: The axe from the fire locker is yours. Swing it at the thick roots tangled
        in the wall and carve a path through - nothing should stand in your way!
    - language: 38
      value: "\u0421\u043E\u043A\u0438\u0440\u0430 \u0437 \u043F\u043E\u0436\u0435\u0436\u043D\u043E\u0457
        \u0448\u0430\u0444\u0438 \u0442\u0435\u043F\u0435\u0440 \u0442\u0432\u043E\u044F.
        \u0420\u043E\u0437\u043C\u0430\u0445\u043D\u0438\u0441\u044F \u043D\u0435\u044E
        \u043F\u043E \u0442\u043E\u0432\u0441\u0442\u043E\u043C\u0443 \u043A\u043E\u0440\u0456\u043D\u043D\u044E,
        \u0449\u043E \u0437\u0430\u043F\u043B\u0443\u0442\u0430\u043B\u043E\u0441\u044F
        \u0432 \u0441\u0442\u0456\u043D\u0456, \u0456 \u043F\u0440\u043E\u0440\u0443\u0431\u0430\u0439
        \u0448\u043B\u044F\u0445 \u2014 \u043D\u0456\u0449\u043E \u043D\u0435 \u0441\u0442\u0430\u043D\u0435
        \u043D\u0430 \u0437\u0430\u0432\u0430\u0434\u0456!"
    - language: 28
      value: "O machado do arm\xE1rio de inc\xEAndio \xE9 teu. Usa-o contra as ra\xEDzes
        grossas entranhadas na parede e abre caminho \u2014 nada te deve impedir!"
    - language: 34
      value: "El hacha del armario contra incendios es tuya. Golpea las gruesas ra\xEDces
        enredadas en la pared y \xE1brete paso: \xA1nada deber\xEDa detenerte!"
